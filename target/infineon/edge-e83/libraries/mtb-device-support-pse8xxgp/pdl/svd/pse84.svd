            </register>
            <register>
              <name>GCREGPANELCONFIG</name>
              <description>Panel Configuration Register.</description>
              <addressOffset>0xE8</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x0</resetValue>
              <resetMask>0x323</resetMask>
              <fields>
                <field>
                  <name>GCREGPANELCONFIG_DE</name>
                  <description>Data Enable enabled/disabled.</description>
                  <bitRange>[0:0]</bitRange>
                  <access>read-write</access>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>DISABLED</name>
                      <description>(none)</description>
                      <value>0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ENABLED</name>
                      <description>(none)</description>
                      <value>1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>GCREGPANELCONFIG_DE_POLARITY</name>
                  <description>Data Enable polarity.</description>
                  <bitRange>[1:1]</bitRange>
                  <access>read-write</access>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>POSITIVE</name>
                      <description>(none)</description>
                      <value>0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>NEGATIVE</name>
                      <description>(none)</description>
                      <value>1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>GCREGPANELCONFIG_DATA_POLARITY</name>
                  <description>Data polarity.</description>
                  <bitRange>[5:5]</bitRange>
                  <access>read-write</access>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>POSITIVE</name>
                      <description>(none)</description>
                      <value>0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>NEGATIVE</name>
                      <description>(none)</description>
                      <value>1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>GCREGPANELCONFIG_CLOCK</name>
                  <description>Clock enable/disable.</description>
                  <bitRange>[8:8]</bitRange>
                  <access>read-write</access>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>DISABLED</name>
                      <description>(none)</description>
                      <value>0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ENABLED</name>
                      <description>(none)</description>
                      <value>1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>GCREGPANELCONFIG_CLOCK_POLARITY</name>
                  <description>Clock polarity.</description>
                  <bitRange>[9:9]</bitRange>
                  <access>read-write</access>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>POSITIVE</name>
                      <description>(none)</description>
                      <value>0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>NEGATIVE</name>
                      <description>(none)</description>
                      <value>1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
              </fields>
            </register>
            <register>
              <name>GCREGPANELCONTROL</name>
              <description>Panel control Register.</description>
              <addressOffset>0xEC</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x0</resetValue>
              <resetMask>0x3</resetMask>
              <fields>
                <field>
                  <name>GCREGPANELCONTROL_VALID</name>
                  <description>The valid field defines whether we can copy a new set of registers at the next VBLANK or not.  This ensures a frame will always start with a valid working set if this register is programmed last, which reduces the need for SW to wait for the start of a VBLANK signal in order to ensure all states are loaded before the next VBLANK.</description>
                  <bitRange>[0:0]</bitRange>
                  <access>read-write</access>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>PENDING</name>
                      <description>(none)</description>
                      <value>0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>WORKING</name>
                      <description>(none)</description>
                      <value>1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>GCREGPANELCONTROL_BACK_PRESSURE_DISABLE</name>
                  <description>Interface of DPI</description>
                  <bitRange>[1:1]</bitRange>
                  <access>read-write</access>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>NO</name>
                      <description>(none)</description>
                      <value>0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>YES</name>
                      <description>(none)</description>
                      <value>1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
              </fields>
            </register>
            <register>
              <name>GCREGPANELFUNCTION</name>
              <description>Panel function Register. NOTE.. This register is double buffered.</description>
              <addressOffset>0xF0</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x0</resetValue>
              <resetMask>0x7</resetMask>
              <fields>
                <field>
                  <name>GCREGPANELFUNCTION_OUTPUT</name>
                  <description>When Output is enabled, pixels will be displayed.  When Output is disabled, all pixels will be black.  This allows a panel to have correct timing but without any pixels. NOTE: This field is double buffered.</description>
                  <bitRange>[0:0]</bitRange>
                  <access>read-write</access>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>DISABLED</name>
                      <description>(none)</description>
                      <value>0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ENABLED</name>
                      <description>(none)</description>
                      <value>1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>GCREGPANELFUNCTION_GAMMA</name>
                  <description>When Gamma is enabled, the R, G, and B channels will be routed through the Gamma LUT to perform gamma correction. NOTE: This field is double buffered.</description>
                  <bitRange>[1:1]</bitRange>
                  <access>read-write</access>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>DISABLED</name>
                      <description>(none)</description>
                      <value>0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ENABLED</name>
                      <description>(none)</description>
                      <value>1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>GCREGPANELFUNCTION_DITHER</name>
                  <description>Enabling dithering allows R8G8B8 modes to show better on  panels with less bits-per-pixel. NOTE: This field is double buffered.</description>
                  <bitRange>[2:2]</bitRange>
                  <access>read-write</access>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>DISABLED</name>
                      <description>(none)</description>
                      <value>0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ENABLED</name>
                      <description>(none)</description>
                      <value>1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
              </fields>
            </register>
            <register>
              <name>GCREGPANELWORKING</name>
              <description>Register to trigger Display Controller.</description>
              <addressOffset>0xF4</addressOffset>
              <size>32</size>
              <access>write-only</access>
              <resetValue>0x0</resetValue>
              <resetMask>0x1</resetMask>
              <fields>
                <field>
                  <name>GCREGPANELWORKING_WORKING</name>
                  <description>Writing a one in this register will force a reset of the display controller.  All registers will be copied to the working set and counters will be reset to the end of HSYNC and VSYNC.</description>
                  <bitRange>[0:0]</bitRange>
                  <access>write-only</access>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>WORKING</name>
                      <description>(none)</description>
                      <value>1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
              </fields>
            </register>
            <register>
              <name>GCREGPANELSTATE</name>
              <description>Register representing the Display Controller status. READ ONLY.</description>
              <addressOffset>0xF8</addressOffset>
              <size>32</size>
              <access>read-only</access>
              <resetValue>0x0</resetValue>
              <resetMask>0xE</resetMask>
              <fields>
                <field>
                  <name>GCREGPANELSTATE_VIDEO_UNDER_FLOW</name>
                  <description>When the display FIFO underflows, this bit gets set to one.  Reading this register will reset it back to zero.</description>
                  <bitRange>[1:1]</bitRange>
                  <access>read-only</access>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>NO</name>
                      <description>(none)</description>
                      <value>0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>YES</name>
                      <description>(none)</description>
                      <value>1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>GCREGPANELSTATE_OVERLAY_UNDER_FLOW</name>
                  <description>When the overlay FIFO underflows, this bit gets set to  one. Reading this register will reset it back to zero.</description>
                  <bitRange>[2:2]</bitRange>
                  <access>read-only</access>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>NO</name>
                      <description>(none)</description>
                      <value>0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>YES</name>
                      <description>(none)</description>
                      <value>1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>GCREGPANELSTATE_OVERLAY_UNDER_FLOW1</name>
                  <description>When the overlay FIFO underflows, this bit gets set to  one. Reading this register will reset it back to zero.</description>
                  <bitRange>[3:3]</bitRange>
                  <access>read-only</access>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>NO</name>
                      <description>(none)</description>
                      <value>0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>YES</name>
                      <description>(none)</description>
                      <value>1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
              </fields>
            </register>
            <register>
              <name>GCREGHDISPLAY</name>
              <description>Horizontal Display Total and Visible Pixel Count Register.  Horizontal Total and Display End counters.  NOTE.. This register is double buffered.</description>
              <addressOffset>0x100</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x0</resetValue>
