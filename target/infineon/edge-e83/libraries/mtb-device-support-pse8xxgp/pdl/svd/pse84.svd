        <cluster>
          <name>TRIM</name>
          <description>SAR Trim registers (only accessible if ACTRLR.STATUS.MODE=0)</description>
          <addressOffset>0x00000F00</addressOffset>
          <register>
            <name>BUF0_OFFSET_TRIM</name>
            <description>Buffer zero trim control</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0x3F</resetMask>
            <fields>
              <field>
                <name>BUF0_OFFSET_TRIM</name>
                <description>buffer 0 offset trim</description>
                <bitRange>[5:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>BUF0_SLOPE_OFFSET_TRIM</name>
            <description>Buffer zero trim control</description>
            <addressOffset>0x4</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0x3F</resetMask>
            <fields>
              <field>
                <name>BUF0_SLOPE_OFFSET_TRIM</name>
                <description>buffer 0 slope offset drift trim</description>
