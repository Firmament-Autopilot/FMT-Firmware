                  <enumeratedValue>
                    <name>ENDPT2</name>
                    <description>End point 2</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ENDPT3</name>
                    <description>End point 3</description>
                    <value>3</value>
