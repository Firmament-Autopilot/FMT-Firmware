                <bitRange>[31:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>HCDMAB8</name>
            <description>This register is present only in case of Scatter/Gather DMA. It is implemented in RAM instead of flop-based implementation. This register holds the current buffer address.</description>
            <addressOffset>0x61C</addressOffset>
            <size>32</size>
            <access>read-only</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>HCDMAB</name>
                <description>N/A</description>
                <bitRange>[31:0]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>HCCHAR9</name>
            <description>This register contains the characteristics of the Host Channel.</description>
            <addressOffset>0x620</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFEFFFF</resetMask>
            <fields>
              <field>
                <name>MPS</name>
                <description>Maximum Packet Size (MPS)

Indicates the maximum packet size of the associated endpoint.</description>
                <bitRange>[10:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>EPNUM</name>
                <description>Endpoint Number (EPNum)

Indicates the endpoint number on the device serving as the data source or sink.</description>
                <bitRange>[14:11]</bitRange>
                <access>read-write</access>
