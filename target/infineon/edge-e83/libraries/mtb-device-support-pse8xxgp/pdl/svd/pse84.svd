                <field>
                  <name>GCREGDBIWRCHAR1_DBI_WR_CS_ASSERT</name>
                  <description>Cycle number=Setting*(DbiAcTimeUnit+1).  0: When Type A Fixed E mode: Time to assert CSX.  1: When Type A Clock E mode: Not used.  2: When Type B mode: Time to assert CSX.</description>
                  <bitRange>[15:12]</bitRange>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>GCREGDBIWRCHAR2</name>
              <description>DBI Write AC Characteristics 2 Register.  DBI write AC characteristics definition register 2</description>
              <addressOffset>0x14C</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x0</resetValue>
              <resetMask>0xFFFF</resetMask>
              <fields>
                <field>
                  <name>GCREGDBIWRCHAR2_DBI_WR_EOR_WR_DE_ASRT</name>
                  <description>Cycle number=Setting*(DbiAcTimeUnit+1).  0: When Type A Fixed E mode: Not used.  1: When type A Clock E mode: Time to de-assert E.  2: When Type B mode: Time to de-assert WRX.</description>
                  <bitRange>[7:0]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>GCREGDBIWRCHAR2_DBI_WR_CS_DE_ASRT</name>
                  <description>Cycle number=Setting*(DbiAcTimeUnit+1).  0: When type A fixed E mode: Time to de-assert CSX.  1: When type A clock E mode: Not used.  2: When type B mode: Time to de-assert CSX.</description>
                  <bitRange>[15:8]</bitRange>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>GCREGDBICMD</name>
              <description>DBI Command Control Register.  DBI Command in/out port. Writes to this register will send  command/data to the DBI port. WRITE ONLY.</description>
              <addressOffset>0x150</addressOffset>
              <size>32</size>
              <access>write-only</access>
              <resetValue>0x0</resetValue>
              <resetMask>0xC000FFFF</resetMask>
              <fields>
                <field>
                  <name>GCREGDBICMD_DBI_COMMAND_WORD</name>
                  <description>The type of data contained in this word is specified using  DBI_COMMANDFLAG[bits 31:30].  For Type C Options 1 and 2:  DBI_COMMAND_WORD[8] is used to indicate the polarity of D/CX.  DBI_COMMAND_WORD[8] = 0 indicates DBI_COMMAND_WORD[7:0] is COMMAND WORD.  DBI_COMMAND_WORD[8] = 1 indicates DBI_COMMAND_WORD[7:0] is DATA WORD.</description>
                  <bitRange>[15:0]</bitRange>
                  <access>write-only</access>
                </field>
                <field>
                  <name>GCREGDBICMD_DBI_COMMANDFLAG</name>
                  <description>DBI command flag.</description>
                  <bitRange>[31:30]</bitRange>
                  <access>write-only</access>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>ADDRESS</name>
                      <description>//DBI_COMMAND_WORD will contain an address.</description>
                      <value>0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>WRITE_MEM_START</name>
                      <description>//Starts a write. Contents of DBI_COMMAND_WORD are ignored.</description>
                      <value>1</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>PARAMETER_OR_DATA</name>
                      <description>//DBI_COMMAND_WORD will contain a parameter or data.</description>
                      <value>2</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
              </fields>
            </register>
            <register>
              <name>GCREGDPICONFIG</name>
              <description>DPI Configuration Register.  The configuration register for DPI output.  NOTE.. This register is double buffered.</description>
              <addressOffset>0x154</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x5</resetValue>
              <resetMask>0x7</resetMask>
              <fields>
                <field>
                  <name>GCREGDPICONFIG_DPI_DATA_FORMAT</name>
                  <description>DPI interface data format. Refer to DPI specification section for Interface Color Coding' for detail. NOTE: This field is double buffered.</description>
                  <bitRange>[2:0]</bitRange>
                  <access>read-write</access>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>D16CFG1</name>
                      <description>(none)</description>
                      <value>0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>D16CFG2</name>
                      <description>(none)</description>
                      <value>1</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>D16CFG3</name>
                      <description>(none)</description>
                      <value>2</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>D18CFG1</name>
                      <description>(none)</description>
                      <value>3</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>D18CFG2</name>
                      <description>(none)</description>
                      <value>4</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>D24</name>
                      <description>(none)</description>
                      <value>5</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
              </fields>
            </register>
            <register>
              <name>GCREGDBITYPECCFG</name>
              <description>DBI Type C Timing Control Register.  DBI Type C write timing definition.</description>
              <addressOffset>0x158</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x0</resetValue>
              <resetMask>0xFFFFF</resetMask>
              <fields>
                <field>
                  <name>GCREGDBITYPECCFG_TAS</name>
                  <description>Divide counter for Tas (address setup time). Specifies how many sdaClk cycles in Tas phase.  DCX Tas means number of DBI_AC_TIME_UNIT of sdaClk to be ahead of scl.  Only works for DBI TYPE C Option3. Option1/2 will ignore this setting.  This field needs to be at least 1.</description>
                  <bitRange>[3:0]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>GCREGDBITYPECCFG_SCL_TWRL</name>
                  <description>Divide counter for Twrl (SCL L duration (write)). Specifies how many sdaClk cycles in Twrl phase.  SCL Twrl means number of DBI_AC_TIME_UNIT of sdaClk for scl staying low This field needs to be at least 1.</description>
                  <bitRange>[11:4]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>GCREGDBITYPECCFG_SCL_TWRH</name>
                  <description>Divide counter for Twrh (SCL H duration (write)). Specifies how many sdaClk cycles in Twrh phase.  SCL Twrh means number of DBI_AC_TIME_UNIT of sdaClk for scl staying high.  This field need to be at least 1.</description>
                  <bitRange>[19:12]</bitRange>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>GCREGDCSTATUS</name>
