          <register>
            <name>DIEPCTL2</name>
            <description>This register is used to control the characteristics of Endpoint 2.

Note: This register exists for an endpoint i if the OTG_EP_DIR_i parameter is 0 or 1 for that endpoint.</description>
            <addressOffset>0x940</addressOffset>
            <size>32</size>
            <access>read-write</access>
