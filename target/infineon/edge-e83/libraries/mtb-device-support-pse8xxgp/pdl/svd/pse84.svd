        <register>
          <name>FIFO_INTR_SET</name>
          <description>FIFO Interrupt set request register</description>
          <addressOffset>0x68</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>FIFO_OVERFLOW0_SET</name>
              <description>Write this field with '1' to set corresponding INTR field (a write of '0' has no effect).</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>FIFO_OVERFLOW1_SET</name>
              <description>Write this field with '1' to set corresponding INTR field (a write of '0' has no effect).</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>FIFO_OVERFLOW2_SET</name>
              <description>Write this field with '1' to set corresponding INTR field (a write of '0' has no effect).</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>FIFO_OVERFLOW3_SET</name>
              <description>Write this field with '1' to set corresponding INTR field (a write of '0' has no effect).</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
