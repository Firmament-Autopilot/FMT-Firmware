                  <name>DBI_CFG_RSVD_15_12</name>
                  <description>N/A</description>
                  <bitRange>[15:12]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>DBI_CFG_LUT_SIZE_CONF</name>
                  <description>This field configures the size used to transport the Write Lut commands as follows:</description>
                  <bitRange>[17:16]</bitRange>
                  <access>read-write</access>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>LUTSIZE0</name>
                      <description>(none)</description>
                      <value>0</value>
                    </enumeratedValue>
                    <enumeratedValue>
