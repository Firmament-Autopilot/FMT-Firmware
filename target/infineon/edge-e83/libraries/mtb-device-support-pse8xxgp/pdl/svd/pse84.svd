                <size>32</size>
                <access>read-write</access>
                <resetValue>0x0</resetValue>
                <resetMask>0xFFFFFFFF</resetMask>
                <fields>
                  <field>
                    <name>DRIVEMODE_EXT0</name>
                    <description>Sets the Drive mode for pin 0.
This fields are valid only if CFG.DRIVE_MODE0=0.
See the bit value definitions below for functions.</description>
                    <bitRange>[3:0]</bitRange>
                    <access>read-write</access>
                    <enumeratedValues>
                      <enumeratedValue>
                        <name>HIGHZ</name>
                        <description>Hi Z 
data_out_en=1: data_out=X-&gt; HIZ, data_out_en=0, data_out=X-&gt; HiZ</description>
                        <value>0</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>PUPD</name>
                        <description>Strong drive 0/1 when enabled - else pull_up and pull_down both enabled
data_out_en=1: data_out=1/0-&gt;Strong 1/0, data_out_en=0, data_out=X-&gt; Pull Up &amp; Pull Down</description>
                        <value>1</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>PULLUP</name>
                        <description>Strong drive 0/1 when enabled - else pull_up  enabled
data_out_en=1: data_out= 1/0-&gt;Strong 1/0, data_out_en=0, data_out=X-&gt; Pull Up</description>
                        <value>2</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>PULLDOWN</name>
                        <description>Strong drive 0/1 when enabled - else pull_down  enabled
data_out_en=1: data_out=1/0-&gt;Strong 1/0 , data_out_en=0, data_out=X-&gt; Pull Down</description>
                        <value>3</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>OE0_HIZHIZ_0</name>
                        <description>Strong drive 0/1 when enabled - else HIZ
data_out_en=1: data_out=1/0-&gt; Strong 1/0, data_out_en=0, data_out=X-&gt; HiZ</description>
                        <value>4</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>OE0_HIZHIZ_1</name>
                        <description>Strong drive 0/1 when enabled - else HIZ
data_out_en=1: data_out=1/0-&gt; Strong 1/0, data_out_en=0, data_out=X-&gt; HiZ</description>
                        <value>5</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>OE0_HIZHIZ_2</name>
                        <description>Strong drive 0/1 when enabled - else HIZ
data_out_en=1: data_out=1/0-&gt; Strong 1/0, data_out_en=0, data_out=X-&gt; HiZ</description>
                        <value>6</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>OE0_PUPD</name>
                        <description>Strong drive 0/1 when enabled else data_out driven by pull_up or pull _down following data_out
data_out_en=1: data_out=1/0-&gt; Strong 1/0, data_out_en=0, data_out=0-&gt; pull_down, data_out_en=0,data_out=1-&gt;pull_up</description>
                        <value>7</value>
                      </enumeratedValue>
                      <enumeratedValue>
                        <name>OE0_PUHIZ</name>
                        <description>Strong drive 0/1 when enabled else data_out driven by pull_up or HiZ following data_out
data_out_en=1: data_out=1/0-&gt; Strong 1/0, data_out_en=0, data_out=0-&gt; pull_down, data_out_en=0,data_out=1-&gt;pull_up</description>
                        <value>8</value>
