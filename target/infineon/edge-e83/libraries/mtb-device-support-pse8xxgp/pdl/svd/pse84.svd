                    <name>TXFIFO1</name>
                    <description>Tx FIFO 1</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>TXFIFO10</name>
                    <description>Tx FIFO 10</description>
                    <value>10</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>TXFIFO11</name>
                    <description>Tx FIFO 11</description>
                    <value>11</value>
                  </enumeratedValue>
                  <enumeratedValue>
