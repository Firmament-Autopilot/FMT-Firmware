                    <name>ENDPT10</name>
                    <description>End point 10</description>
                    <value>10</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ENDPT11</name>
                    <description>End point 11</description>
                    <value>11</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ENDPT12</name>
                    <description>End point 12</description>
