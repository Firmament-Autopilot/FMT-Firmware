    </peripheral>
    <peripheral>
      <name>INFRA</name>
      <description>LPPASS infrastructure</description>
      <baseAddress>0x42EE0000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>65536</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>CLOCK_PTC_LP_DIV</name>
          <description>Low Power Clock divider for PTC (only accessible if ACTRLR.STATUS.MODE=0)</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0x3FF</resetMask>
          <fields>
            <field>
              <name>DIV_VAL</name>
              <description>Actual divide value is DIV_VAL+1. The root clock for this divider is the LPPASS LPOSC (4.096MHz nominal).  This field is only used if the PTC is enabled (AC.PTC_CMP0(1)_EN=1) and the Autonomous Controller is configured for LP mode (ACTRLR.STATUS.MODE=LP).</description>
              <bitRange>[9:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <dim>2</dim>
          <dimIncrement>4</dimIncrement>
          <name>CLOCK_DAC_LP_DIV[%s]</name>
          <description>Low Power Clock divider for DAC (only accessible if ACTRLR.STATUS.MODE=0)</description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x3</resetValue>
          <resetMask>0x3FF</resetMask>
          <fields>
            <field>
              <name>DIV_VAL</name>
              <description>Actual divide value is DIV_VAL+1.  The root clock for this divider is the LPPASS LPOSC (4.096MHz nominal). This field is only used if the DAC is enabled (AC.DAC0(1)_EN=1) and the Autonomous Controller is configured for LP mode (ACTRLR.STATUS.MODE=LP).</description>
              <bitRange>[9:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CLOCK_PRIO_HS_DIV</name>
          <description>Clock enable for IP priority enabler (only accessible if ACTRLR.STATUS.MODE=0)</description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x13</resetValue>
          <resetMask>0x3FF</resetMask>
          <fields>
            <field>
              <name>DIV_VAL</name>
              <description>Actual divide value is DIV_VAL+1.  The DIV value must be set to ensure that the corresponding clock rate is set to 4MHz.  (The high speed system clock frequency is expected to be set to 80MHz, therby a defult DIV_VAL of 19 yields a 4MHz PRIO_HS clock).</description>
              <bitRange>[9:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <dim>4</dim>
          <dimIncrement>4</dimIncrement>
          <name>PRIO_CFG[%s]</name>
          <description>Sub IP Block IP priority enabler configuration (only accessible if ACTRLR.STATUS.MODE=0)</description>
          <addressOffset>0x20</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0x1FF3F</resetMask>
          <fields>
            <field>
              <name>COUNT_VAL</name>
              <description>Actual count value is COUNT_VAL+1.  This field determines the time delay between the Autonomous Controller (AC) setting the particular block enable bit and the corresponding assertion of the ready status bit.  The delay time is based on a 4MHz clock (the corresponding delay time is 250ns*COUNT_VAL+1 (Delay time ranges from 250ns to 16us)).  If delay times greater than 16us are required, then multiple PRIO_CFG states must be programmed to generate a cascade of delays (4 PRIO_CFG state*16us=64us maximum possible delay).</description>
              <bitRange>[5:0]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>SAR_READY</name>
              <description>SAR ready</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>DAC0_READY</name>
              <description>DAC0 ready</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>DAC1_READY</name>
              <description>DAC1 ready</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PTC_CMP0_READY</name>
              <description>PTC comparator 0 ready</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PTC_CMP1_READY</name>
              <description>PTC comparator 1 ready</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CTBL0_OA0_READY</name>
              <description>CTBL0 opamp0 ready</description>
              <bitRange>[13:13]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CTBL0_OA1_READY</name>
              <description>CTBL0 opamp1 ready</description>
              <bitRange>[14:14]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CTBL1_OA0_READY</name>
              <description>CTBL1 opamp0 ready</description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CTBL1_OA1_READY</name>
              <description>CTBL1 opamp1 ready</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <cluster>
          <name>LPOSC</name>
          <description>LPOSC configuration (only accessible if ACTRLR.STATUS.MODE=0)</description>
          <addressOffset>0x00000100</addressOffset>
          <register>
            <name>CFG</name>
            <description>Low Power Oscillator configuration register</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x80000000</resetValue>
            <resetMask>0xC0000000</resetMask>
            <fields>
              <field>
                <name>MODE</name>
                <description>LPOSC functionality</description>
                <bitRange>[30:30]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>ALWAYS_ON</name>
                    <description>LPOSC always ON</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>DUTY_CYCLED</name>
                    <description>LPOSC duty cycled based on AC Wakeup Signal</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>ENABLE</name>
                <description>Master enable for LPOSC oscillator.  This bit must be high at all times for all functions to work properly.  Hardware will automatically disable the LPOSC during HIBERNATE and XRES.</description>
                <bitRange>[31:31]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>TRIM</name>
            <description>LPOSC Trim Register</description>
            <addressOffset>0xF0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x10012B</resetValue>
            <resetMask>0xFF1F01FF</resetMask>
            <fields>
              <field>
                <name>LPOSC_CTRL_FTRIM</name>
                <description>LPOSC frequency trim</description>
                <bitRange>[8:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>LPOSC_CTRL_TCTRIM</name>
                <description>LPOSC temperature compensation trim</description>
                <bitRange>[20:16]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>LPOSC_CTRL_REFTRIM</name>
                <description>LPOSC reference trims</description>
                <bitRange>[31:24]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
        </cluster>
        <cluster>
          <name>AREF</name>
          <description>AREF configuration (only accessible if ACTRLR.STATUS.MODE=0)</description>
          <addressOffset>0x00000200</addressOffset>
          <register>
            <name>CTRL</name>
            <description>AREF control</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0x100</resetMask>
            <fields>
              <field>
                <name>VREF_SEL</name>
                <description>bandgap voltage select control</description>
                <bitRange>[8:8]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>LOCAL</name>
                    <description>Use locally generated Vref</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>EXTERNAL</name>
                    <description>Use externally supplied Vref (aref_ext_vref)</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>VREF_TRIM0</name>
            <description>VREF Trim bits</description>
            <addressOffset>0xD0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0x1F</resetMask>
            <fields>
              <field>
                <name>VREF_ABS_TRIM</name>
                <description>bandgap absolute voltage output trim (in signed magnitude format)
MSB is not in use, selection from 0x00 - 0x0F
0x00 : No Voltage Trim Adjustment
0x0F : Maximum Positive Trim Adjustment (+20mV)</description>
                <bitRange>[4:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>VREF_TRIM1</name>
            <description>VREF Trim bits</description>
            <addressOffset>0xD4</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0x3F</resetMask>
            <fields>
              <field>
                <name>VREF_TEMPCO_TRIM</name>
                <description>bandgap voltage temperature correction trim
0x00 : Minimum temperature correction (smallest PTAT voltage)
0x3F : Maximum temperature correction (largest PTAT voltage)</description>
                <bitRange>[5:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>VREF_TRIM2</name>
            <description>VREF Trim bits</description>
            <addressOffset>0xD8</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xF</resetMask>
            <fields>
              <field>
                <name>VREF_IPTAT2_ICTAT_TRIM</name>
                <description>N/A</description>
                <bitRange>[3:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>VREF_TRIM3</name>
            <description>VREF Trim bits</description>
            <addressOffset>0xDC</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0x1F</resetMask>
            <fields>
              <field>
                <name>VREF_IPTAT2_DAC_TRIM</name>
                <description>N/A</description>
                <bitRange>[4:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>IZTAT_TRIM0</name>
            <description>IZTAT Trim bits</description>
            <addressOffset>0xE0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFF</resetMask>
            <fields>
              <field>
                <name>IZTAT_COARSE_TRIM</name>
                <description>N/A</description>
                <bitRange>[3:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>IZTAT_FINE_TRIM</name>
                <description>IZTAT temperature correction trim (RMB)
0x00 : No IZTAT temperature correction
0xFF : Maximum IZTAT temperature correction

As this is a Risk Mitigation Register, it should be loaded with 0x08.</description>
                <bitRange>[7:4]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>IPTAT_TRIM0</name>
            <description>IPTAT Trim bits</description>
            <addressOffset>0xE4</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFF</resetMask>
            <fields>
              <field>
                <name>IPTAT_COARSE_TRIM</name>
                <description>IPTAT coarse trim
0x0 : Minimum IPTAT current (~150nA at room)
0xF : Maximum IPTAT current (~350nA at room)</description>
                <bitRange>[3:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>IPTAT_FINE_TRIM</name>
                <description>IPTAT fine trim
0x0 : Minimum CTMB IPTAT Current (~875nA)
0xF : Maximum CTMB IPTAT Current (~1.1uA)</description>
                <bitRange>[7:4]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>IPTAT_TRIM1</name>
            <description>IPTAT Trim bits</description>
            <addressOffset>0xE8</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0x1F</resetMask>
            <fields>
              <field>
                <name>IPTAT_DAC_TRIM</name>
                <description>IPTAT DAC trim
0x0 : Minimum IPTAT current (~150nA at room)
0xF : Maximum IPTAT current (~350nA at room)</description>
                <bitRange>[4:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>ICTAT_TRIM0</name>
            <description>ICTAT Trim bits</description>
            <addressOffset>0xEC</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xF</resetMask>
            <fields>
              <field>
                <name>RSVD</name>
                <description>N/A</description>
                <bitRange>[3:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>ICTAT_TRIM1</name>
            <description>ICTAT Trim bits</description>
            <addressOffset>0xF0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0x1F</resetMask>
            <fields>
              <field>
                <name>ICTAT_COARSE_TRIM</name>
                <description>ICTAT coarse trim
0x0 : Minimum IPTAT current (~150nA at room)
0xF : Maximum IPTAT current (~350nA at room)</description>
                <bitRange>[4:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>ICTAT_TRIM2</name>
            <description>ICTAT Trim bits</description>
            <addressOffset>0xF4</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0x7</resetMask>
            <fields>
              <field>
                <name>ICTAT_FINE_TRIM</name>
                <description>ICTAT fine trim
0x0 : Minimum CTMB IPTAT Current (~875nA)
0xF : Maximum CTMB IPTAT Current (~1.1uA)</description>
                <bitRange>[2:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
        </cluster>
        <cluster>
          <name>PRB</name>
          <description>PRB configuration (only accessible if ACTRLR.STATUS.MODE=0)</description>
          <addressOffset>0x00000300</addressOffset>
          <register>
            <dim>2</dim>
            <dimIncrement>4</dimIncrement>
            <name>VREF_CTRL[%s]</name>
            <description>PRB VREF Control</description>
            <addressOffset>0x0</addressOffset>
