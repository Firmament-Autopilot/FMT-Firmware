              <fields>
                <field>
                  <name>DBI_CFG_IN_DBI_CONF</name>
                  <description>This field configures the DBI input pixel data as follows:</description>
                  <bitRange>[3:0]</bitRange>
                  <access>read-write</access>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>PIXELDATA0</name>
                      <description>(none)</description>
                      <value>0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>PIXELDATA1</name>
                      <description>(none)</description>
                      <value>1</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>PIXELDATA10</name>
                      <description>(none)</description>
                      <value>10</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>PIXELDATA11</name>
                      <description>(none)</description>
                      <value>11</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>PIXELDATA12</name>
                      <description>(none)</description>
                      <value>12</value>
