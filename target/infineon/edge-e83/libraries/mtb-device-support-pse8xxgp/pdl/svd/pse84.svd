              <addressOffset>0x15C</addressOffset>
              <size>32</size>
              <access>read-only</access>
              <resetValue>0x0</resetValue>
              <resetMask>0xFFFFFFFF</resetMask>
              <fields>
                <field>
                  <name>VID_VFP_LINES_ACT_VFP_LINES</name>
                  <description>This field specifies the Vertical Front Porch period measured in number of horizontal lines.</description>
                  <bitRange>[9:0]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>VID_VFP_LINES_ACT_RSVD_31_10</name>
