                    <enumeratedValue>
                      <name>MODE0</name>
                      <description>(none)</description>
                      <value>0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>MODE1</name>
                      <description>(none)</description>
                      <value>1</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>MODE2</name>
                      <description>(none)</description>
                      <value>2</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>MODE3</name>
                      <description>(none)</description>
                      <value>3</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>SDF_3D_FORMAT_3D</name>
                  <description>This field defines 3D Image Format:</description>
                  <bitRange>[3:2]</bitRange>
                  <access>read-write</access>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>FRAME</name>
                      <description>(none)</description>
                      <value>1</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>LINE</name>
                      <description>(none)</description>
                      <value>0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>PIXEL</name>
                      <description>(none)</description>
                      <value>2</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>RSVD</name>
