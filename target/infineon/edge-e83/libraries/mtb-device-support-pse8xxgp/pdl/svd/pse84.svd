                  </enumeratedValue>
                  <enumeratedValue>
                    <name>AVG_32</name>
                    <description>use 32 averaging repititions per calibration value</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>AVG_64</name>
                    <description>use 64 averaging repititions per calibration value</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>AVG_2</name>
                    <description>use 2 averaging repititions per calibration value</description>
                    <value>3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>STC</name>
                <description>Calibration sample time control</description>
                <bitRange>[11:10]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>STC_512</name>
