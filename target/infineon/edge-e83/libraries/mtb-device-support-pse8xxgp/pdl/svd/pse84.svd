                    <bitRange>[8:8]</bitRange>
                    <access>read-only</access>
                  </field>
                </fields>
              </register>
              <register>
                <name>INTR_SET</name>
                <description>Port interrupt set register</description>
                <addressOffset>0x20</addressOffset>
