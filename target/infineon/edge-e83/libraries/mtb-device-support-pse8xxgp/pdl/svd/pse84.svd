          <resetValue>0x0</resetValue>
          <resetMask>0xFFFF</resetMask>
          <fields>
            <field>
              <name>PPU_HWSTAT_ON</name>
              <description>Each bit represents the PPU 'ON' Status of connected PPU.
1: PPU is ON</description>
              <bitRange>[15:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>PDCM_PD_PRESENT</name>
