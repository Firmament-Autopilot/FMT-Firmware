                    <description>Tx FIFO 12</description>
                    <value>12</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>TXFIFO13</name>
                    <description>Tx FIFO 13</description>
                    <value>13</value>
                  </enumeratedValue>
