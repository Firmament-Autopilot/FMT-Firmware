            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>RESISTOR_CFG0</name>
                <description>Sets resistor value in IO cell for pin 1.  - 50K pullup is NOT controlled by these bits. Used in conjuntion with CFG_OUT3[N]=OE0_PUHIZ (8).</description>
                <bitRange>[3:0]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>I3C_PU_DISABLE</name>
                    <description>Disable additional Pull-ups</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>I3C_PU_570</name>
                    <description>Pull-up 570 ohms</description>
                    <value>7</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>I3C_PU_940</name>
                    <description>Pull-up 940 Ohms</description>
                    <value>6</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>I3C_PU_980</name>
