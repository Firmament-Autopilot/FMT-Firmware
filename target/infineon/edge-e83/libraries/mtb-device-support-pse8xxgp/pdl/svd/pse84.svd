              <fields>
                <field>
                  <name>VID_HLINE_TIME_ACT_VID_HLINE_TIME</name>
                  <description>This field specifies the size of the total line time (HSA+HBP+HACT+HFP) counted in lane byte clock cycles.</description>
                  <bitRange>[14:0]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>VID_HLINE_TIME_ACT_RSVD_31_15</name>
                  <description>N/A</description>
                  <bitRange>[31:15]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>VID_VSA_LINES_ACT</name>
