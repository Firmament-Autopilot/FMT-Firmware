                    <description>N/A</description>
                    <value>30</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RESEREVED_7</name>
                    <description>N/A</description>
                    <value>31</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
        </cluster>
        <cluster>
          <dim>2</dim>
          <dimIncrement>16</dimIncrement>
          <name>PP[%s]</name>
          <description>PTC Post Process (only accessible if ACTRLR.STATUS.MODE=0)</description>
          <addressOffset>0x00000700</addressOffset>
          <register>
            <name>CFG</name>
            <description>Post Processing configuration</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xF0F</resetMask>
            <fields>
              <field>
                <name>INPUT_TYPE</name>
                <description>Input data type (selected by PTC_STA_CFG.PP_CFG0(1).INPUT_SEL. )</description>
                <bitRange>[1:0]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>LEVEL</name>
                    <description>level sensitive</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>EDGE_RISING</name>
                    <description>rising edge sensitive</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>EDGE_FALLING</name>
                    <description>falling edge sensitive</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>EDGE_BOTH</name>
                    <description>both rising and falling edge sensitive</description>
                    <value>3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>MODE</name>
                <description>Post Processor Counter Mode</description>
                <bitRange>[3:2]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DIRECT</name>
                    <description>Direct mode: in this mode, the counter is configured to count the number of INPUT_TYPES.  The condition is evaluated (based on the THRESHOLD register) every rising edge of the post precessor clock.  If the condition is met, the counter is reset.</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>FRAME</name>
                    <description>Frame mode: in this mode, the counter is configured to count the number of INPUT_TYPES that occur during a given frame.  The frame rate is determined by FRAME.PERIOD.  At the end of the frame, the condition is evaluated (based on the THRESHOLD register) and the counter is reset to begin the next frame.</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>WINDOW</name>
                    <description>Window mode: in this mode, the counter is configured to count the number of INPUT_TYPES that occur inside a given window.  The window size is set by WINDOW.SIZE.  After filling the window, the condition is evaluted (based on the THRESHOLD register) every rising edge of the post processor clock.  The counter is not reset in this mode.</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RSVD</name>
                    <description>N/A</description>
                    <value>3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>LUT</name>
                <description>LUT function

A and B corresponds to the individual post processor range outputs (i.e. for PTC_PP_STRUCT0_CFG.LUT, A is the Post Processor 0 range comparison, and B is the Post Processor 1 range comparison.  For PTC_PP_STRUCT1_CFG.LUT, A is the Post Processor 1 range comparison, and B is the Post Processor 0 range comparison)</description>
                <bitRange>[11:8]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>A</name>
                    <description>N/A</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>A_BAR_AND_B</name>
                    <description>N/A</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B</name>
                    <description>N/A</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>A_AND_B</name>
                    <description>N/A</description>
                    <value>3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>A_AND_B_BAR</name>
                    <description>N/A</description>
                    <value>4</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>A_XOR_B</name>
                    <description>N/A</description>
                    <value>5</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>A_OR_B</name>
                    <description>N/A</description>
                    <value>6</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>A_NOR_B</name>
                    <description>N/A</description>
                    <value>7</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>A_XNOR_B</name>
                    <description>N/A</description>
                    <value>8</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>B_BAR</name>
                    <description>N/A</description>
                    <value>9</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>A_OR_B_BAR</name>
                    <description>N/A</description>
                    <value>10</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>A_BAR</name>
                    <description>N/A</description>
                    <value>11</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>A_BAR_OR_B</name>
                    <description>N/A</description>
                    <value>12</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>A_NAND_B</name>
                    <description>N/A</description>
                    <value>13</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RSVD0</name>
                    <description>N/A</description>
                    <value>14</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RSVD1</name>
                    <description>N/A</description>
                    <value>15</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>FRAME</name>
            <description>Post Processing frame</description>
            <addressOffset>0x4</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFF</resetMask>
            <fields>
              <field>
                <name>PERIOD</name>
                <description>Period Value.  This field is only applicable if CFG.MODE=FRAM.  The frame rate is PERIOD+1 PTC Clock cycles.</description>
                <bitRange>[11:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>THRESHOLD</name>
            <description>Post Processing threshold</description>
            <addressOffset>0x8</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0x3FFF0FFF</resetMask>
            <fields>
              <field>
                <name>LOW</name>
                <description>Low threshold</description>
                <bitRange>[11:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>HIGH</name>
                <description>High threshold</description>
                <bitRange>[27:16]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>COND</name>
                <description>Range condition select.</description>
                <bitRange>[29:28]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>BELOW</name>
                    <description>counter output &lt; LOW</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>INSIDE</name>
                    <description>LOW &lt;= counter output &lt; HIGH</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ABOVE</name>
                    <description>counter output &gt; HIGH</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>OUTSIDE</name>
                    <description>counter output &lt; LOW || counter output &gt;= HIGH</description>
                    <value>3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>WINDOW</name>
            <description>Post Processing window</description>
            <addressOffset>0xC</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x4</resetValue>
            <resetMask>0x7</resetMask>
            <fields>
              <field>
                <name>SIZE</name>
                <description>Window size.  This field is only applicable if CFG.MODE=WINDOW</description>
                <bitRange>[2:0]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>WINDOW_TWO</name>
                    <description>Window size of 2</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>WINDOW_FOUR</name>
                    <description>Window size of 4</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>WINDOW_EIGHT</name>
                    <description>Window size of 8</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>WINDOW_SIXTEEN</name>
                    <description>Window size of 16</description>
                    <value>3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>WINDOW_THIRTY_TWO</name>
                    <description>Window size of 32</description>
                    <value>4</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>WINDOW_SIXTY_FOUR</name>
                    <description>Window size of 64</description>
                    <value>5</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>WINDOW_ONE_TWENTY_EIGHT</name>
                    <description>Window size of 128</description>
                    <value>6</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RSVD</name>
                    <description>N/A</description>
                    <value>7</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
        </cluster>
        <cluster>
          <name>TRIM</name>
          <description>PTC Trim registers (only accessible if ACTRLR.STATUS.MODE=0)</description>
          <addressOffset>0x00000F00</addressOffset>
          <register>
            <name>CMP0_OFFSET_TRIM</name>
            <description>Comparator 0 offset trim register</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0x3F</resetMask>
            <fields>
              <field>
                <name>CMP0_MAGNITUDE</name>
                <description>magnitude of CMP0 offset trim. 1mV offset shift per bit.</description>
                <bitRange>[3:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>CMP0_POLARITY</name>
                <description>polarity of CMP0 offset trim. 
0 = negative
1 = positive</description>
                <bitRange>[4:4]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>CMP0_EN</name>
                <description>enables CMP0 offset trim 
0 = disabled
1 = enabled</description>
                <bitRange>[5:5]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>CMP1_OFFSET_TRIM</name>
            <description>Comparator 1 offset trim register</description>
            <addressOffset>0x4</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0x3F</resetMask>
            <fields>
              <field>
                <name>CMP1_MAGNITUDE</name>
                <description>magnitude of CMP1 offset trim. 1mV offset shift per bit.</description>
                <bitRange>[3:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>CMP1_POLARITY</name>
                <description>polarity of CMP1 offset trim. 
0 = negative
1 = positive</description>
                <bitRange>[4:4]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>CMP1_EN</name>
                <description>enables CMP1 offset trim 
0 = disabled
1 = enabled</description>
                <bitRange>[5:5]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
        </cluster>
      </registers>
    </peripheral>
    <peripheral>
      <name>DAC0</name>
      <description>DAC</description>
      <headerStructName>DAC</headerStructName>
      <baseAddress>0x42E60000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>65536</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <dim>512</dim>
          <dimIncrement>4</dimIncrement>
          <name>SRAM[%s]</name>
          <description>SRAM Waveform Table  (only accessible if ACTRLR.STATUS.MODE=0)</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0x0</resetMask>
          <fields>
            <field>
              <name>WAVEFORM</name>
              <description>DAC waveform</description>
              <bitRange>[11:0]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RSVD</name>
              <description>N/A</description>
              <bitRange>[13:12]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>OUT_DM</name>
              <description>DAC Output Drive Mode</description>
              <bitRange>[15:14]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>OUT_EN</name>
                  <description>DAC output enabled (outputs WAVEFORM)</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OUT_HIZ</name>
                  <description>DAC output disabled (output is Tri-state)</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OUT_REF</name>
                  <description>DAC output disabled (output Vssa or Vref when disabled (see CTRL.BOT_SEL))</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RSVD</name>
                  <description>N/A</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <cluster>
          <name>STA</name>
          <description>DAC static configuration registers</description>
          <addressOffset>0x00000800</addressOffset>
          <register>
            <name>CTRL</name>
            <description>DAC control register  (only accessible if ACTRLR.STATUS.MODE=0)</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0x7001FF7F</resetMask>
            <fields>
              <field>
                <name>TOPO</name>
                <description>DAC Topology</description>
                <bitRange>[2:0]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DIRECT</name>
                    <description>DAC drives output directly</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>DIRECT_WITH_TRACK_CAP</name>
                    <description>DAC drives output directly with Track Cap on output</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>DIRECT_WITH_TRACK_HOLD_CAP</name>
                    <description>DAC drives output directly with Track and Hold Cap on output</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>BUFFERED_INTERNAL</name>
                    <description>DAC output is buffered (internal connections only)</description>
                    <value>3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>BUFFERED_EXTERNAL</name>
                    <description>DAC output is buffered for internal or external connections</description>
                    <value>4</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RSVD_0</name>
                    <description>N/A</description>
                    <value>5</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RSVD_1</name>
                    <description>N/A</description>
                    <value>6</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RSVD_2</name>
                    <description>N/A</description>
                    <value>7</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>VREF_SEL</name>
                <description>DAC reference select</description>
                <bitRange>[3:3]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>VREF_MUX_OUT</name>
                    <description>DAC reference is driven by the reference mux (see REF_MUX_SEL).  This selection requires that REFBUF_PWR_MODE be set to a value other than OFF.</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>VDDA</name>
                    <description>DAC reference is driven directly from VDDA.  Since this path does not use the DAC reference buffer, REFBUF_PWR_MODE should be set to OFF.</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>DEGLITCH_EN</name>
                <description>Deglitch enable

This field is used to prevent glitches after the DAC output changes by opening the output switch for (open time set by DEGLITCH_TIME).  If TOPO is set to 0-2, CHO switch is opened during deglitch time, if TOPO is set to 3,4, COS switch is opened during deglitch time.</description>
                <bitRange>[4:4]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DISABLED</name>
                    <description>N/A</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ENABLED</name>
                    <description>N/A</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>BOT_SEL</name>
                <description>Bottom connection select to R2R network.

0: Connect to VSSA:
              DAC enabled: when DM_OUT=OUT_EN, the DAC range is [0, 4095] * Vref / 4096, 
                                   when DM_OUT=OUT_REF,  the DAC outputs VSSA.
              DAC disabled and DISABLED_MODE=1, the DAC outputs VSSA.
1: Connect to VREF:
              DAC enabled: when DM_OUT=OUT_EN, the DAC range is [1, 4096] * Vref / 4096, 
                                   when DM_OUT=OUT_REF,  the DAC outputs VREF.
              DAC disabled and DISABLED_MODE=1, the DAC outputs VREF.</description>
                <bitRange>[5:5]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>DISABLED_MODE</name>
                <description>Select the output value when the output is disabled
0: Tri-state CTDAC output when disabled
1: output Vssa or Vref when disabled (see BOT_SEL description)</description>
                <bitRange>[6:6]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>REFBUF_PWR_MODE</name>
                <description>Reference buffer power level</description>
                <bitRange>[11:8]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>OFF</name>
                    <description>Off</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ULTRA_LOW</name>
                    <description>reference buffer quiscent current of 15uA, input common mode of 0.2V to VDDA-1V, gain bandwidth of 30kHz.</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ULTRA_LOW_RAIL</name>
                    <description>reference buffer quiscent current of 35uA, input common mode of 0.2V to VDDA-0.2V, gain bandwidth of 30kHz.</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LOW</name>
                    <description>Do Not Use</description>
                    <value>3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LOW_RAIL</name>
                    <description>reference buffer quiscent current of 150uA, input common mode of 0.2V to VDDA-0.2V, gain bandwidth of 350kHz.</description>
                    <value>4</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>MEDIUM</name>
                    <description>Do Not Use</description>
                    <value>5</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>MEDIUM_RAIL</name>
                    <description>reference buffer quiscent current of 200uA, input common mode of 0.2V to VDDA-0.2V, gain bandwidth of 700kHz.</description>
                    <value>6</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HIGH</name>
                    <description>Do Not Use</description>
                    <value>7</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HIGH_RAIL</name>
                    <description>reference buffer quiscent current of 600uA, input common mode of 0.2V to VDDA-0.2V, gain bandwidth of 1.75MHz.</description>
                    <value>8</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ULTRA_HIGH</name>
                    <description>Do Not Use</description>
                    <value>9</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ULTRA_HIGH_RAIL</name>
                    <description>reference buffer quiscent current of 800uA, input common mode of 0.2V to VDDA-0.2V, gain bandwidth of 2.8MHz.</description>
                    <value>10</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RSVD_0</name>
                    <description>N/A</description>
                    <value>11</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RSVD_1</name>
                    <description>N/A</description>
                    <value>12</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RSVD_2</name>
                    <description>N/A</description>
                    <value>13</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RSVD_3</name>
                    <description>N/A</description>
                    <value>14</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RSVD_4</name>
                    <description>N/A</description>
                    <value>15</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>OUTBUF_PWR_MODE</name>
                <description>Output buffer power level</description>
                <bitRange>[15:12]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>OFF</name>
                    <description>Off</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ULTRA_LOW</name>
                    <description>If TOPO=BUFFERED_INTERNAL: quiscent current of 15uA, input common mode of 0.2V to VDDA-1V, gain bandwidth of 30kHz.

If TOPO=BUFFERED_EXTERNAL: quiscent current of 15uA, input common mode of 0.2V to VDDA-1V, gain bandwidth of 100kHz, 10uA output drive capability.</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ULTRA_LOW_RAIL</name>
                    <description>If TOPO=BUFFERED_INTERNAL: quiscent current of 35uA, input common mode of 0.2V to VDDA-0.2V, gain bandwidth of 30kHz.

If TOPO=BUFFERED_EXTERNAL: quiscent current of 35uA, input common mode of 0.2V to VDDA-0.2V, gain bandwidth of 100kHz, 10uA output drive capability.</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LOW</name>
                    <description>Do Not Use</description>
                    <value>3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LOW_RAIL</name>
                    <description>If TOPO=BUFFERED_INTERNAL: quiscent current of 150uA, input common mode of 0.2V to VDDA-0.2V, gain bandwidth of 350kHz.

If TOPO=BUFFERED_EXTERNAL: quiscent current of 150uA, input common mode of 0.2V to VDDA-0.2V, gain bandwidth of 1.2MHz, 100uA output drive capability.</description>
                    <value>4</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>MEDIUM</name>
                    <description>Do Not Use</description>
                    <value>5</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>MEDIUM_RAIL</name>
                    <description>If TOPO=BUFFERED_INTERNAL: quiscent current of 200uA, input common mode of 0.2V to VDDA-0.2V, gain bandwidth of 700kHz.

If TOPO=BUFFERED_EXTERNAL: quiscent current of 200uA, input common mode of 0.2V to VDDA-0.2V, gain bandwidth of 2.4MHz, 1mA output drive capability.</description>
                    <value>6</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HIGH</name>
                    <description>Do Not Use</description>
                    <value>7</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HIGH_RAIL</name>
                    <description>If TOPO=BUFFERED_INTERNAL: quiscent current of 600uA, input common mode of 0.2V to VDDA-0.2V, gain bandwidth of 1.75MHz.

If TOPO=BUFFERED_EXTERNAL: quiscent current of 600uA, input common mode of 0.2V to VDDA-0.2V, gain bandwidth of 6MHz,1mA output drive capability.</description>
                    <value>8</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ULTRA_HIGH</name>
                    <description>Do Not Use</description>
                    <value>9</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ULTRA_HIGH_RAIL</name>
                    <description>If TOPO=BUFFERED_INTERNAL: quiscent current of 800uA, input common mode of 0.2V to VDDA-0.2V, gain bandwidth of 2.8MHz.

If TOPO=BUFFERED_EXTERNAL: quiscent current of 800uA, input common mode of 0.2V to VDDA-0.2V, gain bandwidth of 7.5MHz, 10mA output drive capability.</description>
                    <value>10</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RSVD_0</name>
                    <description>N/A</description>
                    <value>11</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RSVD_1</name>
                    <description>N/A</description>
                    <value>12</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RSVD_2</name>
                    <description>N/A</description>
                    <value>13</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RSVD_3</name>
                    <description>N/A</description>
                    <value>14</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RSVD_4</name>
                    <description>N/A</description>
                    <value>15</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>FORMAT</name>
                <description>DAC output format select</description>
                <bitRange>[16:16]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>UNSIGNED12</name>
                    <description>Unsigned 12-bit number, i.e. no value decoding</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>VIRT_SIGNED12</name>
                    <description>Virtual signed 12-bits' VDAC. Value decoding: 
add 0x800 to the 12-bit Value (=invert MSB), to convert the lowest signed number 0x800 to the lowest unsigned number 0x000. This is the same as the SAR handles 12-bit 'virtual' signed numbers.</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>REF_MUX_SEL</name>
                <description>DAC reference mux output select</description>
                <bitRange>[30:28]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>VBGR</name>
                    <description>DAC reference mux is driven by the AREF bandgap output (source selected by AREF.CTRL.VREF_SEL)</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CTBL0_OA0</name>
                    <description>CTBL0 Opamp0 Output</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CTBL0_OA1</name>
                    <description>CTBL0 Opamp1 Output</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CTBL1_OA0</name>
                    <description>CTBL1 Opamp0 Output</description>
                    <value>3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CTBL1_OA1</name>
                    <description>CTBL1 Opamp1 Output</description>
                    <value>4</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>VDDA</name>
                    <description>Do Not Use</description>
                    <value>5</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PRB_VREF0</name>
                    <description>PRB VREF0 output</description>
                    <value>6</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PRB_VREF1</name>
                    <description>PRB VREF1 output</description>
                    <value>7</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>SAMPLE_TIME</name>
            <description>Sample control register  (only accessible if ACTRLR.STATUS.MODE=0)</description>
            <addressOffset>0x4</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFF</resetMask>
            <fields>
              <field>
                <name>SAMPLE_TIME</name>
                <description>Sample Time selection for Sample and Hold Modes

This field is only used if enabled DAC channel is configured for sample and hold operation (i.e. CHAN_CFG.SAMPLE_AND_HOLD_EN=1)

The sample time is measured in terms of CLK_HF (nominally 80MHz) cycles (if ACTRLR.STATUS.MODE=HS) or CLK_LPOSC (nominally 4.096MHz) cycles (if ACTRLR.STATUS.MODE=LP).
Sample time = SAMPLE_TIME+1, range 1..256</description>
                <bitRange>[7:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <dim>3</dim>
            <dimIncrement>4</dimIncrement>
            <name>STEP_VAL[%s]</name>
            <description>step val register  (only accessible if ACTRLR.STATUS.MODE=0)</description>
            <addressOffset>0x8</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFF</resetMask>
            <fields>
              <field>
                <name>VAL</name>
                <description>DAC step value.  Actual step value is VAL+1.  Step Type (address or data) is set by CHAN_CFG.MODE.

The maximim allowable step value is set by the operational mode as follows:

If CHAN_CFG.MODE= LUT_OS_ONE_QUAD, LUT_CONT_ONE_QUAD or ADDR: Max step size = (CHAN_CFG.END_ADDR - CHAN_CFG.START_ADDR + 1)

If CHAN_CFG.MODE= LUT_OS_TWO_QUAD, LUT_OS_FOUR_QUAD, LUT_CONT_TWO_QUAD, LUT_CONT_FOUR_QUAD: Max step size = (CHAN_CFG.END_ADDR - CHAN_CFG.START_ADDR)

If CHAN_CFG.MODE = DATA, there is no max step size.

If the programmed step size exceeds the Max step size, the hardware not not advance the address pointer, and an EPOCH will be produced every DAC_CLOCK_EN.</description>
                <bitRange>[7:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>DEGLITCH_TIME</name>
            <description>deglitch time register  (only accessible if ACTRLR.STATUS.MODE=0)</description>
            <addressOffset>0x18</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x1</resetValue>
            <resetMask>0xFF</resetMask>
            <fields>
              <field>
                <name>DEGLITCH_TIME</name>
                <description>Geglitch Time selection for DAC value updates

This field is only used if CTRL.DEGLITCH_EN=1.

The deglitch time is measured in terms of CLK_HF (nominally 80MHz) cycles (if ACTRLR.STATUS.MODE=HS) or CLK_LPOSC (nominally 4.096MHz) cycles (if ACTRLR.STATUS.MODE=LP).
Deglitch time = GEGLITCH_TIME+1, range 1..256</description>
                <bitRange>[7:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <dim>15</dim>
            <dimIncrement>4</dimIncrement>
            <name>CHAN_CFG[%s]</name>
            <description>Channel configuration register  (only accessible if ACTRLR.STATUS.MODE=0)</description>
            <addressOffset>0x20</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFF7FF7FF</resetMask>
            <fields>
              <field>
                <name>START_ADDR</name>
                <description>Start of Waveform Address pointer
When triggered (AC_DAC_TR), the DAC outputs the value at START_ADDR
START_ADDR is word(16bits) aligned and value ranges from 0-511</description>
                <bitRange>[10:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>END_ADDR</name>
                <description>End of Waveform Address pointer
The end address must be greater than or equal to the start address (START_ADDR)
END_ADDR is word(16bits) aligned and value ranges from 0-511</description>
                <bitRange>[22:12]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>MODE</name>
                <description>DAC operating mode</description>
                <bitRange>[26:24]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>LUT_OS_ONE_QUAD</name>
                    <description>DAC configured for One Shot One Quadrant LUT mode.</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LUT_OS_TWO_QUAD</name>
                    <description>DAC configured for One Shot Two Quadrant LUT mode.</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LUT_OS_FOUR_QUAD</name>
                    <description>DAC configured for One Shot Four Quadrant LUT mode.</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LUT_CONT_ONE_QUAD</name>
                    <description>DAC configured for Continuous One Quadrant LUT mode.</description>
                    <value>3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LUT_CONT_TWO_QUAD</name>
                    <description>DAC configured for Continuous Two Quadrant LUT mode.</description>
                    <value>4</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LUT_CONT_FOUR_QUAD</name>
                    <description>DAC configured for Continuous Four Quadrant LUT mode.</description>
                    <value>5</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ADDR</name>
                    <description>DAC configured for ADDRESS mode</description>
                    <value>6</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>DATA</name>
                    <description>DAC configured for DATA mode</description>
                    <value>7</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>SAMPLE_AND_HOLD_EN</name>
                <description>DAC Sample and Hold Enable

SAMPLE_AND_HOLD_EN can only be selected if CTRL.TOPO=BUFFERED_INTERNAL or BUFFERED_EXTERNAL.

The DAC is updated every positive edge of the DAC clock with the following sequence:

1.  The DAC is configured for SAMPLE: DAC array is enabled and outputs the updated value (based on MODE) onto a capacitor for SAMPLE_TIME duration.
2.  The DAC is configured for HOLD: DAC array is disabled and last output value is held on capacitor until next positive edge of the DAC clock (HOLD duration is DAC clock period - SAMPLE_TIME)

*NOTE: For MODE=ADDRESS or DATA, the AC must wait for (ACT=WAIT_FOR) the DAC strobe (COND=DAC_STROBE) before re-triggering the DAC_INC/DAC_DEC fields.</description>
                <bitRange>[27:27]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>STEP_VAL_SEL</name>
                <description>DAC Step Value Selection</description>
                <bitRange>[29:28]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DISABLED</name>
                    <description>STEP_VAL is 1.</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>STEP_0</name>
                    <description>STEP_VAL is set by STEP_VAL0.VAL.</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>STEP_1</name>
                    <description>STEP_VAL is set by STEP_VAL1.VAL.</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>STEP_2</name>
                    <description>STEP_VAL is set by STEP_VAL2.VAL.</description>
                    <value>3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>STATUS_SEL</name>
                <description>Status selections.</description>
                <bitRange>[31:30]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DISABLED</name>
                    <description>N/A</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>STATUS_0</name>
                    <description>N/A</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>STATUS_1</name>
                    <description>N/A</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>STATUS_2</name>
                    <description>N/A</description>
                    <value>3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>FW_DAC_VAL</name>
            <description>Firmare Channel DAC Value  (only accessible if ACTRLR.STATUS.MODE=0)</description>
            <addressOffset>0x60</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xCFFF</resetMask>
            <fields>
              <field>
                <name>VALUE</name>
                <description>DAC Value

Writes to this register are ignored unless ACTRLR.TIMER_TABLE_STRUCT.TT_CFG3.DAC[X]_CHANNEL=FW_CHANNEL</description>
                <bitRange>[11:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>OUT_DM</name>
                <description>DAC Output Drive Mode</description>
                <bitRange>[15:14]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>OUT_EN</name>
                    <description>DAC output enabled (outputs VALUE)</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>OUT_HIZ</name>
                    <description>DAC output disabled (output is Tri-state)</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>OUT_REF</name>
                    <description>DAC output disabled (output Vssa or Vref when disabled (see CTRL.BOT_SEL))</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RSVD</name>
                    <description>N/A</description>
                    <value>3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>FW_DAC_VAL_NXT</name>
            <description>Firmware Channel DAC Value Next</description>
            <addressOffset>0x64</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xCFFF</resetMask>
            <fields>
              <field>
                <name>VALUE</name>
                <description>Next value for FW_DAC_VAL.VALUE

Writes to this register are ignored unless
ACTRLR.TIMER_TABLE_STRUCT.TT_CFG3.DAC[X]_CHANNEL=FW_CHANNEL</description>
                <bitRange>[11:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>OUT_DM</name>
                <description>DAC Output Drive Mode</description>
                <bitRange>[15:14]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>OUT_EN</name>
                    <description>DAC output enabled (outputs VALUE)</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>OUT_HIZ</name>
                    <description>DAC output disabled (output is Tri-state)</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>OUT_REF</name>
                    <description>DAC output disabled (output Vssa or Vref when disabled (see CTRL.BOT_SEL))</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RSVD</name>
                    <description>N/A</description>
                    <value>3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <dim>3</dim>
            <dimIncrement>4</dimIncrement>
            <name>CHAN_STATUS_CFG[%s]</name>
            <description>Channel status configuration register</description>
            <addressOffset>0x70</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFF03</resetMask>
            <fields>
              <field>
                <name>RANGE_COND</name>
                <description>Range condition select.</description>
                <bitRange>[1:0]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>BELOW</name>
                    <description>DAC Value &lt; RANGE_LOW</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>INSIDE</name>
                    <description>RANGE_LOW &lt;= DAC Value/Address &lt; RANGE_HIGH</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ABOVE</name>
                    <description>DAC Value &gt; RANGE_HIGH</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>OUTSIDE</name>
                    <description>Dac Value &lt; RANGE_LOW || DAC Value/Address &gt;= RANGE_HIGH</description>
                    <value>3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>RANGE_LOW</name>
                <description>Low threshold for range detect</description>
                <bitRange>[19:8]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>RANGE_HIGH</name>
                <description>High threshold for range detect</description>
                <bitRange>[31:20]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>RANGE_STATUS</name>
            <description>Range status register</description>
            <addressOffset>0x80</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0x7FFF</resetMask>
            <fields>
              <field>
                <name>CHAN_RANGE_STATUS</name>
                <description>Channel Range detect status: hardware sets this bit for each channel if the condition specified by the CHAN_CFG.STATUS_SEL register is met. Write with '1' to clear bit.  This register does not apply to the FW Channel (Channel 15).</description>
                <bitRange>[14:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
        </cluster>
        <cluster>
          <name>TRIM</name>
          <description>DAC trim registers (only accessible if ACTRLR.STATUS.MODE=0)</description>
          <addressOffset>0x00000F00</addressOffset>
          <register>
            <name>REFBUF_OFFSET_TRIM</name>
            <description>Reference buffer trim control</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0x3F</resetMask>
            <fields>
              <field>
                <name>REFBUF_OFFSET_TRIM</name>
                <description>Refbuf offset trim</description>
                <bitRange>[5:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>REFBUF_SLOPE_OFFSET_TRIM</name>
            <description>Reference buffer trim control</description>
            <addressOffset>0x4</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0x3F</resetMask>
            <fields>
              <field>
                <name>REFBUF_SLOPE_OFFSET_TRIM</name>
                <description>Refbuf slope offset drift trim</description>
                <bitRange>[5:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>REFBUF_COMP_TRIM</name>
            <description>Reference buffer trim control</description>
            <addressOffset>0x8</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xF</resetMask>
            <fields>
              <field>
                <name>REFBUF_COMP_TRIM</name>
                <description>Buffer 0 Compensation Capacitor Trim

Bit&lt;3&gt; is not used

Bits&lt;2:0&gt;
000 = 0.1pF
001 = 1.1pF
010 = 2.1pF
011 = 3.1pF
100 = 4.1pF
101 = 5.1pF
110 = 6.1pF
111 = 7.1pF</description>
                <bitRange>[3:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <dim>2</dim>
            <dimIncrement>4</dimIncrement>
            <name>OUTBUF_OFFSET_TRIM[%s]</name>
            <description>Output buffer trim control</description>
            <addressOffset>0xC</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0x3F</resetMask>
            <fields>
              <field>
                <name>OUTBUF_OFFSET_TRIM</name>
                <description>Outbuf offset trim</description>
                <bitRange>[5:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <dim>2</dim>
            <dimIncrement>4</dimIncrement>
            <name>OUTBUF_SLOPE_OFFSET_TRIM[%s]</name>
            <description>Output buffer trim control</description>
            <addressOffset>0x14</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0x3F</resetMask>
            <fields>
              <field>
                <name>OUTBUF_SLOPE_OFFSET_TRIM</name>
                <description>Outbuf slope offset drift trim</description>
                <bitRange>[5:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <dim>2</dim>
            <dimIncrement>4</dimIncrement>
            <name>OUTBUF_COMP_TRIM[%s]</name>
            <description>Output buffer trim control</description>
            <addressOffset>0x1C</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xF</resetMask>
            <fields>
              <field>
                <name>OUTBUF_COMP_TRIM</name>
                <description>see REFBUF_COMP_TRIM.REFBUF_COMP_TRIM</description>
                <bitRange>[3:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>RMP_TRIM</name>
            <description>Risk Mitigation bits</description>
            <addressOffset>0x24</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x1</resetValue>
            <resetMask>0xF</resetMask>
            <fields>
              <field>
                <name>RMP_TRIM</name>
                <description>N/A</description>
                <bitRange>[3:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
        </cluster>
      </registers>
    </peripheral>
    <peripheral derivedFrom="DAC0">
      <name>DAC1</name>
      <baseAddress>0x42E70000</baseAddress>
    </peripheral>
    <peripheral>
      <name>SAR</name>
      <description>SAR</description>
      <baseAddress>0x42E80000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>65536</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <dim>32</dim>
          <dimIncrement>4</dimIncrement>
          <name>SEQ_HS_DATA[%s]</name>
          <description>SAR Sequencer High Speed Data (only accessible if ACTRLR.STATUS.MODE=0)</description>
          <addressOffset>0x100</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0x0</resetMask>
          <fields>
            <field>
              <name>HS_GPIO_CHAN_EN</name>
              <description>Enables for HS GPIO SAR Channels

For each bit in this field:
0- HS GPIO SAR Channel is disabled
1- HS GPIO SAR Channel is enabled

[0]: Channel 0, configured by SAR_STA_CFG.GPIO_CHAN_CFG0
[1]: Channel 1, configured by SAR_STA_CFG.GPIO_CHAN_CFG1
[2]: Channel 2, configured by SAR_STA_CFG.GPIO_CHAN_CFG2
[3]: Channel 3, configured by SAR_STA_CFG.GPIO_CHAN_CFG3
[4]: Channel 4, configured by SAR_STA_CFG.GPIO_CHAN_CFG4
[5]: Channel 5, configured by SAR_STA_CFG.GPIO_CHAN_CFG5
[6]: Channel 6, configured by SAR_STA_CFG.GPIO_CHAN_CFG6
[7]: Channel 7, configured by SAR_STA_CFG.GPIO_CHAN_CFG7</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>HS_MUX_CHAN_EN_SEL</name>
              <description>Enable and Selection for HS Muxed SAR Channels</description>
              <bitRange>[10:8]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLED</name>
                  <description>Disabled</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MUX0_SINGLE_ENDED</name>
                  <description>One Single Ended Conversion (configured by MUX0_CHAN_SEL)</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MUX1_SINGLE_ENDED</name>
                  <description>One Single Ended Conversion (configured by MUX1_CHAN_SEL)</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MUX0_AND_MUX1_SINGLE_ENDED</name>
                  <description>Two Simultaneously Sampled Single Ended Conversions (configured by MUX0_CHAN_SEL and MUX1_CHAN_SEL)</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MUX0_PSEUDO_DIFF</name>
                  <description>One Pseudo differential conversion (configured by MUX0_CHAN_SEL)</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RSVD_0</name>
                  <description>N/A</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RSVD_1</name>
                  <description>N/A</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RSVD_2</name>
                  <description>N/A</description>
                  <value>7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RSVD_0</name>
              <description>N/A</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>MUX0_CHAN_SEL</name>
              <description>MUX0 Channel Sel
(This field is not used if HS_MUX_CHAN_EN_SEL = DISABLED or MUX1_SINGLE_ENDED)</description>
              <bitRange>[15:12]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>MUX_CHANNEL_0</name>
                  <description>mux configured by settings in SAR_STA_CFG.MUX_CHAN_CFG0</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MUX_CHANNEL_1</name>
                  <description>mux configured by settings in SAR_STA_CFG.MUX_CHAN_CFG1</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MUX_CHANNEL_2</name>
                  <description>mux configured by settings in SAR_STA_CFG.MUX_CHAN_CFG2</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MUX_CHANNEL_3</name>
                  <description>mux configured by settings in SAR_STA_CFG.MUX_CHAN_CFG3</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MUX_CHANNEL_4</name>
                  <description>mux configured by settings in SAR_STA_CFG.MUX_CHAN_CFG4</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MUX_CHANNEL_5</name>
                  <description>mux configured by settings in SAR_STA_CFG.MUX_CHAN_CFG5</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MUX_CHANNEL_6</name>
                  <description>mux configured by settings in SAR_STA_CFG.MUX_CHAN_CFG6</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MUX_CHANNEL_7</name>
                  <description>mux configured by settings in SAR_STA_CFG.MUX_CHAN_CFG7</description>
                  <value>7</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MUX_CHANNEL_8</name>
                  <description>mux configured by settings in SAR_STA_CFG.MUX_CHAN_CFG8</description>
                  <value>8</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MUX_CHANNEL_9</name>
                  <description>mux configured by settings in SAR_STA_CFG.MUX_CHAN_CFG9</description>
                  <value>9</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MUX_CHANNEL_10</name>
                  <description>mux configured by settings in SAR_STA_CFG.MUX_CHAN_CFG10</description>
                  <value>10</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MUX_CHANNEL_11</name>
                  <description>mux configured by settings in SAR_STA_CFG.MUX_CHAN_CFG11</description>
                  <value>11</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MUX_CHANNEL_12</name>
                  <description>mux configured by settings in SAR_STA_CFG.MUX_CHAN_CFG12</description>
                  <value>12</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MUX_CHANNEL_13</name>
                  <description>mux configured by settings in SAR_STA_CFG.MUX_CHAN_CFG13</description>
                  <value>13</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MUX_CHANNEL_14</name>
                  <description>mux configured by settings in SAR_STA_CFG.MUX_CHAN_CFG14</description>
                  <value>14</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MUX_CHANNEL_15</name>
                  <description>mux configured by settings in SAR_STA_CFG.MUX_CHAN_CFG15</description>
                  <value>15</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MUX1_CHAN_SEL</name>
              <description>MUX1 Channel Sel
(See MUX0_CHAN_SEL)
(This field is not used if HS_MUX_CHAN_EN_SEL = DISABLED or MUX0_SINGLE_ENDED or MUX0_PSEUDO_DIFF)</description>
              <bitRange>[19:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>SAMPLE_TIME_SEL</name>
              <description>Sample Time Select.  Choose from 1 of 4 available Sample Times in SAR_STA_CFG.SAMPLE_TIME registers</description>
              <bitRange>[21:20]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>SAMPLE_TIME_EN</name>
              <description>Sample Time Enable.  If this bit is set, then the start of conversion for this SAR table entry will be delayed by the sample time pointed to in SAMPLE_TIME_SEL</description>
              <bitRange>[22:22]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>TR_SAMPLE_TIME_EN</name>
              <description>Trigger Sample Time Enable.  

This field must always remain 0.  

For risk mitigation purposes only: this bit only applies to the first SAR table entry pointed to by the Autonomous Controller on a trigger if additional  sample time is required.  When this bit is set, the sample time on this first triggered table entry is SAR_STA_CFG.TR_SAMPLE_TIME.HS_SAMPLE_TIME.  This only applies to when the table entry is first triggered.  In continuous mode, when this table entry is executed again, the SAMPLE_TIME_EN/SAMPLE_TIME_SEL will be used.</description>
              <bitRange>[23:23]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>AVG_CNT</name>
              <description>Averaging Count for channels that have averaging enabled (AVG_EN). A channel will be sampled and accumulated (1&lt;&lt;(AVG_CNT+1)) = [2..256] times.

If SAR_STA_CFG.GPIO(MUX)_CHAN_CFG.AVG_SHIFT for an enabled channel is set, the accumulated samples are right shifted based on the value of  SAR_STA_CFG.CTRL.SHIFT_MODE:
SAR_STA_CFG.CTRL.SHIFT_MODE=TWELVE: After the last accumulation, the result is shifted back to 12 bits
SAR_STA_CFG.CTRL.SHIFT_MODE=SIXTEEN: After the last accumulation, if avg_cnt &gt;=32 the result will be shifted back to 16-bits, if avg_cnt &lt; 32, no shift will be done as the result already is guaranteed to fit in 16 bits.</description>
              <bitRange>[26:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>AVG_EN</name>
              <description>Average Enable

This field is ignored if SAR_STA_CFG.CTRL.AVG_MODE=DISABLED.  

This field applies to all enabled channels (HS_GPIO_CHAN_EN and HS_MUX_CHAN_EN_SEL).

0 = averaging disabled

1 = averaging enabled

If SAR_STA_CFG.CTRL.AVG_MODE=ACCUNDUMP, the enabled channels will be sampled, converted, and accumulated back to back (amount set by AVG_CNT).  After AVG_CNT times, the accumulated results for each enabled channels are optionally shifted (set by SAR_STA_CFG.GPIO(MUX)_CHAN_CFG.AVG_SHIFT and SAR_STA_CFG.CTRL.SHIFT_MODE).

If SAR_STA_CFG.CTRL.AVG_MODE=INTERLEAVED, the enabled channels will be sampled, converted, and accumulated once per scan (amount set by AVG_CNT).  After AVG_CNT scans, the accumulated results for each enabled channels are optionally shifted (set by SAR_STA_CFG.GPIO(MUX)_CHAN_CFG.AVG_SHIFT and SAR_STA_CFG.CTRL.SHIFT_MODE).

Requirements for using interleaved averaging:

1.  The Entry Address state must have AVG_EN set.
2.  The same value for AVG_CNT must be used across all states with AVG_EN set.
3.  The AC cannot trigger the ADC with different multiple Entry Addresses (scans).
4.  The SAR generates a SAR_DONE status at the end of every scan (unless confgured for continuous operation at which point only a SAR_EOS is generated), regardless of the value of AVG_CNT.  If all channels in the scan are averaged, the AC can poll the SAR_RESULT or any of the SAR_(FIR)_FIFO_DONE triggers to determine when the averaged results are available.  If only a subset of channels are averaged in a scan, it is up to the AC to count the number of scans to determine when the averaged results are available.</description>
              <bitRange>[27:27]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CALIBRATE</name>
              <description>Real Time Calibration Request.  

This signals the ADC to initiate a real-time calibration process during an ADC scan.</description>
              <bitRange>[29:28]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLED</name>
                  <description>Calibration Disabled</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OFFSET_AND_LINEARITY</name>
                  <description>Calibrate both Offset and Linearity</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OFFSET</name>
                  <description>Callibrate Offset only</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LINEARITY</name>
                  <description>Callibrate Linearity only</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>NEXT_ACTION</name>
              <description>Next Addr Field</description>
              <bitRange>[31:30]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>STOP</name>
                  <description>assert SAR_DONE and SAR_EOS condition and go to idle.  This action is used to indicate the end of a scan.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GO_TO_ENTRY_ADDR</name>
                  <description>assert SAR_EOS condition and jump to Entry Addr.  This action is used for continuous operation.  In continuous operation, disabling the SAR (AC.SAR_EN=0) is the only mechanism available to cease SAR operation (without disabling the entire AC).</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GO_TO_NEXT</name>
                  <description>Go to next addr.  This action is used to continue to a next state in a given scan.</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RSVD</name>
                  <description>N/A</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <dim>32</dim>
          <dimIncrement>4</dimIncrement>
          <name>SEQ_LP_DATA[%s]</name>
          <description>SAR Sequencer Low Power Data (only accessible if ACTRLR.STATUS.MODE=0)</description>
          <addressOffset>0x180</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0x0</resetMask>
          <fields>
            <field>
              <name>LP_CHAN_EN</name>
              <description>LP Channel Enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RSVD_1</name>
              <description>N/A</description>
              <bitRange>[11:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CHAN_SEL</name>
              <description>LP Channel Select</description>
              <bitRange>[15:12]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>MUX_CHANNEL_0</name>
                  <description>mux configured by settings in SAR_STA_CFG.MUX_CHAN_CFG0</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MUX_CHANNEL_1</name>
                  <description>mux configured by settings in SAR_STA_CFG.MUX_CHAN_CFG1</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MUX_CHANNEL_2</name>
                  <description>mux configured by settings in SAR_STA_CFG.MUX_CHAN_CFG2</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MUX_CHANNEL_3</name>
                  <description>mux configured by settings in SAR_STA_CFG.MUX_CHAN_CFG3</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MUX_CHANNEL_4</name>
                  <description>mux configured by settings in SAR_STA_CFG.MUX_CHAN_CFG4</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MUX_CHANNEL_5</name>
                  <description>mux configured by settings in SAR_STA_CFG.MUX_CHAN_CFG5</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MUX_CHANNEL_6</name>
                  <description>mux configured by settings in SAR_STA_CFG.MUX_CHAN_CFG6</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MUX_CHANNEL_7</name>
                  <description>mux configured by settings in SAR_STA_CFG.MUX_CHAN_CFG7</description>
                  <value>7</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MUX_CHANNEL_8</name>
                  <description>mux configured by settings in SAR_STA_CFG.MUX_CHAN_CFG8</description>
                  <value>8</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MUX_CHANNEL_9</name>
                  <description>mux configured by settings in SAR_STA_CFG.MUX_CHAN_CFG9</description>
                  <value>9</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MUX_CHANNEL_10</name>
                  <description>mux configured by settings in SAR_STA_CFG.MUX_CHAN_CFG10</description>
                  <value>10</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MUX_CHANNEL_11</name>
                  <description>mux configured by settings in SAR_STA_CFG.MUX_CHAN_CFG11</description>
                  <value>11</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MUX_CHANNEL_12</name>
                  <description>mux configured by settings in SAR_STA_CFG.MUX_CHAN_CFG12</description>
                  <value>12</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MUX_CHANNEL_13</name>
                  <description>mux configured by settings in SAR_STA_CFG.MUX_CHAN_CFG13</description>
                  <value>13</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MUX_CHANNEL_14</name>
                  <description>mux configured by settings in SAR_STA_CFG.MUX_CHAN_CFG14</description>
                  <value>14</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MUX_CHANNEL_15</name>
                  <description>mux configured by settings in SAR_STA_CFG.MUX_CHAN_CFG15</description>
                  <value>15</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RSVD_2</name>
              <description>N/A</description>
              <bitRange>[19:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>SAMPLE_TIME_SEL</name>
              <description>Sample Time Select.  Choose from 1 of 4 available Sample Times for the static config</description>
              <bitRange>[21:20]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>SAMPLE_TIME_EN</name>
              <description>Sample Time Enable.  If this bit is set, then the start of conversion for this SAR table entry will be delayed by the sample time pointed to in SAMPLE_TIME_SEL</description>
              <bitRange>[22:22]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>TR_SAMPLE_TIME_EN</name>
              <description>Trigger Sample Time Enable.  

This field must always remain 0.  

For risk mitigation purposes only: this bit only applies to the first SAR table entry pointed to by the Autonomous Controller on a trigger if additional  sample time is required.  When this bit is set, the sample time on this first triggered table entry is SAR_STA_CFG.TR_SAMPLE_TIME.LP_SAMPLE_TIME.  This only applies to when the table entry is first triggered.  In continuous mode, when this table entry is executed again, the SAMPLE_TIME_EN/SAMPLE_TIME_SEL will be used.</description>
              <bitRange>[23:23]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>AVG_CNT</name>
              <description>Averaging Count for channels that have averaging enabled (AVG_EN). A channel will be sampled and accumulated (1&lt;&lt;(AVG_CNT+1)) = [2..256] times.

If SAR_STA_CFG.GPIO(MUX)_CHAN_CFG.AVG_SHIFT for an enabled channel is set, the accumulated samples are right shifted based on the value of  SAR_STA_CFG.CTRL.SHIFT_MODE:
SAR_STA_CFG.CTRL.SHIFT_MODE=TWELVE: After the last accumulation, the result is shifted back to 12 bits
SAR_STA_CFG.CTRL.SHIFT_MODE=SIXTEEN: After the last accumulation, if avg_cnt &gt;=32 the result will be shifted back to 16-bits, if avg_cnt &lt; 32, no shift will be done as the result already is guaranteed to fit in 16 bits.</description>
              <bitRange>[26:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>AVG_EN</name>
              <description>Average Enable

This field is ignored if SAR_STA_CFG.CTRL.AVG_MODE=DISABLED.  

This field applies to all enabled channels (HS_GPIO_CHAN_EN and HS_MUX_CHAN_EN_SEL).

0 = averaging disabled

1 = averaging enabled

If SAR_STA_CFG.CTRL.AVG_MODE=ACCUNDUMP, the enabled channels will be sampled, converted, and accumulated back to back (amount set by AVG_CNT).  After AVG_CNT times, the accumulated results for each enabled channels are optionally shifted (set by SAR_STA_CFG.GPIO(MUX)_CHAN_CFG.AVG_SHIFT and SAR_STA_CFG.CTRL.SHIFT_MODE).

If SAR_STA_CFG.CTRL.AVG_MODE=INTERLEAVED, the enabled channels will be sampled, converted, and accumulated once per scan (amount set by AVG_CNT).  After AVG_CNT scans, the accumulated results for each enabled channels are optionally shifted (set by SAR_STA_CFG.GPIO(MUX)_CHAN_CFG.AVG_SHIFT and SAR_STA_CFG.CTRL.SHIFT_MODE).

Requirements for using interleaved averaging:

1.  The Entry Address state must have AVG_EN set.
2.  The same value for AVG_CNT must be used across all states with AVG_EN set.
3.  The AC cannot trigger the ADC with different multiple Entry Addresses (scans).
4.  The SAR generates a SAR_DONE status at the end of every scan (unless confgured for continuous operation at which point only a SAR_EOS is generated), regardless of the value of AVG_CNT.  If all channels in the scan are averaged, the AC can poll the SAR_RESULT or any of the SAR_(FIR)_FIFO_DONE triggers to determine when the averaged results are available.  If only a subset of channels are averaged in a scan, it is up to the AC to count the number of scans to determine when the averaged results are available.</description>
              <bitRange>[27:27]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CALIBRATE</name>
              <description>Real Time Calibration Request.  

This signals the ADC to initiate a real-time calibration process during an ADC scan.</description>
              <bitRange>[29:28]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLED</name>
                  <description>Calibration Disabled</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OFFSET_AND_LINEARITY</name>
                  <description>Calibrate both Offset and Linearity</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OFFSET</name>
                  <description>Callibrate Offset only</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LINEARITY</name>
                  <description>Callibrate Linearity only</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>NEXT_ACTION</name>
              <description>Next Addr Field</description>
              <bitRange>[31:30]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>STOP</name>
                  <description>assert SAR_DONE and SAR_EOS condition and go to idle.  This action is used to indicate the end of a scan.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GO_TO_ENTRY_ADDR</name>
                  <description>assert SAR_EOS condition and jump to Entry Addr.  This action is used for continuous operation.  In continuous operation, disabling the SAR (AC.SAR_EN=0) is the only mechanism available to cease SAR operation (without disabling the entire AC).</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GO_TO_NEXT</name>
                  <description>Go to next addr.  This action is used to continue to a next state in a given scan.</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RSVD</name>
                  <description>N/A</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <cluster>
          <name>STA</name>
          <description>SAR static configuration registers</description>
          <addressOffset>0x00000400</addressOffset>
          <register>
            <name>CTRL</name>
            <description>SAR Control register (only accessible if ACTRLR.STATUS.MODE=0)</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x80</resetValue>
            <resetMask>0xFFFFF7</resetMask>
            <fields>
              <field>
                <name>HS_VREF_SEL</name>
                <description>ADC Core VREF selection</description>
                <bitRange>[2:0]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>VDDA</name>
                    <description>VREF set to VDDA.  The internal reference buffer is off, and an external capacitor is not used.</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>VREF_EXT</name>
                    <description>VREF set to external reference (provided through GPIO).  The internal reference buffer is off, and an external capacitor is optional.</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>VBGR</name>
                    <description>VREF set to internal bandgap reference.  The internal reference buffer is on, and an external capacitor is mandatory for HS mode and optional for LP mode.</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>VDDA_BY_2</name>
                    <description>VREF set to internal VDDA divider (VDDA/2).  The internal reference buffer is on, and an external capacitor is not mandatory for HS mode and optional for LP mode.</description>
                    <value>3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PRB_VREF0</name>
                    <description>VREF set to internal PRB Reference 0.  The internal reference buffer is on, and an external capacitor is mandatory for both HS and LP modes.</description>
                    <value>4</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PRB_VREF1</name>
                    <description>VREF set to internal PRB Reference 0.  The internal reference buffer is on, and an external capacitor is mandatory for both HS and LP modes.</description>
                    <value>5</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RSVD_0</name>
                    <description>N/A</description>
                    <value>6</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RSVD_1</name>
                    <description>N/A</description>
                    <value>7</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>LP_VREF_SEL</name>
                <description>See HS_VREF_SEL</description>
                <bitRange>[6:4]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>LP_DIFFERENTIAL_EN</name>
                <description>Low Power Differential Enable

This field is only used for LP mode and is applied to all Mux Channels.</description>
                <bitRange>[7:7]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DISABLED</name>
                    <description>Single ended operation (MUX_CHAN_CFG[X].NEG_PIN_SEL and MUX_CHAN_CFG[X].NEG_COEFF_SEL are ignored)</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ENABLED</name>
                    <description>Differential operation MUX_CHAN_CFG[X].NEG_PIN_SEL and MUX_CHAN_CFG[X].NEG_COEFF_SEL are used.</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>BUF0_PWR_MODE</name>
                <description>Buffer zero power level</description>
                <bitRange>[11:8]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>OFF</name>
                    <description>Off</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ULTRA_LOW</name>
                    <description>Buffer quiscent current of 15uA, input common mode of 0.2V to VDDA-1V, gain bandwidth 30kHz</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ULTRA_LOW_RAIL</name>
                    <description>Buffer quiscent current of 35uA, input common mode of 0.2V to VDDA-0.2V, gain bandwidth 30kHz</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LOW</name>
                    <description>Do Not Use</description>
                    <value>3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LOW_RAIL</name>
                    <description>Buffer quiscent current of 150uA, input common mode of 0.2V to VDDA-0.2V, gain bandwidth 350kHz</description>
                    <value>4</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>MEDIUM</name>
                    <description>Do Not Use</description>
                    <value>5</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>MEDIUM_RAIL</name>
                    <description>Buffer quiscent current of 200uA, input common mode of 0.2V to VDDA-0.2V, gain bandwidth 700kHz</description>
                    <value>6</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HIGH</name>
                    <description>Do Not Use</description>
                    <value>7</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HIGH_RAIL</name>
                    <description>Buffer quiscent current of 600uA, input common mode of 0.2V to VDDA-0.2V, gain bandwidth 1.75MHz</description>
                    <value>8</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ULTRA_HIGH</name>
                    <description>Do Not Use</description>
                    <value>9</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ULTRA_HIGH_RAIL</name>
                    <description>Buffer quiscent current of 800uA, input common mode of 0.2V to VDDA-0.2V, gain bandwidth 2.8MHz</description>
                    <value>10</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RSVD_0</name>
                    <description>N/A</description>
                    <value>11</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RSVD_1</name>
                    <description>N/A</description>
                    <value>12</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RSVD_2</name>
                    <description>N/A</description>
                    <value>13</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RSVD_3</name>
                    <description>N/A</description>
                    <value>14</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RSVD_4</name>
                    <description>N/A</description>
                    <value>15</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>BUF1_PWR_MODE</name>
                <description>Output buffer power level: see description of BUF0_PWR_MODE</description>
                <bitRange>[15:12]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>AVG_MODE</name>
                <description>Averaging mode applied to all channels in a scan where averaging is enabled</description>
                <bitRange>[17:16]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DISABLED</name>
                    <description>Disabled</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ACCUNDUMP</name>
                    <description>Accumulate and Dump (1st order accumulate and dump filter): enabled channels for a given SEQ_HS(LP)_DATA state with AVG_EN set will be accumulated back to back and optionally shifted (if GPIO(MUX)_CHAN_CFG.SHIFT_EN is set).  The number of accumulations is set by SEQ_HS(LP)_DATA.AVG_CNT.</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RSVD_0</name>
                    <description>N/A</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RSVD_1</name>
                    <description>N/A</description>
                    <value>3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>STARTUP_CAL_EN</name>
                <description>Startup calibration request

This field is used to request a calibration process whenever the SAR is powered up (i.e. when AC.SAR.EN toggles from 0 to 1).</description>
                <bitRange>[19:18]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DISABLED</name>
                    <description>Startup calibration Disabled</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>OFFSET_AND_LINEARITY</name>
                    <description>calibrate both Offset and Linearity</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>OFFSET</name>
                    <description>callibrate Offset only</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LINEARITY</name>
                    <description>callibrate Linearity only</description>
                    <value>3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>CHAN_ID_EN</name>
                <description>Channel Number Identifier Enable</description>
                <bitRange>[20:20]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DISABLED</name>
                    <description>Data stored in FIFO (selected by GPIO_CHAN_CFG.FIFO_SEL or MUX_CHAN_CFG.FIFO_SEL) does not include Channel Number Identifier. FIFO data is SAR result sign extended to 32-bits.</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ENABLED</name>
                    <description>Data stored in FIFO (selected by GPIO_CHAN_CFG.FIFO_SEL ot MUX_CHAN_CFG.FIFO_SEL) does include Channel Number Identifier.  MSB of FIFO data ([31:24]) is defined as follows:</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>SHIFT_MODE</name>
                <description>If GPIO(MUX)_CHAN_CFG.AVG_SHIFT is enabled for a given channel, shift the result to support 12 or 16-bit resolutions.  This field does not impact FIR outputs.</description>
                <bitRange>[21:21]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>TWELVE</name>
                    <description>TWELVE: After the last accumulation, the result is shifted back to 12 bits</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>SIXTEEN</name>
                    <description>SIXTEEN: After the last accumulation, if SEQ_HS(LP)_DATA.AVG_CNT &gt;=32 the result will be shifted back to 16-bits, if SEQ_HS(LP)_DATA.AVG_CNT &lt; 32, no shift will be done as the result already is guaranteed to fit in 16 bits.</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>LP_SAR_PWR_MODE</name>
                <description>Request to disable Channel Buffer after sampling is done and SAR Macro after conversion is done. (Valid only in LP mode).</description>
                <bitRange>[23:22]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DISABLED</name>
                    <description>Buffer and Core are not disabled</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>BUFFER_AND_CORE</name>
                    <description>Disable both Buffer and Core</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>BUFFER</name>
                    <description>Disable Buffer only</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CORE</name>
                    <description>Disable Core only</description>
                    <value>3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <dim>2</dim>
            <dimIncrement>4</dimIncrement>
