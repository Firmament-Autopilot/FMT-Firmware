                  <bitRange>[31:24]</bitRange>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>CMD_PKT_STATUS</name>
              <description>Contains information about the status of FIFOs related to DBI and Generic interface.</description>
              <addressOffset>0x74</addressOffset>
              <size>32</size>
              <access>read-only</access>
              <resetValue>0x5051515</resetValue>
              <resetMask>0xFFFFFFFF</resetMask>
              <fields>
                <field>
                  <name>CMD_PKT_STATUS_GEN_CMD_EMPTY</name>
                  <description>This bit indicates the empty status of the generic command FIFO.</description>
                  <bitRange>[0:0]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>CMD_PKT_STATUS_GEN_CMD_FULL</name>
                  <description>This bit indicates the full status of the generic command FIFO.</description>
                  <bitRange>[1:1]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>CMD_PKT_STATUS_GEN_PLD_W_EMPTY</name>
                  <description>This bit indicates the empty status of the generic write payload FIFO.</description>
                  <bitRange>[2:2]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>CMD_PKT_STATUS_GEN_PLD_W_FULL</name>
                  <description>This bit indicates the full status of the generic write payload FIFO.</description>
                  <bitRange>[3:3]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>CMD_PKT_STATUS_GEN_PLD_R_EMPTY</name>
                  <description>This bit indicates the empty status of the generic read payload FIFO.</description>
                  <bitRange>[4:4]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>CMD_PKT_STATUS_GEN_PLD_R_FULL</name>
                  <description>This bit indicates the full status of the generic read payload FIFO.</description>
                  <bitRange>[5:5]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>CMD_PKT_STATUS_GEN_RD_CMD_BUSY</name>
                  <description>This bit is set when a read command is issued and cleared when the entire response is stored in the FIFO for GENERIC interface.</description>
                  <bitRange>[6:6]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>CMD_PKT_STATUS_RSVD_7</name>
                  <description>N/A</description>
                  <bitRange>[7:7]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>CMD_PKT_STATUS_DBI_CMD_EMPY</name>
                  <description>This bit indicates the empty status of the DBI command FIFO.</description>
                  <bitRange>[8:8]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>CMD_PKT_STATUS_DBI_CMD_FULL</name>
                  <description>This bit indicates the full status of the DBI command FIFO.</description>
                  <bitRange>[9:9]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>CMD_PKT_STATUS_DBI_PLD_W_EMPTY</name>
                  <description>This bit indicates the empty status of the DBI write payload FIFO.</description>
                  <bitRange>[10:10]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>CMD_PKT_STATUS_DBI_PLD_W_FULL</name>
                  <description>This bit indicates the full status of the DBI write payload FIFO.</description>
                  <bitRange>[11:11]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>CMD_PKT_STATUS_DBI_PLD_R_EMPTY</name>
                  <description>This bit indicates the empty status of the DBI read payload</description>
                  <bitRange>[12:12]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>CMD_PKT_STATUS_DBI_PLD_R_FULL</name>
                  <description>This bit indicates the full status of the DBI read payload FIFO.</description>
                  <bitRange>[13:13]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>CMD_PKT_STATUS_DBI_RD_CMD_BUSY</name>
                  <description>This bit is set when a read command is issued and cleared when the entire response is stored in the FIFO for DBI interface.</description>
                  <bitRange>[14:14]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>CMD_PKT_STATUS_RSVD_15</name>
                  <description>N/A</description>
                  <bitRange>[15:15]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>CMD_PKT_STATUS_GEN_BUFF_CMD_EMPTY</name>
                  <description>This bit indicates the empty status of the generic command internal buffer.</description>
                  <bitRange>[16:16]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>CMD_PKT_STATUS_GEN_BUFF_CMD_FULL</name>
                  <description>This bit indicates the full status of the generic command internal buffer.</description>
                  <bitRange>[17:17]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>CMD_PKT_STATUS_GEN_BUFF_PLD_EMPTY</name>
                  <description>This bit indicates the empty status of the generic payload internal buffer.</description>
                  <bitRange>[18:18]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>CMD_PKT_STATUS_GEN_BUFF_PLD_FULL</name>
                  <description>This bit indicates the full status of the generic payload internal buffer.</description>
                  <bitRange>[19:19]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>CMD_PKT_STATUS_RSVD_23_20</name>
                  <description>N/A</description>
                  <bitRange>[23:20]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>CMD_PKT_STATUS_DBI_BUFF_CMD_EMPTY</name>
                  <description>This bit indicates the empty status of the DBI command internal buffer.</description>
                  <bitRange>[24:24]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>CMD_PKT_STATUS_DBI_BUFF_CMD_FULL</name>
                  <description>This bit indicates the full status of the DBI command internal buffer.</description>
                  <bitRange>[25:25]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>CMD_PKT_STATUS_DBI_BUFF_PLD_EMPTY</name>
                  <description>This bit indicates the empty status of the DBI payload internal buffer.</description>
                  <bitRange>[26:26]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>CMD_PKT_STATUS_DBI_BUFF_PLD_FULL</name>
                  <description>This bit indicates the full status of the DBI payload internal buffer.</description>
                  <bitRange>[27:27]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>CMD_PKT_STATUS_RSVD_31_28</name>
                  <description>N/A</description>
                  <bitRange>[31:28]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>TO_CNT_CFG</name>
              <description>Configures counters that trigger timeout errors. These are used to warn the system of a failure, through an interrupt, and restart the controller in case of unexpected situations that cause deadlock conditions.</description>
              <addressOffset>0x78</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x0</resetValue>
              <resetMask>0xFFFFFFFF</resetMask>
              <fields>
                <field>
                  <name>TO_CNT_CFG_LPRX_TO_CNT</name>
                  <description>This field configures the timeout counter that triggers a low-power reception timeout contention detection (measured in TO_CLK_DIVISION cycles).</description>
                  <bitRange>[15:0]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>TO_CNT_CFG_HSTX_TO_CNT</name>
                  <description>This field configures the timeout counter that triggers a high-speed transmission timeout contention detection (measured in TO_CLK_DIVISION cycles).  If using non-burst mode and there is not sufficient time to switch from high-speed to low-power and back in the period which is from one line data finishing to the next line sync start, the DSI link returns low-power state once per frame, then you should configure the TO_CLK_DIVISION and hstx_to_cnt to satisfy the following formula: hstx_to_cnt * lanebyteclkperiod * TO_CLK_DIVISION &gt;= the time of one FRAME data transmission * (1 + 10 percent)  In burst mode, RGB pixel packets are time-compressed, leaving more time during a scan line. So if in burst mode and there is sufficient time to switch from high-speed to low-power and back in the period of time from one line data finishing to the next line sync start, the DSI link can return low-power mode and back in this time interval to save power. If you choose so, you should configure the TO_CLK_DIVISION and hstx_to_cnt to satisfy the following formula: hstx_to_cnt * lanebyteclkperiod * TO_CLK_DIVISION &gt;= the time of one LINE data transmission * (1 + 10 percent)</description>
                  <bitRange>[31:16]</bitRange>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>HS_RD_TO_CNT</name>
              <description>Configures the Peripheral Response timeout after high-speed Read operations.</description>
              <addressOffset>0x7C</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x0</resetValue>
              <resetMask>0xFFFFFFFF</resetMask>
              <fields>
                <field>
                  <name>HS_RD_TO_CNT_HS_RD_TO_CNT</name>
                  <description>This field sets a period for which DWC_mipi_dsi_host keeps the link still, after sending a high-speed Read operation. This period is measured in cycles of lanebyteclk, starts to count when the D-PHY enters stop state and causes no interrupts.</description>
                  <bitRange>[15:0]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>HS_RD_TO_CNT_RSVD_31_16</name>
                  <description>N/A</description>
                  <bitRange>[31:16]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>LP_RD_TO_CNT</name>
              <description>Configures the Peripheral Response timeout after low-power Read operations.</description>
              <addressOffset>0x80</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x0</resetValue>
              <resetMask>0xFFFFFFFF</resetMask>
              <fields>
                <field>
                  <name>LP_RD_TO_CNT_LP_RD_TO_CNT</name>
                  <description>This field sets a period for which DWC_mipi_dsi_host keeps the link still, after sending a low-power Read operation. This period is measured in cycles of lanebyteclk, starts to count when the D-PHY enters stop state and causes no interrupts.</description>
                  <bitRange>[15:0]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>LP_RD_TO_CNT_RSVD_31_16</name>
                  <description>N/A</description>
                  <bitRange>[31:16]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>HS_WR_TO_CNT</name>
              <description>Configures the Peripheral Response timeout after high-speed Write operations.</description>
              <addressOffset>0x84</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x0</resetValue>
              <resetMask>0xFFFFFFFF</resetMask>
              <fields>
                <field>
                  <name>HS_WR_TO_CNT_HS_WR_TO_CNT</name>
                  <description>This field sets a period for which DWC_mipi_dsi_host keeps the link still, after sending a high-speed Write operation. This period is measured in cycles of lanebyteclk, starts to count when the D-PHY enters stop state and causes no interrupts.</description>
                  <bitRange>[15:0]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>HS_WR_TO_CNT_RSVD_23_16</name>
                  <description>N/A</description>
                  <bitRange>[23:16]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>HS_WR_TO_CNT_RSVD_24</name>
                  <description>N/A</description>
                  <bitRange>[24:24]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>HS_WR_TO_CNT_RSVD_31_25</name>
                  <description>N/A</description>
                  <bitRange>[31:25]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>LP_WR_TO_CNT</name>
              <description>Configures the Peripheral Response timeout after low-power Write operations.</description>
              <addressOffset>0x88</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x0</resetValue>
              <resetMask>0xFFFFFFFF</resetMask>
              <fields>
                <field>
                  <name>LP_WR_TO_CNT_LP_WR_TO_CNT</name>
                  <description>This field sets a period for which DWC_mipi_dsi_host keeps the link still, after sending a low-power Write operation. This period is measured in cycles of lanebyteclk, starts to count when the D-PHY enters stop state and causes no interrupts.</description>
                  <bitRange>[15:0]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>LP_WR_TO_CNT_RSVD_31_16</name>
                  <description>N/A</description>
                  <bitRange>[31:16]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>BTA_TO_CNT</name>
              <description>Configures the Peripheral Response timeout after Bus Turnaround completion.</description>
              <addressOffset>0x8C</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x0</resetValue>
              <resetMask>0xFFFFFFFF</resetMask>
              <fields>
                <field>
                  <name>BTA_TO_CNT_BTA_TO_CNT</name>
                  <description>This field sets a period for which DWC_mipi_dsi_host keeps the link still, after completing a Bus Turnaround. This period is measured in cycles of lanebyteclk, starts to count when the D-PHY enters stop state and causes no interrupts.</description>
                  <bitRange>[15:0]</bitRange>
