                  <name>GCREGDEBUGLSTCURSORREQ_NUM</name>
                  <description>(none)</description>
                  <bitRange>[31:0]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>GCREGDEBUGTOTCURSORRRB</name>
              <description>debug registers.. count cursor current frame number of returned burst. READ ONLY</description>
              <addressOffset>0x1DC</addressOffset>
              <size>32</size>
              <access>read-only</access>
              <resetValue>0x0</resetValue>
              <resetMask>0xFFFFFFFF</resetMask>
              <fields>
                <field>
                  <name>GCREGDEBUGTOTCURSORRRB_NUM</name>
                  <description>(none)</description>
                  <bitRange>[31:0]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>GCREGDEBUGLSTCURSORRRB</name>
              <description>debug registers.. count cursor last frame number of returned burst. READ ONLY</description>
              <addressOffset>0x1E0</addressOffset>
              <size>32</size>
              <access>read-only</access>
              <resetValue>0x0</resetValue>
              <resetMask>0xFFFFFFFF</resetMask>
              <fields>
                <field>
                  <name>GCREGDEBUGLSTCURSORRRB_NUM</name>
                  <description>(none)</description>
                  <bitRange>[31:0]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>GCREGDEBUGTOTDCREQ</name>
              <description>debug registers.. count DC current frame number of requested burst. READ ONLY</description>
              <addressOffset>0x1E4</addressOffset>
              <size>32</size>
              <access>read-only</access>
              <resetValue>0x0</resetValue>
              <resetMask>0xFFFFFFFF</resetMask>
              <fields>
                <field>
                  <name>GCREGDEBUGTOTDCREQ_NUM</name>
                  <description>(none)</description>
                  <bitRange>[31:0]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>GCREGDEBUGLSTDCREQ</name>
              <description>debug registers.. count DC last frame number of requested burst. READ ONLY</description>
              <addressOffset>0x1E8</addressOffset>
              <size>32</size>
              <access>read-only</access>
              <resetValue>0x0</resetValue>
              <resetMask>0xFFFFFFFF</resetMask>
              <fields>
                <field>
                  <name>GCREGDEBUGLSTDCREQ_NUM</name>
                  <description>(none)</description>
                  <bitRange>[31:0]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>GCREGDEBUGTOTDCRRB</name>
              <description>debug registers.. count DC current frame number of returned burst. READ ONLY</description>
              <addressOffset>0x1EC</addressOffset>
              <size>32</size>
              <access>read-only</access>
              <resetValue>0x0</resetValue>
              <resetMask>0xFFFFFFFF</resetMask>
              <fields>
                <field>
                  <name>GCREGDEBUGTOTDCRRB_NUM</name>
                  <description>(none)</description>
                  <bitRange>[31:0]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>GCREGDEBUGLSTDCRRB</name>
              <description>debug registers.. count DC last frame number of returned burst. READ ONLY</description>
              <addressOffset>0x1F0</addressOffset>
              <size>32</size>
              <access>read-only</access>
              <resetValue>0x0</resetValue>
              <resetMask>0xFFFFFFFF</resetMask>
              <fields>
                <field>
                  <name>GCREGDEBUGLSTDCRRB_NUM</name>
                  <description>(none)</description>
                  <bitRange>[31:0]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>GCREGDEBUGFRAMEANDMISFLAG</name>
              <description>debug registers. READ ONLY</description>
              <addressOffset>0x1F4</addressOffset>
              <size>32</size>
              <access>read-only</access>
              <resetValue>0x0</resetValue>
              <resetMask>0xFFFFFFFF</resetMask>
              <fields>
                <field>
                  <name>GCREGDEBUGFRAMEANDMISFLAG_CURRENT_MISMATCH_FLAG_TOTAL</name>
                  <description>debug registers: indicate DC current frame mismatch of request and rerurn back number</description>
                  <bitRange>[0:0]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>GCREGDEBUGFRAMEANDMISFLAG_CURRENT_MISMATCH_FLAG</name>
                  <description>debug registers: indicate each layer current frame mismatch of request and rerurn back number</description>
                  <bitRange>[4:1]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>GCREGDEBUGFRAMEANDMISFLAG_CURRENT_FRAME_CNT</name>
                  <description>debug registers: count DC current frame number</description>
                  <bitRange>[15:5]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>GCREGDEBUGFRAMEANDMISFLAG_LAST_MISMATCH_FLAG_TOTAL</name>
                  <description>debug registers: indicate DC last frame mismatch of request and rerurn back number</description>
                  <bitRange>[16:16]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>GCREGDEBUGFRAMEANDMISFLAG_LAST_MISMATCH_FLAG</name>
                  <description>debug registers: indicate each layer last frame mismatch of request and rerurn back number</description>
                  <bitRange>[20:17]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>GCREGDEBUGFRAMEANDMISFLAG_LAST_FRAME_CNT</name>
                  <description>debug registers: count DC last frame number</description>
                  <bitRange>[31:21]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
          </cluster>
        </cluster>
        <cluster>
          <name>GFXSS_MIPIDSI</name>
          <description>MIPI-DSI Host Controller.</description>
          <headerStructName>GFXSS_MIPIDSI</headerStructName>
          <addressOffset>0x00002000</addressOffset>
          <cluster>
            <name>MXMIPIDSI</name>
            <description>Platform IP standard configuration for MIPI-DSI.</description>
            <headerStructName>GFXSS_MIPIDSI_MXMIPIDSI</headerStructName>
            <addressOffset>0x00000000</addressOffset>
            <register>
              <name>CTL</name>
              <description>IP control.</description>
              <addressOffset>0x0</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x0</resetValue>
              <resetMask>0x80000000</resetMask>
              <fields>
                <field>
                  <name>ENABLED</name>
                  <description>IP enable bit. When disabled (value 0), the functional state of the core is reset. That includes the MMIO map of the core (access results in an AHB error response). Registers of this map are still accesible then.</description>
                  <bitRange>[31:31]</bitRange>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>CLK_CTL</name>
              <description>Clock control.</description>
              <addressOffset>0x4</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x1</resetValue>
              <resetMask>0x1</resetMask>
              <fields>
                <field>
                  <name>CLK_CFG</name>
                  <description>Setup for DPHY configuration clock. Typical value is DIV2. Must only be set to DIV1 if the system clock is not faster than 52 MHz and has a duty cycle of 50 percent. Change only while IP is disabled.</description>
                  <bitRange>[0:0]</bitRange>
                  <access>read-write</access>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>SYS_DIV1</name>
                      <description>System clock.</description>
                      <value>0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>SYS_DIV2</name>
                      <description>System clock divided by 2. Enforces correct duty cycle for the configuration clock.</description>
                      <value>1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
              </fields>
            </register>
            <register>
              <name>INTR</name>
              <description>Interrupt status bits.</description>
              <addressOffset>0x10</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x0</resetValue>
              <resetMask>0x10101</resetMask>
              <fields>
                <field>
                  <name>CORE</name>
                  <description>The DSI Host Controller core has signalled an interrupt. Writing a '1' to this field resets the bit. Interrupt status inside the core is not affected by this.</description>
                  <bitRange>[0:0]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>DBI_TE</name>
                  <description>Tearing Effect was signalled by a display in DBI mode. Writing a '1' to this field resets the bit.</description>
                  <bitRange>[8:8]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>DPI_HALT</name>
                  <description>Command transmission error occurred in DPI mode. A command initiated by the generic slave interface was too large for transmission during the blanking period of the video timing. Writing a '1' to this field resets the bit.</description>
                  <bitRange>[16:16]</bitRange>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>INTR_SET</name>
              <description>Interrupt set bits.</description>
              <addressOffset>0x14</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x0</resetValue>
              <resetMask>0x10101</resetMask>
              <fields>
                <field>
                  <name>CORE_SET</name>
                  <description>Write this field with '1' to set corresponding INTR field (a write of '0' has no effect).</description>
                  <bitRange>[0:0]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>DBI_TE_SET</name>
                  <description>Write this field with '1' to set corresponding INTR field (a write of '0' has no effect).</description>
                  <bitRange>[8:8]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>DPI_HALT_SET</name>
                  <description>Write this field with '1' to set corresponding INTR field (a write of '0' has no effect).</description>
                  <bitRange>[16:16]</bitRange>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>INTR_MASK</name>
              <description>Interrupt mask bits.</description>
              <addressOffset>0x18</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x0</resetValue>
              <resetMask>0x10101</resetMask>
              <fields>
                <field>
                  <name>CORE_MASK</name>
                  <description>Mask for corresponding field in INTR register.</description>
                  <bitRange>[0:0]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>DBI_TE_MASK</name>
                  <description>Mask for corresponding field in INTR register.</description>
                  <bitRange>[8:8]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>DPI_HALT_MASK</name>
                  <description>Mask for corresponding field in INTR register.</description>
                  <bitRange>[16:16]</bitRange>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>INTR_MASKED</name>
              <description>Interrupt masked bits.</description>
              <addressOffset>0x1C</addressOffset>
              <size>32</size>
              <access>read-only</access>
              <resetValue>0x0</resetValue>
              <resetMask>0x10101</resetMask>
              <fields>
                <field>
                  <name>CORE_MASKED</name>
                  <description>Logical AND of corresponding INTR and INTR_MASK fields.</description>
                  <bitRange>[0:0]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>DBI_TE_MASKED</name>
                  <description>Logical AND of corresponding INTR and INTR_MASK fields.</description>
                  <bitRange>[8:8]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>DPI_HALT_MASKED</name>
                  <description>Logical AND of corresponding INTR and INTR_MASK fields.</description>
                  <bitRange>[16:16]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>DPI_CMD</name>
              <description>DPI command control.</description>
              <addressOffset>0x20</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x0</resetValue>
              <resetMask>0x101</resetMask>
              <fields>
                <field>
                  <name>DPI_SHUTDOWN</name>
                  <description>Turns on/off the shutdown mode of a MIPI-DSI display in DPI mode. The bit is sampled with the next vertical synchronization pulse, so the video timing of the Display Controller must be active for at least one more frame. Polarity depends on the Host Controller configuration.</description>
                  <bitRange>[0:0]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>DPI_COLORMODE</name>
                  <description>Turns on/off the color reduction mode of a MIPI-DSI display in DPI mode. The bit is sampled with the next vertical synchronization pulse, so the video timing of the Display Controller must be active for at least one more frame. Polarity depends on the Host Controller configuration.</description>
                  <bitRange>[8:8]</bitRange>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>DBI_CMD</name>
              <description>DBI command control.</description>
              <addressOffset>0x24</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x1</resetValue>
              <resetMask>0x1</resetMask>
              <fields>
                <field>
                  <name>DBI_RESET</name>
                  <description>Turns on/off the reset signal for a MIPI-DSI display in DBI mode (low active). The value must only be changed while no DBI command transmission is on-going.</description>
                  <bitRange>[0:0]</bitRange>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>PHY_FREQ_RANGE</name>
              <description>PHY frequency range selection.</description>
              <addressOffset>0x30</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x4C</resetValue>
              <resetMask>0x7FFF</resetMask>
              <fields>
                <field>
                  <name>CFG_CLK_FREQ_RANGE</name>
                  <description>System clock frequency configuration preset. Should be set
according to the following equation:
cfgclkfreqrange[7:0] = round[(Fcfg_clk(MHz)-17)*4].</description>
                  <bitRange>[7:0]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>HS_FREQ_RANGE</name>
                  <description>High-speed Frequency Range Selection.
This signal should be set with the D-PHY in power-down and must
not change during operation.
This signal can be overridden through D-PHY test control registers.</description>
                  <bitRange>[14:8]</bitRange>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>BIST</name>
              <description>BIST control.</description>
              <addressOffset>0x34</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x4</resetValue>
              <resetMask>0x7</resetMask>
              <fields>
                <field>
                  <name>ON</name>
                  <description>Start/stop for the BIST operation. Assert value '1' to start.</description>
                  <bitRange>[0:0]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>DONE</name>
                  <description>Indicates running status. Value '1' Indicates BIST operation is completed.</description>
                  <bitRange>[1:1]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>OK</name>
                  <description>Indicates the result status. '1' indicates BIST is successful and '0' indicates failure.</description>
                  <bitRange>[2:2]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>IO_CONTINUITY_TEST</name>
              <description>IO continuity test control.</description>
              <addressOffset>0x38</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x0</resetValue>
              <resetMask>0xFF</resetMask>
              <fields>
                <field>
                  <name>EN</name>
                  <description>Start/stop for IO continuity test. Assert value '1' to start.</description>
                  <bitRange>[0:0]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>DATA</name>
                  <description>Data to observe</description>
                  <bitRange>[7:1]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>PLL_TEST_CONFIG1</name>
              <description>PLL-SoC interface configuration for Test.</description>
              <addressOffset>0x3C</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x0</resetValue>
              <resetMask>0x7FFFFFF</resetMask>
              <fields>
                <field>
                  <name>VCO_CNTRL</name>
                  <description>VCO Internal Capacitance Control
This signal can be overridden through D-PHY test control registers.</description>
                  <bitRange>[5:0]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>PROP_CNTRL</name>
                  <description>Proportional Charge Pump control
This signal can be overridden through D-PHY test control registers</description>
                  <bitRange>[11:6]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>INT_CNTRL</name>
                  <description>Integral charge pump current control
This signal can be overridden through D-PHY test control registers.</description>
                  <bitRange>[17:12]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>GMP_CNTRL</name>
                  <description>Control of the effective loop-filter resistance
This signal can be overridden through D-PHY test control registers.</description>
                  <bitRange>[19:18]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>CPBIAS_CNTRL</name>
                  <description>Charge pump bias control
This signal can be overridden through D-PHY test control registers.</description>
                  <bitRange>[26:20]</bitRange>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>PLL_TEST_CONFIG2</name>
              <description>PLL-SoC interface configuration for Test.</description>
              <addressOffset>0x40</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0xB10000</resetValue>
              <resetMask>0xFFFFFF</resetMask>
              <fields>
                <field>
                  <name>GP_CLK_EN</name>
                  <description>Enable signal for clkout_gp clock</description>
                  <bitRange>[0:0]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>LOCK_PLL</name>
                  <description>Lock State Signaling.
0: PLL is not locked
1: PLL is locked</description>
                  <bitRange>[1:1]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>PLL_N</name>
                  <description>Control of the Input Frequency Division Ratio N
This signal can be overridden through D-PHY test control registers.</description>
                  <bitRange>[5:2]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>PLL_M</name>
                  <description>Control of the Feedback Multiplication Ratio M
This signal can be overridden through D-PHY test control registers.</description>
                  <bitRange>[15:6]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>CLKSEL</name>
                  <description>Control of PLL clock output selection.
00 - Clocks stopped
01 - Clock generation
10 - Buffered clkext
11 - Forbidden</description>
                  <bitRange>[17:16]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>UPDATEPLL</name>
                  <description>Control for PLL operation frequency updated.
When exercised, PLL SoC control signals are latched to PLL
shadow_registers to set PLL operating frequency.</description>
                  <bitRange>[18:18]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>FORCE_LOCK</name>
                  <description>Force lock bit:
0 - according to lock detector-default
1 - lock indication forced</description>
                  <bitRange>[19:19]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>PLL_SHADOW_CONTROL</name>
                  <description>Selection of PLL configuration mechanism. PLL can be configured
through D-PHY or through SoC control and shadow control registers:
0: SoC control and shadow registers
1: D-PHY test control register</description>
                  <bitRange>[20:20]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>SHADOW_CLEAR</name>
                  <description>Set to '1' to clear shadow registers.</description>
                  <bitRange>[21:21]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>TEST_STOP_CLK_EN</name>
                  <description>Stop clock signal for scan dump support.</description>
                  <bitRange>[22:22]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>WAKEUPPLL</name>
                  <description>Wakeuppll signal should be set to 1'b1 during entire operation except
when used as part of a relock procedure.
This signal has override capability over the PLL boot FSM and allows
to trigger a new relock sequence in the system. It is set to 1'b1 during
normal operation and pulsed low during at least 1uS during relock
sequence (to trigger a new PLL relock).</description>
                  <bitRange>[23:23]</bitRange>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>PLL_TEST_OBS1</name>
              <description>PLL Test Observation bits.</description>
              <addressOffset>0x44</addressOffset>
              <size>32</size>
              <access>read-only</access>
              <resetValue>0x0</resetValue>
              <resetMask>0x7FFFFFF</resetMask>
              <fields>
                <field>
                  <name>VCO_CNTRL_OBS</name>
                  <description>Output of multiplexer controlled by pll_shadow_control signal.
This output signal represents the control signal provided by PHY test control registers or SoC control depending on pll_shadow_control selection. Used for SOC observability of the vco_cntrl_obs that is controlling the PLL</description>
                  <bitRange>[5:0]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>PROP_CNTRL_OBS</name>
                  <description>Used for SOC observability of the prop_cntrl_obs that is controlling the PLL.</description>
                  <bitRange>[11:6]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>INT_CNTRL_OBS</name>
                  <description>Used for SOC observability of the int_cntrl_obs that is controlling the PLL.</description>
                  <bitRange>[17:12]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>GMP_CNTRL_OBS</name>
                  <description>Used for SOC observability of the gmp_cntrl_obs that is
controlling the PLL.</description>
                  <bitRange>[19:18]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>CPBIAS_CNTRL_OBS</name>
                  <description>Used for SOC observability of the cpbias_cntrl_obs that is
controlling the PLL.</description>
                  <bitRange>[26:20]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>PLL_TEST_OBS2</name>
              <description>PLL Test Observation bits.</description>
              <addressOffset>0x48</addressOffset>
              <size>32</size>
              <access>read-only</access>
              <resetValue>0x4000</resetValue>
              <resetMask>0x7FFF</resetMask>
              <fields>
                <field>
                  <name>PLL_N_OBS</name>
                  <description>Output of multiplexer controlled by pll_shadow_control signal.
This output signal represents the control signal provided by PHY test control registers or SoC control depending on pll_shadow_control selection. Used for SOC observability of the n_obs that is controlling the PLL.</description>
                  <bitRange>[3:0]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>PLL_M_OBS</name>
                  <description>Used for SOC observability of the m_obs that is controlling the PLL.</description>
                  <bitRange>[13:4]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>PLL_SHADOW_CONTROL_OBS</name>
                  <description>Used for SOC observability of the pll_shadow_control_obs that is controlling the PLL</description>
                  <bitRange>[14:14]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>LP_INTERNAL_LOOPBACK_TEST</name>
              <description>Low Power internal Loopback Test</description>
              <addressOffset>0x4C</addressOffset>
              <size>32</size>
              <access>read-only</access>
              <resetValue>0x0</resetValue>
              <resetMask>0x1FFF</resetMask>
              <fields>
                <field>
                  <name>RXDATAESC_VALID</name>
                  <description>Indicate that rxdatasec field is valid. SW can poll this bit before reading the rxdatasec field</description>
                  <bitRange>[0:0]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>RXDATAESC</name>
                  <description>Received low power internal loopback data on rxdataesc. The SW can configure the Generic interface to send short packet with payload size of 2 bytes and the first byte sent would appear on this field, if received successfully.</description>
                  <bitRange>[8:1]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>RXTRIGGERESC</name>
                  <description>Received low power internal loopback data on rxtriggeresc. The TX data can be sent by writing to PHY_TX_TRIGGERS register (one hot encoded)</description>
                  <bitRange>[12:9]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
          </cluster>
          <cluster>
            <name>DWCMIPIDSI</name>
            <description>DSI Registers</description>
            <headerStructName>GFXSS_MIPIDSI_DWCMIPIDSI</headerStructName>
            <addressOffset>0x00001000</addressOffset>
            <register>
              <name>VERSION</name>
              <description>Contains the version of the DSI host controller.</description>
              <addressOffset>0x0</addressOffset>
              <size>32</size>
              <access>read-only</access>
              <resetValue>0x30313531</resetValue>
              <resetMask>0xFFFFFFFF</resetMask>
              <fields>
                <field>
                  <name>VERSION_VERSION</name>
                  <description>This field indicates the version of the DWC_mipi_dsi_host.</description>
                  <bitRange>[31:0]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>PWR_UP</name>
              <description>Controls the power up of the controller.</description>
              <addressOffset>0x4</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x0</resetValue>
              <resetMask>0xFFFFFFFF</resetMask>
              <fields>
                <field>
                  <name>PWR_UP_SHUTDOWNZ</name>
                  <description>This bit configures the controller either to power up or to reset.</description>
                  <bitRange>[0:0]</bitRange>
                  <access>read-write</access>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>POWERUP</name>
                      <description>(none)</description>
                      <value>1</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>RESET</name>
                      <description>(none)</description>
                      <value>0</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>PWR_UP_RSVD_31_1</name>
                  <description>N/A</description>
                  <bitRange>[31:1]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>CLKMGR_CFG</name>
              <description>Configures the factor for internal dividers to divide lanebyteclk for timeout purposes.</description>
              <addressOffset>0x8</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x0</resetValue>
              <resetMask>0xFFFFFFFF</resetMask>
              <fields>
                <field>
                  <name>CLKMGR_CFG_TX_ESC_CLK_DIVISION</name>
                  <description>This field indicates the division factor for the TX Escape clock source (lanebyteclk). The values 0 and 1 stop the TX_ESC clock generation.</description>
                  <bitRange>[7:0]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>CLKMGR_CFG_TO_CLK_DIVISION</name>
                  <description>This field indicates the division factor for the Time Out clock used as the timing unit in the configuration of high-speed to low-power and low-power to high-speed transition error.</description>
                  <bitRange>[15:8]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>CLKMGR_CFG_RSVD_31_16</name>
                  <description>N/A</description>
                  <bitRange>[31:16]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>DPI_VCID</name>
              <description>Configures the Virtual Channel ID for DPI traffic.</description>
              <addressOffset>0xC</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x0</resetValue>
              <resetMask>0xFFFFFFFF</resetMask>
              <fields>
                <field>
                  <name>DPI_VCID_DPI_VCID</name>
                  <description>This field configures the DPI virtual channel id that is indexed to the Video mode packets.</description>
                  <bitRange>[1:0]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>DPI_VCID_RSVD_31_2</name>
                  <description>N/A</description>
                  <bitRange>[31:2]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
