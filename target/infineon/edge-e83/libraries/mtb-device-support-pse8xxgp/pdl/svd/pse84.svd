          <fields>
            <field>
              <name>ACTIVATIONSTREAMERSTARTROW</name>
              <description>Signed start row to move kernel window over the activation map (col=0 &amp; row=0 hits baseaddr)   programmable:configurable only when IP is enabled by SL_CTL bit. Do not update while a layer computation is active (BUSY_STATUS='1')! Updating during BUSY_STATUS='1' will cause unpredictable behavior.</description>
              <bitRange>[17:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ACTIVATIONSTREAMERCHANNELTIMESWIDTH</name>
          <description>N/A</description>
          <addressOffset>0x30</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0x1FFFF</resetMask>
          <fields>
            <field>
              <name>ACTIVATIONSTREAMERCHANNELTIMESWIDTH</name>
              <description>Unsigned number of elements in activation map per channel * width   programmable:configurable only when IP is enabled by SL_CTL bit. Do not update while a layer computation is active (BUSY_STATUS='1')! Updating during BUSY_STATUS='1' will cause unpredictable behavior.</description>
              <bitRange>[16:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ACTIVATIONSTREAMERHEIGHT</name>
          <description>N/A</description>
          <addressOffset>0x34</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0x1FFFF</resetMask>
          <fields>
            <field>
              <name>ACTIVATIONSTREAMERHEIGHT</name>
              <description>Unsigned number of elements in height in activation map till end of loop   programmable:configurable only when IP is enabled by SL_CTL bit. Do not update while a layer computation is active (BUSY_STATUS='1')! Updating during BUSY_STATUS='1' will cause unpredictable behavior.</description>
              <bitRange>[16:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ACTIVATIONSTREAMERPADDING</name>
          <description>N/A</description>
          <addressOffset>0x38</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFF</resetMask>
          <fields>
            <field>
              <name>ACTIVATIONSTREAMERPADVALUE</name>
              <description>Defines signed values out of activation map   programmable:configurable only when IP is enabled by SL_CTL bit. Do not update while a layer computation is active (BUSY_STATUS='1')! Updating during BUSY_STATUS='1' will cause unpredictable behavior.</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ACTIVATIONSTREAMERSPARSITYMAPBASEADDR</name>
          <description>N/A</description>
          <addressOffset>0x3C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>ACTIVATIONSTREAMERSPARSITYMAPBASEADDR</name>
              <description>Byte addresses, defines the address of start of sparsity bit(map) for sparse footprint fetch   programmable:configurable only when IP is enabled by SL_CTL bit. Do not update while a layer computation is active (BUSY_STATUS='1')! Updating during BUSY_STATUS='1' will cause unpredictable behavior.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>OUTSTREAMERBASEADDR</name>
          <description>N/A</description>
          <addressOffset>0x40</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>OUTSTREAMERBASEADDR</name>
              <description>Byte addresses, defines the address of the first dataset (first row, first col)   programmable:configurable only when IP is enabled by SL_CTL bit. Do not update while a layer computation is active (BUSY_STATUS='1')! Updating during BUSY_STATUS='1' will cause unpredictable behavior.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>OUTSTREAMEROUTPUTOFFSET</name>
          <description>N/A</description>
          <addressOffset>0x44</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0x1FFFF</resetMask>
          <fields>
            <field>
              <name>OUTSTREAMEROUTPUTOFFSET</name>
              <description>Signed offset added to the output activation. The outstreamer supports 8-bit output neuron. The configuration range is [-256, 255]    programmable:configurable only when IP is enabled by SL_CTL bit. Do not update while a layer computation is active (BUSY_STATUS='1')! Updating during BUSY_STATUS='1' will cause unpredictable behavior.</description>
              <bitRange>[16:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>OUTSTREAMERCLIPPING</name>
          <description>N/A</description>
          <addressOffset>0x48</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x7FFF8000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>OUTSTREAMERCLIPPINGVALUEMIN</name>
              <description>The minimum value (signed) to clip to [Default is 0x8000] programmable:configurable only when IP is enabled by SL_CTL bit. Do not update while a layer computation is active (BUSY_STATUS='1')! Updating during BUSY_STATUS='1' will cause unpredictable behavior.</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>OUTSTREAMERCLIPPINGVALUEMAX</name>
              <description>The maximum value (signed) to clip to, [Default is 0x7FFF] programmable:configurable only when IP is enabled by SL_CTL bit. Do not update while a layer computation is active (BUSY_STATUS='1')! Updating during BUSY_STATUS='1' will cause unpredictable behavior.</description>
              <bitRange>[31:16]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>INTERPOLATIONLUTDATA0</name>
          <description>N/A</description>
          <addressOffset>0x4C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x3F800000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>INTERPOLATIONLUTDATA0</name>
              <description>Scales the output of activation function by scaling factor a IEEE-754 single precision value [Default is set to 0x3f800000 -&gt; 1.0] (multi-purpose output post-scaling factor. note: used only for positive outputs in piece-wise linear activation function). Name is kept from mxnnlite.1, the register has nothing to do with LUT. programmable:configurable only when IP is enabled by SL_CTL bit. Do not update while a layer computation is active (BUSY_STATUS='1')! Updating during BUSY_STATUS='1' will cause unpredictable behavior.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>INTERPOLATIONLUTDATA1</name>
          <description>N/A</description>
          <addressOffset>0x50</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x3F800000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>INTERPOLATIONLUTDATA1</name>
              <description>Scales the output of activation function by scaling factor a IEEE-754 single precision value [Default is set to 0x3f800000 -&gt; 1.0] (used only for scaling negative outputs, only needed for piece-wise linear activation function). Name is kept from mxnnlite.1, the register has nothing to do with LUT.  programmable:configurable only when IP is enabled by SL_CTL bit. Do not update while a layer computation is active (BUSY_STATUS='1')! Updating during BUSY_STATUS='1' will cause unpredictable behavior.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>BIASBASEADDR</name>
          <description>N/A</description>
          <addressOffset>0x54</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>BIASBASEADDR</name>
              <description>Word aligned addresses, defines the address of the bias. Bias is 32 bits.   programmable:configurable only when IP is enabled by SL_CTL bit. Do not update while a layer computation is active (BUSY_STATUS='1')! Updating during BUSY_STATUS='1' will cause unpredictable behavior.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SCALINGFACTORBASEADDR</name>
          <description>N/A</description>
          <addressOffset>0x58</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>SCALINGFACTORBASEADDR</name>
              <description>Word aligned addresses, defines the address of the scaling factor. Scaling factor is 32 bits.   programmable:configurable only when IP is enabled by SL_CTL bit. Do not update while a layer computation is active (BUSY_STATUS='1')! Updating during BUSY_STATUS='1' will cause unpredictable behavior.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>NONZEROWEIGHTSPOINTER</name>
          <description>Memory address, which stores the number of the non-zero weights</description>
          <addressOffset>0x5C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>NONZEROWEIGHTSPOINTER</name>
              <description>Memory address, which stores the number of the non-zero weights. It is half-word aligned. The non-zero weights size is 16 bits.   programmable:configurable only when IP is enabled by SL_CTL bit. Do not update while a layer computation is active (BUSY_STATUS='1')! Updating during BUSY_STATUS='1' will cause unpredictable behavior.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>INPUTRESCALINGFACTOR</name>
          <description>Floating point value (IEEE-754 single precision) which scales the activation/weight input</description>
          <addressOffset>0x60</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x3F800000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>INPUTRESCALINGFACTOR</name>
              <description>Floating point value (IEEE-754 single precision) which scales the activation/weight input (when NNLAYER_CTL.INPUT_RESCALE configured) Default value: 0x3f800000 (1.0).   programmable:configurable only when IP is enabled by SL_CTL bit. Do not update while a layer computation is active (BUSY_STATUS='1')! Updating during BUSY_STATUS='1' will cause unpredictable behavior.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>OUTPUTCHANNELS</name>
          <description>Unsigned number of output channels for depthwise operations</description>
          <addressOffset>0x64</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0x1FFFF</resetMask>
          <fields>
            <field>
              <name>OUTPUTCHANNELS</name>
              <description>Unsigned number of output channels for depthwise operations  programmable:configurable only when IP is enabled by SL_CTL bit. Do not update while a layer computation is active (BUSY_STATUS='1')! Updating during BUSY_STATUS='1' will cause unpredictable behavior.</description>
              <bitRange>[16:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>OUTPUTWIDTH</name>
          <description>Output width for one layer</description>
          <addressOffset>0x68</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0x1FFFF</resetMask>
          <fields>
            <field>
              <name>OUTPUTWIDTH</name>
              <description>Output width for one layer   programmable:configurable only when IP is enabled by SL_CTL bit. Do not update while a layer computation is active (BUSY_STATUS='1')! Updating during BUSY_STATUS='1' will cause unpredictable behavior.</description>
              <bitRange>[16:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>OUTPUTHEIGHT</name>
          <description>Output height for one layer</description>
          <addressOffset>0x6C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0x1FFFF</resetMask>
          <fields>
            <field>
              <name>OUTPUTHEIGHT</name>
              <description>Output height for one layer   programmable:configurable only when IP is enabled by SL_CTL bit. Do not update while a layer computation is active (BUSY_STATUS='1')! Updating during BUSY_STATUS='1' will cause unpredictable behavior.</description>
              <bitRange>[16:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>STRIDE</name>
          <description>Stride control register</description>
          <addressOffset>0x70</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFF</resetMask>
          <fields>
            <field>
              <name>STRIDECHANNELTIMESCOLUMN</name>
              <description>Stride on channel times columns.    programmable:configurable only when IP is enabled by SL_CTL bit. Do not update while a layer computation is active (BUSY_STATUS='1')! Updating during BUSY_STATUS='1' will cause unpredictable behavior.</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>STRIDEROW</name>
              <description>Stride between rows.   programmable:configurable only when IP is enabled by SL_CTL bit. Do not update while a layer computation is active (BUSY_STATUS='1')! Updating during BUSY_STATUS='1' will cause unpredictable behavior.</description>
              <bitRange>[23:16]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>NNLAYER_CTL</name>
          <description>Configure layer pattern, activation functions, activation size, and weight size (only for DSP algorithms)</description>
          <addressOffset>0x74</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x18800000</resetValue>
          <resetMask>0x1FFFFF83</resetMask>
          <fields>
            <field>
              <name>INPUT_RESCALE</name>
              <description>Rescales the activation or weights by the configured rescaling factor. 0: No Rescaling, 1: Rescale Weights, 2: Rescale Activation. This field is programmable:configurable only when IP is enabled by SL_CTL bit. Do not update while a layer computation is active (BUSY_STATUS='1')! Updating during BUSY_STATUS='1' will cause unpredictable behavior.</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>OPTYPE</name>
              <description>Selects the type of arithmetic/relational operation. 0: No Operation, 1: Multiply&amp;Accumulate, 2: Add&amp;Accumulate, 3: Subtract(Act-Wgt)&amp;Accumulate, 4: Subtract(Wgt-Act)&amp;Accumulate, 5: Sum Activation, 6: Minimum Activation, 7: Maximum Activation, 8: Sum Activation-32 (Special 32-bit inputs, i.e. shifted versions of 16-bit inputs). This field is programmable:configurable only when IP is enabled by SL_CTL bit. Do not update while a layer computation is active (BUSY_STATUS='1')! Updating during BUSY_STATUS='1' will cause unpredictable behavior.</description>
              <bitRange>[10:7]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ACTTYPE</name>
              <description>Selects the type of activation function. 0: No function applied, 1: Sigmoid, 2: Tanh, 3: Piece-Wise Linear, 4: Negative power of 2 (i.e. 2^-x, output format: Q1.31), 5: Reciprocal. This field is programmable:configurable only when IP is enabled by SL_CTL bit. Do not update while a layer computation is active (BUSY_STATUS='1')! Updating during BUSY_STATUS='1' will cause unpredictable behavior.</description>
              <bitRange>[13:11]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>FETCH_MODE</name>
              <description>Determines the data fetching pattern in activation and weight streamers. 0: DW-striped channel activation &amp; weights, 1: Channel-minor activation &amp; weights, 2: DW-striped channel activation only, 3: Channel-minor activation only. This field is programmable:configurable only when IP is enabled by SL_CTL bit. Do not update while a layer computation is active (BUSY_STATUS='1')! Updating during BUSY_STATUS='1' will cause unpredictable behavior.</description>
              <bitRange>[15:14]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>REPEAT_WEIGHTS</name>
              <description>Repeat weights after WeightStreamerKernelChannelTimesHeightTimesWidth fetches. 0: no weight repeating, 1: weight repeating. This field is programmable:configurable only when IP is enabled by SL_CTL bit. Do not update while a layer computation is active (BUSY_STATUS='1')! Updating during BUSY_STATUS='1' will cause unpredictable behavior.</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>SCALEFACTOR_CTL</name>
              <description>Scaling factor control. 0: No scaling, 1: per-tensor, 2: per-axis, 3: per-row. This field is programmable:configurable only when IP is enabled by SL_CTL bit. Do not update while a layer computation is active (BUSY_STATUS='1')! Updating during BUSY_STATUS='1' will cause unpredictable behavior.</description>
              <bitRange>[18:17]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>INPUT_SIZE_CTL</name>
              <description>Select input size. Value 0: 8 bits, value 1: 16 bits   programmable:configurable only when IP is enabled by SL_CTL bit. Do not update while a layer computation is active (BUSY_STATUS='1')! Updating during BUSY_STATUS='1' will cause unpredictable behavior.</description>
              <bitRange>[19:19]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>OUTPUT_SIZE_CTL</name>
              <description>Select output size. Value 0: 8 bits, value 1: 16 bits, value 2: 32 bits.  programmable:configurable only when IP is enabled by SL_CTL bit. Do not update while a layer computation is active (BUSY_STATUS='1')! Updating during BUSY_STATUS='1' will cause unpredictable behavior.</description>
              <bitRange>[21:20]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WEIGHT_SIZE_CTL</name>
              <description>Select weight size (set only for DSP algorithms). Value 0: 8 bits, value 1: 16 bits   programmable:configurable only when IP is enabled by SL_CTL bit. Do not update while a layer computation is active (BUSY_STATUS='1')! Updating during BUSY_STATUS='1' will cause unpredictable behavior.</description>
              <bitRange>[22:22]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>BIAS_EN</name>
              <description>Enable bias fetching from the memory.  programmable:configurable only when IP is enabled by SL_CTL bit. Do not update while a layer computation is active (BUSY_STATUS='1')! Updating during BUSY_STATUS='1' will cause unpredictable behavior.</description>
              <bitRange>[23:23]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>SPARSE_EN</name>
              <description>Enable sparse footprint fetch - fetch only footprint values for which corresponding sparsity bitmap bit is set (left-to-right, top-bottom order).     programmable:configurable only when IP is enabled by SL_CTL bit. Do not update while a layer computation is active (BUSY_STATUS='1')! Updating during BUSY_STATUS='1' will cause unpredictable behavior.</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CHUNK_EN</name>
              <description>Enable output writing in chunks. Chunk length and chunk stride is defined in OutstreamerChunk register. This field is not functional in mxnnlite.2 (programming it will not have any effect). programmable:configurable only when IP is enabled by SL_CTL bit. Do not update while a layer computation is active (BUSY_STATUS='1')! Updating during BUSY_STATUS='1' will cause unpredictable behavior.</description>
              <bitRange>[25:25]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>FFT_EN</name>
              <description>Enable 16-bit (Q1.15) real input FFT. Value 0: Disable, Value 1: Enable.     programmable:configurable only when IP is enabled by SL_CTL bit. Do not update while a layer computation is active (BUSY_STATUS='1')! Updating during BUSY_STATUS='1' will cause unpredictable behavior.</description>
              <bitRange>[26:26]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WPREFETCH_LEN</name>
              <description>Length of weight prefetches (each 128-bits). Value 0: 1x128 prefetch, Value 1: 2x128 prefetches, Value 2: 3x128 prefetches, Value 3: 4x128 prefetches. Default value : 3.     programmable:configurable only when IP is enabled by SL_CTL bit. Do not update while a layer computation is active (BUSY_STATUS='1')! Updating during BUSY_STATUS='1' will cause unpredictable behavior.</description>
              <bitRange>[28:27]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>INTR</name>
          <description>Interrupt cause and clear register</description>
          <addressOffset>0x78</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0x3FF</resetMask>
          <fields>
            <field>
              <name>INTR_DONE</name>
              <description>Once accelerator calculation for one layer is done, interrupt is caused   programmable:configurable only when IP is enabled by SL_CTL bit. Clear the interrupt cause bit. Same programmable for other bitfields</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>INTR_MEM_ERR_SPARSITY</name>
              <description>Accessing sparsity from memory causes error</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>INTR_MEM_ERR_ACTIVATIONSTREAMER</name>
              <description>Accessing activation from memory causes error</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>INTR_MEM_ERR_WEIGHTSTREAMER</name>
              <description>Accessing weight from memory causes error</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>INTR_MEM_ERR_BIASSTREAMER</name>
              <description>Accessing bias from memory causes error</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>INTR_MEM_ERR_OUTPUTSTREAMER</name>
              <description>Writing output to memory causes error</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>INTR_ACCUMULATION_SATURATION</name>
              <description>Accumulation saturation causes interrupt</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>INTR_INPUT_PRESCALE_SATURATION</name>
              <description>Scaling factor exponent saturation (input rescaler) causes interrupt</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>INTR_OUTPUT_PRESCALE_SATURATION</name>
              <description>Scaling factor exponent saturation (output prerescaler) causes interrupt</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>INTR_OUTPUT_POSTSCALE_SATURATION</name>
              <description>Scaling factor exponent saturation (output postscaler) causes interrupt</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>INTR_MASK</name>
          <description>Interrupt mask register. A co-located interrupt cause bit will only cause an interrupt when its mask bit is 1</description>
          <addressOffset>0x7C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0x3FF</resetMask>
          <fields>
            <field>
              <name>INTR_MASK_DONE</name>
              <description>Mask bit for calculation done for one layer to cause interrupt  programmable:configurable only when IP is enabled by SL_CTL bit. Do not update while a layer computation is active (BUSY_STATUS='1')! Updating during BUSY_STATUS='1' will cause unpredictable behavior. Same programmable for other bitfields</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>INTR_MASK_MEM_ERR_SPARSITY</name>
              <description>Mask bit for accessing sparsity error</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>INTR_MASK_MEM_ERR_ACTIVATIONSTREAMER</name>
              <description>Mask bit for accessing activation error</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>INTR_MASK_MEM_ERR_WEIGHTSTREAMER</name>
              <description>Mask bit for accessing weight error</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>INTR_MASK_MEM_ERR_BIASSTREAMER</name>
              <description>Mask bit for accessing bias error</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>INTR_MASK_MEM_ERR_OUTPUTSTREAMER</name>
              <description>Mask bit for writing output error</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>INTR_MASK_ACCUMULATION_SATURATION</name>
              <description>Mask bit for accumulation saturation interrupt</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>INTR_MASK_INPUT_PRESCALE_SATURATION</name>
              <description>Mask bit for scaling factor saturation (input rescaler) interrupt</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>INTR_MASK_OUTPUT_PRESCALE_SATURATION</name>
              <description>Mask bit for scaling factor saturation (output prescaler) interrupt</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>INTR_MASK_OUTPUT_POSTSCALE_SATURATION</name>
              <description>Mask bit for scaling factor saturation (output postscaler) interrupt</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>TRIG_MASK</name>
          <description>Trigger mask register. Calculation done for one layer triggers DataWire when its mask bit is 1</description>
          <addressOffset>0x80</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0x1</resetMask>
          <fields>
            <field>
              <name>TRIG_MASK_DONE</name>
              <description>Mask bit for calculation done for one layer to trigger DataWire   programmable:configurable only when IP is enabled by SL_CTL bit. Do not update while a layer computation is active (BUSY_STATUS='1')! Updating during BUSY_STATUS='1' will cause unpredictable behavior.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CMD</name>
          <description>Command register</description>
          <addressOffset>0x84</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0x3</resetMask>
          <fields>
            <field>
              <name>START_CMD</name>
              <description>Generate start pulse for the accelerator   programmable:configurable only when IP is enabled by SL_CTL bit. Do not update while a layer computation is active (BUSY_STATUS='1')! Updating during BUSY_STATUS='1' will cause unpredictable behavior.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ABORT_CMD</name>
              <description>Set abort to reset all the registers   programmable:configurable only when IP is enabled by SL_CTL bit.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>INTR_SET</name>
          <description>Set INTR_XXX register by software for debug purpose</description>
          <addressOffset>0x88</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0x3FF</resetMask>
          <fields>
            <field>
              <name>INTR_SET_DONE</name>
              <description>Set calculation done for one layer    programmable:configurable only when IP is enabled by SL_CTL bit. Provides the capability to set a specific interrupt cause bit in INTR_XXX for debug purposes. Same programmable for other bitfields</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>INTR_SET_MEM_ERR_SPARSITY</name>
              <description>Set accessing sparsity error</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>INTR_SET_MEM_ERR_ACTIVATIONSTREAMER</name>
              <description>Set accessing activation error</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>INTR_SET_MEM_ERR_WEIGHTSTREAMER</name>
              <description>Set accessing weight error</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>INTR_SET_MEM_ERR_BIASSTREAMER</name>
              <description>Set accessing bias error</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>INTR_SET_MEM_ERR_OUTPUTSTREAMER</name>
              <description>Set writing output error</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>INTR_SET_ACCUMULATION_SATURATION</name>
              <description>Set accumulation saturation interrupt</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>INTR_SET_INPUT_PRESCALE_SATURATION</name>
              <description>Set scaling factor saturation (input rescaler) interrupt</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>INTR_SET_OUTPUT_PRESCALE_SATURATION</name>
              <description>Set scaling factor saturation (output prerescaler) interrupt</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>INTR_SET_OUTPUT_POSTSCALE_SATURATION</name>
              <description>Set scaling factor saturation (output postscaler) interrupt</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>INTR_MASKED</name>
          <description>Virtual register for generating the interrupt signal to MCU. It is the logical AND of the INTR_XXX and INTR_MASK_XXX register</description>
          <addressOffset>0x8C</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <resetMask>0x3FF</resetMask>
          <fields>
            <field>
              <name>INTR_MASKED_DONE</name>
              <description>Masked interrupt for calculation done for one layer</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>INTR_MASKED_MEM_ERR_SPARSITY</name>
              <description>Masked interrupt for accessing sparsity error</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>INTR_MASKED_MEM_ERR_ACTIVATIONSTREAMER</name>
              <description>Masked interrupt for accessing activation error</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>INTR_MASKED_MEM_ERR_WEIGHTSTREAMER</name>
              <description>Masked interrupt for accessing weight error</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>INTR_MASKED_MEM_ERR_BIASSTREAMER</name>
              <description>Masked interrupt for accessing bias error</description>
              <bitRange>[4:4]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>INTR_MASKED_MEM_ERR_OUTPUTSTREAMER</name>
              <description>Masked interrupt for writing output error</description>
              <bitRange>[5:5]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>INTR_MASKED_ACCUMULATION_SATURATION</name>
              <description>Masked interrupt for accumulation saturation</description>
              <bitRange>[6:6]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>INTR_MASKED_INPUT_PRESCALE_SATURATION</name>
              <description>Masked interrupt for scaling factor (input rescaler) saturation</description>
              <bitRange>[7:7]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>INTR_MASKED_OUTPUT_PRESCALE_SATURATION</name>
              <description>Masked interrupt for scaling factor (output prescaler) saturation</description>
              <bitRange>[8:8]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>INTR_MASKED_OUTPUT_POSTSCALE_SATURATION</name>
              <description>Masked interrupt for scaling factor (output postscaler) saturation</description>
              <bitRange>[9:9]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>STATUS</name>
          <description>Status register</description>
          <addressOffset>0x90</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <resetMask>0x3</resetMask>
          <fields>
            <field>
              <name>BUSY_STATUS</name>
              <description>Indicate IP is processing. Will be high after writing START_CMD='1' until layer computation is complete or abort process is complete.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>ACTIVATIONSTREAMERDONE</name>
              <description>Indicates when last element of repeated fetch delivered</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>CTBL0</name>
      <description>Continuous Time Block Lite</description>
      <headerStructName>CTBL</headerStructName>
      <baseAddress>0x42E00000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>65536</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <cluster>
          <name>STA</name>
          <description>CTBL static configuration</description>
          <addressOffset>0x00000400</addressOffset>
          <register>
            <name>CFG</name>
            <description>Configuration (only accessible if ACTRLR.STATUS.MODE=0)</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>OA0_PWR_MODE</name>
                <description>Opamp0 power level</description>
                <bitRange>[3:0]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>OFF</name>
                    <description>Off</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ULTRA_LOW</name>
                    <description>If CTBL_DYN_CFG_STRUCT.OA_MUX_CFG.OA_TO_PIN=0: opamp quiscent current of 15uA, input common mode of 0.2V to VDDA-1V, gain bandwidth of 30kHz.

If CTBL_DYN_CFG_STRUCT.OA_MUX_CFG.OA_TO_PIN=1: opamp quiscent current of 15uA, input common mode of 0.2V to VDDA-1V, gain bandwidth of 100kHz, 10uA output drive capability.</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ULTRA_LOW_RAIL</name>
                    <description>If CTBL_DYN_CFG_STRUCT.OA_MUX_CFG.OA_TO_PIN=0: opamp quiscent current of 35uA, input common mode of 0.2V to VDDA-0.2V, gain bandwidth of 30kHz.

If CTBL_DYN_CFG_STRUCT.OA_MUX_CFG.OA_TO_PIN=1: opamp quiscent current of 35uA, input common mode of 0.2V to VDDA-0.2V, gain bandwidth of 100kHz, 10uA output drive capability.</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LOW</name>
                    <description>Do Not Use</description>
                    <value>3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LOW_RAIL</name>
                    <description>If CTBL_DYN_CFG_STRUCT.OA_MUX_CFG.OA_TO_PIN=0: opamp quiscent current of 150uA, input common mode of 0.2V to VDDA-0.2V, gain bandwidth of 350kHz.

If CTBL_DYN_CFG_STRUCT.OA_MUX_CFG.OA_TO_PIN=1: opamp quiscent current of 150uA, input common mode of 0.2V to VDDA-0.2V, gain bandwidth of 1.2MHz, 100uA output drive capability.</description>
                    <value>4</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>MEDIUM</name>
                    <description>Do Not Use</description>
                    <value>5</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>MEDIUM_RAIL</name>
                    <description>If CTBL_DYN_CFG_STRUCT.OA_MUX_CFG.OA_TO_PIN=0: opamp quiscent current of 200uA, input common mode of 0.2V to VDDA-0.2V, gain bandwidth of 700kHz.

If CTBL_DYN_CFG_STRUCT.OA_MUX_CFG.OA_TO_PIN=1: opamp quiscent current of 200uA, input common mode of 0.2V to VDDA-0.2V, gain bandwidth of 2.4MHz, 1mA output drive capability.</description>
                    <value>6</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HIGH</name>
                    <description>Do Not Use</description>
                    <value>7</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HIGH_RAIL</name>
                    <description>If CTBL_DYN_CFG_STRUCT.OA_MUX_CFG.OA_TO_PIN=0: opamp quiscent current of 600uA, input common mode of 0.2V to VDDA-0.2V, gain bandwidth of 1.75MHz.

If CTBL_DYN_CFG_STRUCT.OA_MUX_CFG.OA_TO_PIN=1: opamp quiscent current of 600uA, input common mode of 0.2V to VDDA-0.2V, gain bandwidth of 6MHz,1mA output drive capability.</description>
                    <value>8</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ULTRA_HIGH</name>
                    <description>Do Not Use</description>
                    <value>9</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ULTRA_HIGH_RAIL</name>
                    <description>If CTBL_DYN_CFG_STRUCT.OA_MUX_CFG.OA_TO_PIN=0: opamp quiscent current of 800uA, input common mode of 0.2V to VDDA-0.2V, gain bandwidth of 2.8MHz.

If CTBL_DYN_CFG_STRUCT.OA_MUX_CFG.OA_TO_PIN=1: opamp quiscent current of 800uA, input common mode of 0.2V to VDDA-0.2V, gain bandwidth of 7.5MHz, 10mA output drive capability.</description>
                    <value>10</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RSVD_0</name>
                    <description>N/A</description>
                    <value>11</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RSVD_1</name>
                    <description>N/A</description>
                    <value>12</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RSVD_2</name>
                    <description>N/A</description>
                    <value>13</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RSVD_3</name>
                    <description>N/A</description>
                    <value>14</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RSVD_4</name>
                    <description>N/A</description>
                    <value>15</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>OA0_TOPO</name>
                <description>N/A</description>
                <bitRange>[7:4]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>OA0_COMP_OUT</name>
                <description>6= Buffer</description>
                <bitRange>[9:8]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DISABLE</name>
                    <description>Disabled, no interrupts will be detected</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RISING</name>
                    <description>Rising edge</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>FALLING</name>
                    <description>Falling edge</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>BOTH</name>
                    <description>Both rising and falling edges</description>
                    <value>3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>RES0_SWAP</name>
                <description>N/A</description>
                <bitRange>[10:10]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>OA0_CC_ENABLE</name>
                <description>Opamp0 miller compensation capacitor enable</description>
                <bitRange>[11:11]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DISABLE</name>
                    <description>Opamp0 contains no miller compensation capactior.</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ENABLE</name>
                    <description>The compensation capacitor value is determined by CTBL_TRIM_STRUCT.OA0_COMP_TRIM.OA0_COMP_TRIM</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>C0_FB</name>
                <description>Feed back Cap value select

This field is only used if OA0_TOPO is set to 1, 2, or 4 and the Opamp Gain (set by the AC) is set to a non-unity value.

The feedback capacitor is used to compensate the resistive feedback network.  Values range from 0pF to 10.5pF in 0.7pF increments.

0000: 0pF
0001: 0.7pF
0010: 1.4pF
0011: 2.1pF
0100: 2.8pF
0101: 3.5pF
0110: 4.2pF
0111: 4.9pF
1000: 5.6pF
1001: 6.3pF
1010: 7.0pF
1011: 7.7pF
1100: 8.4pF
1101: 9.1pF
1110: 9.8pF
1111: 10.5pF</description>
                <bitRange>[15:12]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>OA1_PWR_MODE</name>
                <description>Opamp1 power level: see description of OA0_PWR_MODE</description>
                <bitRange>[19:16]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>OA1_TOPO</name>
                <description>OA1 Opamp Configuration: see description of OA0_CFG</description>
                <bitRange>[23:20]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>OA1_COMP_OUT</name>
                <description>Opamp1 comparator edge detect output (for interrupt and trigger generation)</description>
                <bitRange>[25:24]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DISABLE</name>
                    <description>Disabled, no interrupts will be detected</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RISING</name>
                    <description>Rising edge</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>FALLING</name>
                    <description>Falling edge</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>BOTH</name>
                    <description>Both rising and falling edges</description>
                    <value>3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>RES1_SWAP</name>
                <description>Swap Top and Bottom resistor value (see RES0_SWAP)</description>
                <bitRange>[26:26]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>OA1_CC_ENABLE</name>
                <description>Opamp1 miller compensation capacitor enable</description>
                <bitRange>[27:27]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DISABLE</name>
                    <description>Opamp1 contains no miller compensation capactior.</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ENABLE</name>
                    <description>The compensation capacitor value is determined by CTBL_TRIM_STRUCT.OA1_COMP_TRIM.OA1_COMP_TRIM</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>C1_FB</name>
                <description>Feed back Cap value (see C0_FB)</description>
                <bitRange>[31:28]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>COMP_STAT</name>
            <description>Comparator status</description>
            <addressOffset>0x4</addressOffset>
            <size>32</size>
            <access>read-only</access>
            <resetValue>0x0</resetValue>
            <resetMask>0x10001</resetMask>
            <fields>
              <field>
                <name>OA0_COMP</name>
                <description>Opamp0 current comparator status</description>
                <bitRange>[0:0]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>OA1_COMP</name>
                <description>Opamp1 current comparator status</description>
                <bitRange>[16:16]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
        </cluster>
        <cluster>
          <dim>8</dim>
          <dimIncrement>16</dimIncrement>
          <name>DYN[%s]</name>
          <description>CTBL dynamic configuration structure (only accessible if ACTRLR.STATUS.MODE=0)</description>
          <addressOffset>0x00000600</addressOffset>
          <register>
            <name>OA_MUX_CFG</name>
            <description>Opamp Mux Configuration</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0x4FF73373</resetMask>
            <fields>
              <field>
                <name>OA_INP_DIRECT</name>
                <description>N/A</description>
                <bitRange>[1:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>OA_INP_REF</name>
                <description>Opamp non-inverting terminal reference connection
0 = Disconnected
1 = vref0
2 = vref1
3 = vref2
4 = vref3
5 = vbgr
6 = Adjacent CTBL OA0 Output
7 = Adjacent CTBL OA1 Output</description>
                <bitRange>[6:4]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>OA_INM_DIRECT</name>
                <description>N/A</description>
                <bitRange>[9:8]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>OA_RES_DIRECT</name>
                <description>N/A</description>
                <bitRange>[13:12]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>OA_RES_REF</name>
                <description>N/A</description>
                <bitRange>[18:16]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>CTBBUS_MUX_IN</name>
                <description>N/A</description>
                <bitRange>[23:20]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>CTBBUS_MUX_OUT</name>
                <description>N/A</description>
                <bitRange>[27:24]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>OA_TO_PIN</name>
                <description>OA Output connects to pin</description>
                <bitRange>[30:30]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
        </cluster>
        <cluster>
          <name>TRIM</name>
          <description>CTBL trim structure (only accessible if ACTRLR.STATUS.MODE=0)</description>
          <addressOffset>0x00000F00</addressOffset>
          <register>
            <name>OA0_OFFSET_TRIM</name>
            <description>Opamp0 trim control</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0x3F</resetMask>
            <fields>
              <field>
                <name>OA0_OFFSET_TRIM</name>
                <description>Opamp0 offset trim</description>
                <bitRange>[5:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>OA0_SLOPE_OFFSET_TRIM</name>
            <description>Opamp0 trim control</description>
            <addressOffset>0x4</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0x3F</resetMask>
            <fields>
              <field>
                <name>OA0_SLOPE_OFFSET_TRIM</name>
                <description>Opamp0 slope offset drift trim</description>
                <bitRange>[5:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>OA0_COMP_TRIM</name>
            <description>Opamp0 trim control</description>
            <addressOffset>0x8</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xF</resetMask>
            <fields>
              <field>
                <name>OA0_COMP_TRIM</name>
                <description>Opamp0 Compensation Capacitor Trim

Bit&lt;3&gt; is not used

Bits&lt;2:0&gt;
000 = 0.1pF
001 = 1.1pF
010 = 2.1pF
011 = 3.1pF
100 = 4.1pF
101 = 5.1pF
110 = 6.1pF
111 = 7.1pF</description>
                <bitRange>[3:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>OA1_OFFSET_TRIM</name>
            <description>Opamp1 trim control</description>
            <addressOffset>0xC</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0x3F</resetMask>
            <fields>
              <field>
                <name>OA1_OFFSET_TRIM</name>
                <description>Opamp1 offset trim</description>
                <bitRange>[5:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>OA1_SLOPE_OFFSET_TRIM</name>
            <description>Opamp1 trim control</description>
            <addressOffset>0x10</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0x3F</resetMask>
            <fields>
              <field>
                <name>OA1_SLOPE_OFFSET_TRIM</name>
                <description>Opamp1 slope offset drift trim</description>
                <bitRange>[5:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>OA1_COMP_TRIM</name>
            <description>Opamp1 trim control</description>
            <addressOffset>0x14</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xF</resetMask>
            <fields>
              <field>
                <name>OA1_COMP_TRIM</name>
                <description>Opamp1 Compensation Capacitor Trim (See OA0_COMP_TRIM)</description>
                <bitRange>[3:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>RMP_TRIM</name>
            <description>Risk Mitigation bits</description>
            <addressOffset>0x18</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x1</resetValue>
            <resetMask>0xF</resetMask>
            <fields>
              <field>
                <name>RMP_TRIM</name>
                <description>N/A</description>
                <bitRange>[3:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
        </cluster>
      </registers>
    </peripheral>
    <peripheral derivedFrom="CTBL0">
      <name>CTBL1</name>
      <baseAddress>0x42E10000</baseAddress>
    </peripheral>
    <peripheral>
      <name>PTC</name>
      <description>Programmable Threshold Comparator</description>
      <baseAddress>0x42E40000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>65536</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <cluster>
          <name>STA</name>
          <description>PTC Static Configuration</description>
          <addressOffset>0x00000400</addressOffset>
          <register>
            <name>CFG</name>
            <description>PTC Configuration Register  (only accessible if ACTRLR.STATUS.MODE=0)</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0x3737</resetMask>
            <fields>
              <field>
                <name>COMP0_MODE</name>
                <description>Operating mode for the comparator 0</description>
                <bitRange>[1:0]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>OFF</name>
                    <description>Off</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ULP</name>
                    <description>Ultra lowpower operating mode (quiscent current &lt; 300nA, 7us response time to 100mV overdrive).

The comparator is biased using a local reference.</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LP</name>
                    <description>Low Power operating mode  (quiscent current &lt; 10uA, 1us response time to 100mV overdrive).</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>NORMAL</name>
                    <description>Normal Power operating mode  (quiscent current &lt; 150uA, 0.1us response time to 100mV overdrive).</description>
                    <value>3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>COMP0_HYST</name>
                <description>Add 30mV hysteresis to the comparator 0
0= Disable Hysteresis
1= Enable Hysteresis</description>
                <bitRange>[2:2]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>COMP0_OUT</name>
                <description>Comparator 0 output (for interrupt and trigger generation)</description>
                <bitRange>[5:4]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DISABLE</name>
                    <description>Disabled, no interrupts will be detected</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RISING</name>
                    <description>Rising edge</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>FALLING</name>
                    <description>Falling edge</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>BOTH</name>
                    <description>Both rising and falling edges</description>
                    <value>3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>COMP1_MODE</name>
                <description>See COMP0_MODE</description>
                <bitRange>[9:8]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>OFF</name>
                    <description>N/A</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ULP</name>
                    <description>N/A</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LP</name>
                    <description>N/A</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>NORMAL</name>
                    <description>N/A</description>
                    <value>3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>COMP1_HYST</name>
                <description>See COMP0_HYST</description>
                <bitRange>[10:10]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>COMP1_OUT</name>
                <description>See COMP0_OUT</description>
                <bitRange>[13:12]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DISABLE</name>
                    <description>N/A</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RISING</name>
                    <description>N/A</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>FALLING</name>
                    <description>N/A</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>BOTH</name>
                    <description>N/A</description>
                    <value>3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>COMP_STAT</name>
            <description>PTC Status Register</description>
            <addressOffset>0x4</addressOffset>
            <size>32</size>
            <access>read-only</access>
            <resetValue>0x0</resetValue>
            <resetMask>0x10001</resetMask>
            <fields>
              <field>
                <name>OUT0</name>
