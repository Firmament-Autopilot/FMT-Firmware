                      <description>(none)</description>
                      <value>8</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>CC09</name>
                      <description>(none)</description>
                      <value>9</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>CC10</name>
                      <description>(none)</description>
                      <value>10</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>CC11</name>
                      <description>(none)</description>
                      <value>11</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>CC12</name>
                      <description>(none)</description>
