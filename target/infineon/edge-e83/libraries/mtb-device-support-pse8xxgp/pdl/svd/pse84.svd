                    <name>FIFO_LEVEL7</name>
                    <description>FIFO Level 7 trigger</description>
                    <value>53</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>DAC0_RANGE0</name>
                    <description>DAC0 Range 0 detection</description>
                    <value>54</value>
                  </enumeratedValue>
                  <enumeratedValue>
