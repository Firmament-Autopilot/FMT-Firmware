                    <description>Tx FIFO 3</description>
                    <value>3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>TXFIFO4</name>
                    <description>Tx FIFO 4</description>
                    <value>4</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>TXFIFO5</name>
                    <description>Tx FIFO 5</description>
                    <value>5</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>TXFIFO6</name>
                    <description>Tx FIFO 6</description>
                    <value>6</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>TXFIFO7</name>
                    <description>Tx FIFO 7</description>
                    <value>7</value>
