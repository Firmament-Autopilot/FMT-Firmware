              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>ID1</name>
          <description>Implementation Defined Identification Register (ID1)</description>
          <addressOffset>0xFF4</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0xF0</resetValue>
