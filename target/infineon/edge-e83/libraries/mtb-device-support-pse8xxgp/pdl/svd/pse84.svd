                <bitRange>[1:1]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>MASK</name>
                    <description>Channel Halted Mask</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>NOMASK</name>
                    <description>No Channel Halted Mask</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>AHBERRMSK</name>
                <description>AHB Error Mask (AHBErrMsk)
In  scatter/gather  DMA  mode  for  host, 
interrupts will not be generated due to the corresponding bits set in 
HCINTn.</description>
                <bitRange>[2:2]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>MASK</name>
                    <description>AHB Error Mask</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>NOMASK</name>
                    <description>No AHB Error Mask</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>BNAINTRMSK</name>
                <description>BNA  (Buffer  Not  Available)  Interrupt  mask  register  (BNAIntrMsk) 
This bit is valid only when Scatter/Gather DMA mode is enabled.</description>
                <bitRange>[11:11]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>MASK</name>
                    <description>BNA Interrupt Masked</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>NOMASK</name>
                    <description>BNA Interrupt not masked</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>DESC_LST_ROLLINTRMSK</name>
                <description>Descriptor List rollover interrupt Mask register(DESC_LST_ROLLIntrMsk)
This bit is valid only when Scatter/Gather DMA mode is enabled.</description>
                <bitRange>[13:13]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>MASK</name>
                    <description>Descriptor Rollover Interrupt Mask</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>NOMASK</name>
                    <description>Descriptor Rollover Interrupt not masked</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>HCTSIZ9</name>
            <description>This register reflects the transfer size for the Host Channel.</description>
            <addressOffset>0x630</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
