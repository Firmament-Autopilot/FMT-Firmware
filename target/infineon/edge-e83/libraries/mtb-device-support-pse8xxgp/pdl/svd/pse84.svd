              <addressOffset>0x1C</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x0</resetValue>
              <resetMask>0xFFFFFFFF</resetMask>
              <fields>
                <field>
                  <name>DBI_VCID_DBI_VCID</name>
                  <description>This field configures the virtual channel id that is indexed to the DCS packets from DBI.</description>
                  <bitRange>[1:0]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>DBI_VCID_RSVD_31_2</name>
                  <description>N/A</description>
                  <bitRange>[31:2]</bitRange>
