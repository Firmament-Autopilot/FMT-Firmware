                    <description>Transfer Completed Mask</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>NOMASK</name>
                    <description>No Transfer Completed Mask</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>CHHLTDMSK</name>
                <description>Channel Halted Mask (ChHltdMsk)</description>
                <bitRange>[1:1]</bitRange>
                <access>read-write</access>
