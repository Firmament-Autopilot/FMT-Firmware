                    <value>5</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>I3C_PU_1150</name>
                    <description>Pull-up 1150 Ohms</description>
                    <value>3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>I3C_PU_1650</name>
                    <description>Pull-up 1650 Ohms</description>
                    <value>4</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>I3C_PU_2190</name>
                    <description>Pull-up 2190 Ohms</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>I3C_PU_2800</name>
                    <description>Pull-up 2800 Ohms</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>RESISTOR_CFG1</name>
                <description>Sets resistor value in IO cell for pin 1.</description>
                <bitRange>[7:4]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>RESISTOR_CFG2</name>
                <description>Sets resistor value in IO cell for pin 1.</description>
                <bitRange>[11:8]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>RESISTOR_CFG3</name>
                <description>Sets resistor value in IO cell for pin 1.</description>
                <bitRange>[15:12]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>RESISTOR_CFG4</name>
                <description>Sets resistor value in IO cell for pin 1.</description>
                <bitRange>[19:16]</bitRange>
                <access>read-write</access>
