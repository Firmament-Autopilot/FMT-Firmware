                  <bitRange>[18:18]</bitRange>
                  <access>read-write</access>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>HIGHSPEED</name>
                      <description>(none)</description>
                      <value>0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>LOWPOWER</name>
                      <description>(none)</description>
                      <value>1</value>
