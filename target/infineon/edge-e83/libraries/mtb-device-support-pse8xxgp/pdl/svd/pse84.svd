                  <enumeratedValue>
                    <name>CHIP_ACTIVE_MODE</name>
                    <description>Chip Active Mode Status

This status is set whenever the system is operating in Active Mode (this includes all Low Power active modes)</description>
                    <value>32</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CHIP_DEEPSLEEP_MODE</name>
                    <description>Chip Deepsleep Mode Status

This status is set whenever the system is operating in Deepsleep Mode (this includes all RAM power modes in Deepsleep)</description>
                    <value>33</value>
