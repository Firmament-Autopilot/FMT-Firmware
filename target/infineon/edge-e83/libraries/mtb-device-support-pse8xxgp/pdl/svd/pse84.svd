              <field>
                <name>XFERCOMPLMSK</name>
                <description>Transfer Completed Mask (XferComplMsk)</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>MASK</name>
                    <description>Transfer Completed Mask</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>NOMASK</name>
                    <description>No Transfer Completed Mask</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>CHHLTDMSK</name>
                <description>Channel Halted Mask (ChHltdMsk)</description>
                <bitRange>[1:1]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>MASK</name>
                    <description>Channel Halted Mask</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>NOMASK</name>
                    <description>No Channel Halted Mask</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>AHBERRMSK</name>
                <description>AHB Error Mask (AHBErrMsk)
In  scatter/gather  DMA  mode  for  host, 
interrupts will not be generated due to the corresponding bits set in 
HCINTn.</description>
                <bitRange>[2:2]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>MASK</name>
                    <description>AHB Error Mask</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>NOMASK</name>
                    <description>No AHB Error Mask</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>BNAINTRMSK</name>
                <description>BNA  (Buffer  Not  Available)  Interrupt  mask  register  (BNAIntrMsk) 
This bit is valid only when Scatter/Gather DMA mode is enabled.</description>
                <bitRange>[11:11]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>MASK</name>
                    <description>BNA Interrupt Masked</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>NOMASK</name>
                    <description>BNA Interrupt not masked</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>DESC_LST_ROLLINTRMSK</name>
                <description>Descriptor List rollover interrupt Mask register(DESC_LST_ROLLIntrMsk)
This bit is valid only when Scatter/Gather DMA mode is enabled.</description>
                <bitRange>[13:13]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>MASK</name>
                    <description>Descriptor Rollover Interrupt Mask</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>NOMASK</name>
                    <description>Descriptor Rollover Interrupt not masked</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>HCTSIZ8</name>
            <description>This register reflects the transfer size for the Host Channel.</description>
            <addressOffset>0x610</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>XFERSIZE</name>
                <description>N/A</description>
                <bitRange>[18:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>PKTCNT</name>
                <description>N/A</description>
                <bitRange>[28:19]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>PID</name>
                <description>PID (Pid)

The application programs this field with the type of PID to use for the initial transaction. The host maintains this field for the rest of the transfer.
 - 2'b00: DATA0
 - 2'b01: DATA2
 - 2'b10: DATA1
 - 2'b11: MDATA (non-control)/SETUP (control)</description>
                <bitRange>[30:29]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DATA0</name>
                    <description>DATA0</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>DATA1</name>
                    <description>DATA1</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>DATA2</name>
                    <description>DATA2</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>MDATA</name>
                    <description>MDATA (non-control)/SETUP (control)</description>
                    <value>3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>DOPNG</name>
                <description>Do Ping (DoPng)

This bit is used only for OUT transfers.
Setting this field to 1 directs the host to do PING protocol.

Note: Do not set this bit for IN transfers. If this bit is set for for IN transfers it disables the channel.</description>
                <bitRange>[31:31]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NOPING</name>
                    <description>No ping protocol</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PING</name>
                    <description>Ping protocol</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>HCDMA8</name>
            <description>This register is used by the OTG host in the internal DMA mode to maintain the current buffer pointer for IN/OUT transactions. The starting DMA address must be DWORD-aligned.</description>
            <addressOffset>0x614</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
