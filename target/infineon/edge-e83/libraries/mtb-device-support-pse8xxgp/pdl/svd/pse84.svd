              <name>OSC_CAL_CODE_8M</name>
              <description>Manual trim code to apply to 8MHz oscillator.  Only used if osc_cal_manual_8M=1.</description>
              <bitRange>[28:24]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
