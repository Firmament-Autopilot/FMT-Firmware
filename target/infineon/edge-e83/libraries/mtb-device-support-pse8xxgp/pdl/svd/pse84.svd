            <name>ROT_BLK_IDX</name>
            <description>Index of 8-block group accessed through ROT_BLK_LUT_*</description>
            <addressOffset>0x210</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
