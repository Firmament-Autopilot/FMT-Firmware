              </field>
              <field>
                <name>HSICMODE</name>
                <description>HSIC mode specified for Mode of Operation
Value Range: 0 - 1
 - 1: HSIC-capable with shared UTMI PHY interface
 - 0: Non-HSIC-capable</description>
                <bitRange>[13:13]</bitRange>
                <access>read-only</access>
