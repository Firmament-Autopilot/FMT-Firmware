              <addressOffset>0x158</addressOffset>
              <size>32</size>
              <access>read-only</access>
              <resetValue>0x0</resetValue>
              <resetMask>0xFFFFFFFF</resetMask>
              <fields>
                <field>
                  <name>VID_VBP_LINES_ACT_VBP_LINES</name>
                  <description>This field specifies the Vertical Back Porch period measured in number of horizontal lines.</description>
                  <bitRange>[9:0]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>VID_VBP_LINES_ACT_RSVD_31_10</name>
                  <description>N/A</description>
