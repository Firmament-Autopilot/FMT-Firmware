                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>BCSUPPORT</name>
                <description>This bit indicates the controller support for Battery Charger.
 - 0 - No Battery Charger Support
 - 1 - Battery Charger support present</description>
                <bitRange>[14:14]</bitRange>
                <access>read-only</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DISABLED</name>
                    <description>No Battery Charger Support</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ENABLED</name>
                    <description>Battery Charger Support present</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>LPMMODE</name>
                <description>LPM mode specified for Mode of Operation.</description>
                <bitRange>[15:15]</bitRange>
