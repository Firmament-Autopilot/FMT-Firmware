          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0x1</resetMask>
          <fields>
            <field>
              <name>BUFF_WRITE_ERR</name>
              <description>Mask for corresponding field in INTR_AHB2AXI register.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
