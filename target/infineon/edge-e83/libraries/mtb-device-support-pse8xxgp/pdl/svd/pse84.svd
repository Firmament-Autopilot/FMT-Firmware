See POS_MUX_SEL.
Valid only in LP mode and when SEQ_HS_DATA.MUX0_PSEUDO_DIFF enabled in HS mode</description>
                <bitRange>[16:12]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>BUF_BYPASS</name>
                <description>Channel Buffer bypass</description>
                <bitRange>[18:18]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DISABLED</name>
                    <description>Buffered bypass disabled</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ENABLED</name>
                    <description>Buffered bypass enabled</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>AVG_SHIFT</name>
                <description>Average Shift Enable

This field is only valid if the following conditions are met:

Averaging is configured for accumulate and dump or interleaved: CTRL.AVG_MODE=1,2
Averaging is enabled for particular state in the sequence table: SEQ_HS(LP)_DATA.AVG_EN=1

The amount of shifting is set by CTRL.SHIFT_MODE.</description>
                <bitRange>[19:19]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>NEG_COEFF_SEL</name>
                <description>See POS_COEFF_SEL.
Valid only when SEQ_HS_DATA.MUX0_PSEUDO_DIFF enabled in HS mode</description>
                <bitRange>[23:20]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>STATUS_SEL</name>
                <description>Status selections</description>
                <bitRange>[26:24]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DISABLED</name>
                    <description>N/A</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>STATUS_STRUCT_0</name>
                    <description>N/A</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>STATUS_STRUCT_1</name>
                    <description>N/A</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>STATUS_STRUCT_2</name>
                    <description>N/A</description>
                    <value>3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>STATUS_STRUCT_3</name>
                    <description>N/A</description>
                    <value>4</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RSVD_0</name>
                    <description>N/A</description>
                    <value>5</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RSVD_1</name>
                    <description>N/A</description>
                    <value>6</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RSVD_2</name>
                    <description>N/A</description>
                    <value>7</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>FIFO_SEL</name>
                <description>FIFO selections.  Select 1 of the 8 for FIFO data storage

The FIFO must be configured to support the number of desired FIFOs (LPPASS_MMIO.FIFO_STA_CFG.CFG.SEL)</description>
                <bitRange>[31:28]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DISABLED</name>
                    <description>N/A</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>FIFO_0</name>
                    <description>N/A</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>FIFO_1</name>
                    <description>N/A</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>FIFO_2</name>
                    <description>N/A</description>
                    <value>3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>FIFO_3</name>
                    <description>N/A</description>
                    <value>4</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>FIFO_4</name>
                    <description>N/A</description>
                    <value>5</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>FIFO_5</name>
                    <description>N/A</description>
                    <value>6</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>FIFO_6</name>
                    <description>N/A</description>
                    <value>7</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>FIFO_7</name>
                    <description>N/A</description>
                    <value>8</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RSVD_0</name>
                    <description>N/A</description>
                    <value>9</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RSVD_1</name>
                    <description>N/A</description>
                    <value>10</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RSVD_2</name>
                    <description>N/A</description>
                    <value>11</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RSVD_3</name>
                    <description>N/A</description>
                    <value>12</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RSVD_4</name>
                    <description>N/A</description>
                    <value>13</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RSVD_5</name>
                    <description>N/A</description>
                    <value>14</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RSVD_6</name>
                    <description>N/A</description>
                    <value>15</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <dim>4</dim>
            <dimIncrement>4</dimIncrement>
            <name>STATUS_CFG[%s]</name>
            <description>Global range detect mode register (only accessible if ACTRLR.STATUS.MODE=0)</description>
            <addressOffset>0x90</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0x3</resetMask>
            <fields>
              <field>
                <name>RANGE_COND</name>
                <description>Range condition select.</description>
                <bitRange>[1:0]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>BELOW</name>
                    <description>result &lt; RANGE_LOW</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>INSIDE</name>
                    <description>RANGE_LOW &lt;= result &lt; RANGE_HIGH</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ABOVE</name>
                    <description>result &gt; RANGE_HIGH</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>OUTSIDE</name>
                    <description>result &lt; RANGE_LOW || result &gt;= RANGE_HIGH</description>
                    <value>3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <dim>4</dim>
            <dimIncrement>4</dimIncrement>
            <name>STATUS_RANGE_LOW[%s]</name>
            <description>Global range detect low value register (only accessible if ACTRLR.STATUS.MODE=0)</description>
            <addressOffset>0xA0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>RANGE_LOW</name>
                <description>Low threshold for range detect</description>
                <bitRange>[31:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <dim>4</dim>
            <dimIncrement>4</dimIncrement>
            <name>STATUS_RANGE_HIGH[%s]</name>
            <description>Global range detect high value register (only accessible if ACTRLR.STATUS.MODE=0)</description>
            <addressOffset>0xB0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>RANGE_HIGH</name>
                <description>High threshold for range detect</description>
                <bitRange>[31:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <dim>8</dim>
            <dimIncrement>4</dimIncrement>
            <name>GPIO_CHAN_RESULT[%s]</name>
            <description>High Speed GPIO Channel result register</description>
            <addressOffset>0xC0</addressOffset>
            <size>32</size>
            <access>read-only</access>
            <resetValue>0x0</resetValue>
            <resetMask>0x0</resetMask>
            <fields>
              <field>
                <name>RESULT</name>
                <description>SAR conversion channel result data of the channel. The data is written here if the corresponding bit in CHAN_RESULT_MASK.GPIO_CHAN_RESULT_MASK is set.</description>
                <bitRange>[31:0]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <dim>16</dim>
            <dimIncrement>4</dimIncrement>
            <name>MUX_CHAN_RESULT[%s]</name>
            <description>High Speed / Low Power Muxed Channel result register</description>
            <addressOffset>0xE0</addressOffset>
            <size>32</size>
            <access>read-only</access>
            <resetValue>0x0</resetValue>
            <resetMask>0x0</resetMask>
            <fields>
              <field>
                <name>RESULT</name>
                <description>SAR conversion channel result data of the channel. The data is written here if the corresponding bit in CHAN_RESULT_MASK.MUX_CHAN_RESULT_MASK is set.</description>
                <bitRange>[31:0]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <dim>2</dim>
            <dimIncrement>4</dimIncrement>
            <name>FIR_RESULT[%s]</name>
            <description>FIR result register</description>
            <addressOffset>0x120</addressOffset>
            <size>32</size>
            <access>read-only</access>
            <resetValue>0x0</resetValue>
            <resetMask>0x0</resetMask>
            <fields>
              <field>
                <name>RESULT</name>
                <description>FIR output data. The data is written here if the corresponding bit in FIR_RESULT_MASK.FIR_RESULT_MASK is set.</description>
                <bitRange>[31:0]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>CHAN_RESULT_MASK</name>
            <description>Channel result mask (only accessible if ACTRLR.STATUS.MODE=0)</description>
            <addressOffset>0x130</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0xFFFF00FF</resetValue>
            <resetMask>0xFFFF00FF</resetMask>
            <fields>
              <field>
                <name>GPIO_CHAN_RESULT_MASK</name>
                <description>If set, the GPIO_CHAN_RESULT.RESULT register will be used to store SAR conversion data and an EOS will be generated at the end of a scan that includes the MUX channel.  If this bit isn't set, the channel must be configured to store the result in a FIFO. (Default is for all result registers to be used).</description>
                <bitRange>[7:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>MUX_CHAN_RESULT_MASK</name>
                <description>If set the MUX_CHAN_RESULT.RESULT register will be used to store SAR conversion data and an EOS will be generated at the end of a scan that includes the MUX channel.  If this bit isn't set, the channel must be configured to store the result in a FIFO. (Default is for all result registers to be used).</description>
                <bitRange>[31:16]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>FIR_RESULT_MASK</name>
            <description>FIR result mask (only accessible if ACTRLR.STATUS.MODE=0)</description>
            <addressOffset>0x134</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x3</resetValue>
            <resetMask>0x3</resetMask>
            <fields>
              <field>
                <name>FIR_RESULT_MASK</name>
                <description>If set, the FIR_RESULT.RESULT register will be used to store FIR outputs.  If this bit isn't set, the FIR must be configured to store the result in a FIFO. (Default is for the FIR result registers to be used).</description>
                <bitRange>[1:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>CHAN_RESULT_UPDATED</name>
            <description>Channel result register status</description>
            <addressOffset>0x138</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFF00FF</resetMask>
            <fields>
              <field>
                <name>GPIO_CHAN_RESULT_UPDATED</name>
                <description>If set the corresponding GPIO_CHAN_RESULT.RESULT register was updated, i.e. was sampled during the previous scan and, in case of Interleaved averaging, reached the averaging count. If this bit is low then either the channel is not enabled or the averaging count is not yet reached for Interleaved averaging.  Write 1 to clear.</description>
                <bitRange>[7:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>MUX_CHAN_RESULT_UPDATED</name>
                <description>If set the corresponding MUX_CHAN_RESULT.RESULT register was updated, i.e. was sampled during the previous scan and, in case of Interleaved averaging, reached the averaging count. If this bit is low then either the channel is not enabled or the averaging count is not yet reached for Interleaved averaging. Write 1 to clear.</description>
                <bitRange>[31:16]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>FIR_RESULT_UPDATED</name>
            <description>FIR result register status</description>
            <addressOffset>0x13C</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0x3</resetMask>
            <fields>
              <field>
                <name>FIR_RESULT_UPDATED</name>
                <description>If set the corresponding FIR_RESULT.RESULT register was updated. If this bit is low then either the FIR is not enabled or the FIR output is not yet available.  Write 1 to clear.</description>
                <bitRange>[1:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>STATUS</name>
            <description>SAR status register</description>
            <addressOffset>0x140</addressOffset>
            <size>32</size>
            <access>read-only</access>
            <resetValue>0x0</resetValue>
            <resetMask>0x80000000</resetMask>
            <fields>
              <field>
                <name>BUSY</name>
                <description>If high then the SAR is busy with a conversion. This bit is always high when CONTINUOUS (i.e. the last state of a scan has SEQ_HS(LP)_DATA.NEXT_ACTION=GO_TO_ENTRY_ADDR). Except for CONINUOUS mode, firmware should wait for this bit to be low before powering down the SAR (AC.SAR_EN=0).</description>
                <bitRange>[31:31]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>RANGE_STATUS</name>
            <description>Range status register</description>
            <addressOffset>0x144</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFF03FF</resetMask>
            <fields>
              <field>
                <name>GPIO_CHAN_RANGE_STATUS</name>
                <description>GPIO Channel Range detect status: hardware sets this bit for each channel if the conversion result (after averaging) of that channel met the condition specified by the GPIO_CHAN_CFG.STATUS_SEL registers. Write with '1' to clear bit.</description>
                <bitRange>[7:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>FIR_RANGE_STATUS</name>
                <description>FIR Range detect status: hardware sets this bit for each FIR if the FIR output met the condition specified by the FIR_CFG.STATUS_SEL registers. Write with '1' to clear bit.</description>
                <bitRange>[9:8]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>MUX_CHAN_RANGE_STATUS</name>
                <description>MUX Channel Range detect status: hardware sets this bit for each channel if the conversion result (after averaging) of that channel met the condition specified by the MUX_CHAN_CFG.STATUS_SEL registers. Write with '1' to clear bit.</description>
                <bitRange>[31:16]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <dim>8</dim>
            <dimIncrement>4</dimIncrement>
            <name>CHAN_COEFF[%s]</name>
            <description>Channel correction coefficients (only accessible if ACTRLR.STATUS.MODE=0)</description>
            <addressOffset>0x150</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x80000000</resetValue>
            <resetMask>0xFFFF0FFF</resetMask>
            <fields>
              <field>
                <name>OFFSET</name>
                <description>Channel Offset Correction Coefficient (Default value is offset of 0).

This field is intended to correct sources of offset error in the SAR channel (from the GPIO to the SAR ADC input).  It is expected that the SAR ADC offset has already been calibrated (i.e. HS(LP)_CAL_MEM values are valid).

Signed offset values range from -2048 (0x800) to +2047 (0x7FF) is added to 12-bit SAR conversion.</description>
                <bitRange>[11:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>GAIN</name>
                <description>Gain Correction Coefficient (Default value is gain of 1).

This field is intended to correct sources of gain error in the SAR channel (from the GPIO to the SAR ADC input).  It is expected that both the channel offset correction coefficient and SAR ADC offset have already been calibrated (i.e. HS(LP)_CAL_MEM values are valid).

Multiplies the 12-bit SAR conversion by X.XXXXXXXXXXXXXXX

Range is: 1/2^15=(0.000030517578125) to 2-(1/2^15)=(1.999969482421875)</description>
                <bitRange>[31:16]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
        </cluster>
        <cluster>
          <dim>64</dim>
          <dimIncrement>8</dimIncrement>
          <name>FIR0[%s]</name>
          <description>SAR FIR0 registers (only accessible if ACTRLR.STATUS.MODE=0)</description>
          <addressOffset>0x00000600</addressOffset>
          <register>
            <name>COEF</name>
            <description>Coefficient Value</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0x0</resetMask>
            <fields>
              <field>
                <name>COEF</name>
                <description>FIR Coefficient Value

The coefficient values can range from -1+1/215 to 1-1/215 with a resolution of 1/215. The coefficient uses twos-complement notation and the decimal point is fixed to the right of the most significant bit.

Examples: -0.25 = 0xE000 and 0.25 = 0x2000</description>
                <bitRange>[15:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>TAP</name>
            <description>Tap Value</description>
            <addressOffset>0x4</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0x0</resetMask>
            <fields>
              <field>
                <name>TAP</name>
                <description>Tap value, in typical operation, software only reads the tap.  For debug purposes only, sofware can write to the tap.</description>
                <bitRange>[31:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
        </cluster>
        <cluster>
          <dim>64</dim>
          <dimIncrement>8</dimIncrement>
          <name>FIR1[%s]</name>
          <description>SAR FIR1 registers (only accessible if ACTRLR.STATUS.MODE=0)</description>
          <addressOffset>0x00000800</addressOffset>
          <register>
            <name>COEF</name>
            <description>Coefficient Value</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0x0</resetMask>
            <fields>
              <field>
                <name>COEF</name>
                <description>FIR Coefficient Value

The coefficient values can range from -1+1/215 to 1-1/215 with a resolution of 1/215. The coefficient uses twos-complement notation and the decimal point is fixed to the right of the most significant bit.

Examples: -0.25 = 0xE000 and 0.25 = 0x2000</description>
                <bitRange>[15:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>TAP</name>
            <description>Tap Value</description>
            <addressOffset>0x4</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0x0</resetMask>
            <fields>
              <field>
                <name>TAP</name>
                <description>Tap value, in typical operation, software only reads the tap.  For debug purposes only, sofware can write to the tap.</description>
                <bitRange>[31:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
        </cluster>
        <cluster>
          <name>HS_CAL_MEM</name>
          <description>SAR HS Core Calibration Memory (only accessible when the SAR is disabled (AC.SAR_EN=0) and ACTRLR.STATUS.MODE=0)</description>
          <addressOffset>0x00000C00</addressOffset>
          <register>
            <name>CALCTRL</name>
            <description>SAR HS Core Calibration Control Register</description>
            <addressOffset>0x14</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>OFFDEP</name>
                <description>Use the old offset-dependent calibration scheme when this bit is set.</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>R1</name>
                <description>N/A</description>
                <bitRange>[7:1]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>AVG</name>
                <description>Determines averaging repetitions for calibration</description>
                <bitRange>[9:8]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>AVG_16</name>
                    <description>use 16 averaging repititions per calibration value</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>AVG_32</name>
                    <description>use 32 averaging repititions per calibration value</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>AVG_64</name>
                    <description>use 64 averaging repititions per calibration value</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>AVG_2</name>
                    <description>use 2 averaging repititions per calibration value</description>
                    <value>3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>STC</name>
                <description>Calibration sample time control</description>
                <bitRange>[11:10]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>STC_512</name>
                    <description>use sample time of 512 clk_lppass cycles</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>STC_1024</name>
                    <description>use sample time of 1024 clk_lppass cycles</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>STC_2048</name>
                    <description>use sample time of 2048 clk_lppass cycles</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>STC_32</name>
                    <description>use sample time of 32 clk_lppass cycles</description>
                    <value>3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>R12</name>
                <description>N/A</description>
                <bitRange>[31:12]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>CONVCTRL</name>
            <description>SAR HS Core Conversion Control Register</description>
            <addressOffset>0x1C</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>INIT_TC</name>
                <description>Choose for how many sync-periods the core-side capacitors are initialized to the common mode voltage, via the OCS switch, after conversion start is received.</description>
                <bitRange>[1:0]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>CONV_INIT_1</name>
                    <description>Initialize for 1 sync-period to the core's common mode voltage before redistribution starts</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CONV_INIT_2</name>
                    <description>Initialize for 2 sync-period to the core's common mode voltage before redistribution starts</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CONV_INIT_4</name>
                    <description>Initialize for 4 sync-period to the core's common mode voltage before redistribution starts</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CONV_INIT_16</name>
                    <description>Initialize for 16 sync-period to the core's common mode voltage before redistribution starts</description>
                    <value>3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>R2</name>
                <description>N/A</description>
                <bitRange>[3:2]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>MSB_CTRL</name>
                <description>When set, the redistribution time for the MSB decision is extended to two sync periods.</description>
                <bitRange>[4:4]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>RES_RAW</name>
                <description>DO NOT change from Default for *A0 PSE84.

Output the raw result (13-bit, redundant coding) instead of the processed one (12-bit, binary coding).</description>
                <bitRange>[5:5]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>R6</name>
                <description>N/A</description>
                <bitRange>[31:6]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>ADFTMUX</name>
