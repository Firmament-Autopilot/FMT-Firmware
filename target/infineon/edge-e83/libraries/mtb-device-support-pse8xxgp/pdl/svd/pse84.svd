            <name>MXGPU</name>
            <description>Platform IP standard configuration for GPU.</description>
            <headerStructName>GFXSS_GPU_MXGPU</headerStructName>
            <addressOffset>0x00000000</addressOffset>
            <register>
              <name>CTL</name>
              <description>IP control.</description>
              <addressOffset>0x0</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x0</resetValue>
              <resetMask>0x80000000</resetMask>
              <fields>
                <field>
                  <name>ENABLED</name>
                  <description>IP enable bit. When disabled (value 0), the functional state of the GCNano core is reset and its clock input gated. Access to MMIO of the core results in an AHB error response. Note, that the effect of this bit is delayed (see STATUS.CORE_RST). The core must be idle (no outstanding or pending AXI transactions) before clearing this bit.</description>
                  <bitRange>[31:31]</bitRange>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>STATUS</name>
              <description>IP status.</description>
              <addressOffset>0xC</addressOffset>
              <size>32</size>
              <access>read-only</access>
              <resetValue>0x1</resetValue>
              <resetMask>0x1</resetMask>
              <fields>
                <field>
                  <name>CORE_RST</name>
                  <description>Reset state of the GCNano core (1 = in reset). This state is delayed to GFXSS_GPU reset. After reset de-activation it has to be checked for value 0 before the core can be used. After activation it has to be checked for value 1 before turning off the external clk_hf source.</description>
                  <bitRange>[0:0]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>INTR</name>
              <description>Interrupt status bits.</description>
              <addressOffset>0x10</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x0</resetValue>
              <resetMask>0x1</resetMask>
              <fields>
                <field>
                  <name>CORE</name>
                  <description>GCNanoLiteV core has signalled an interrupt. Writing a '1' to this field will reset the bit. Interrupt stats inside the core is not affected by this.</description>
                  <bitRange>[0:0]</bitRange>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>INTR_SET</name>
              <description>Interrupt set bits.</description>
              <addressOffset>0x14</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x0</resetValue>
              <resetMask>0x1</resetMask>
              <fields>
                <field>
                  <name>CORE_SET</name>
                  <description>Write this field with '1' to set corresponding INTR field (a write of '0' has no effect).</description>
                  <bitRange>[0:0]</bitRange>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>INTR_MASK</name>
              <description>Interrupt mask bits.</description>
              <addressOffset>0x18</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x0</resetValue>
              <resetMask>0x1</resetMask>
              <fields>
                <field>
                  <name>CORE_MASK</name>
                  <description>Mask for corresponding field in INTR register.</description>
                  <bitRange>[0:0]</bitRange>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>INTR_MASKED</name>
              <description>Interrupt masked bits.</description>
              <addressOffset>0x1C</addressOffset>
              <size>32</size>
              <access>read-only</access>
              <resetValue>0x0</resetValue>
              <resetMask>0x1</resetMask>
              <fields>
                <field>
                  <name>CORE_MASKED</name>
                  <description>Logical AND of corresponding INTR and INTR_MASK fields.</description>
                  <bitRange>[0:0]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
          </cluster>
          <cluster>
            <name>GCNANO</name>
            <description>Host Interface Registers</description>
            <headerStructName>GFXSS_GPU_GCNANO</headerStructName>
            <addressOffset>0x00000800</addressOffset>
            <register>
              <name>AQHICLOCKCONTROL</name>
              <description>Clock Control Register.</description>
              <addressOffset>0x0</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x70900</resetValue>
              <resetMask>0xFFFFFFFF</resetMask>
              <fields>
                <field>
                  <name>AQHICLOCKCONTROL_RSVD_1</name>
                  <description>N/A</description>
                  <bitRange>[0:0]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>AQHICLOCKCONTROL_CLK2D_DIS</name>
                  <description>Disable 2D/VG clock when set to 1.  CLK2D_DIS should be controlled by software.  The AXI interface clock is the only block not stalled at that point.
0: VG clock on
1:VG clock off</description>
                  <bitRange>[1:1]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>AQHICLOCKCONTROL_FSCALE_VAL</name>
                  <description>Core clock frequency scale value.</description>
                  <bitRange>[8:2]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>AQHICLOCKCONTROL_FSCALE_CMD_LOAD</name>
                  <description>Core clock frequency scale value enable.  When writing a 1 to this bit, it updates the frequency scale factor  with the value FSCALE_VAL[6:0].  The bit must be set back to 0 after that.  If this bit is set and FSCALE_VAL=0 (an invalid combination),  the HREADYOUT output signal will get stuck to 0.</description>
                  <bitRange>[9:9]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>AQHICLOCKCONTROL_DISABLE_RAM_CLOCK_GATING</name>
                  <description>RAM clock gating: 0=automatic turn off RAM clock when RAM not accessed; 1=ram clock always on</description>
                  <bitRange>[10:10]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>AQHICLOCKCONTROL_DISABLE_DEBUG_REGISTERS</name>
                  <description>0=Enable debug registers
1=Disable debug registers</description>
                  <bitRange>[11:11]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>AQHICLOCKCONTROL_SOFT_RESET</name>
                  <description>Soft resets the IP. Write 1 to reset, defaults to 0 after reset.</description>
                  <bitRange>[12:12]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>AQHICLOCKCONTROL_DISABLE_RAM_POWER_OPTIMIZATION</name>
                  <description>N/A</description>
                  <bitRange>[13:13]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>AQHICLOCKCONTROL_RSVD_2</name>
                  <description>N/A</description>
                  <bitRange>[14:14]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>AQHICLOCKCONTROL_RSVD_3</name>
                  <description>N/A</description>
                  <bitRange>[15:15]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>AQHICLOCKCONTROL_IDLE3_D</name>
                  <description>3D pipe is idle or not present: 0=Busy: 1=Idle or not present</description>
                  <bitRange>[16:16]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>AQHICLOCKCONTROL_IDLE2_D</name>
                  <description>2D pipe is idle or not present: 0=Busy: 1=Idle or not present</description>
                  <bitRange>[17:17]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>AQHICLOCKCONTROL_IDLE_VG</name>
                  <description>VG pipe is idle: 0=Busy: 1=Idle or not present</description>
                  <bitRange>[18:18]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>AQHICLOCKCONTROL_ISOLATE_GPU</name>
                  <description>N/A</description>
                  <bitRange>[19:19]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>AQHICLOCKCONTROL_RSVD_4</name>
                  <description>N/A</description>
                  <bitRange>[28:20]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>AQHICLOCKCONTROL_RSVD_5</name>
                  <description>N/A</description>
                  <bitRange>[31:29]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>AQHIIDLE</name>
              <description>Idle Status Register.</description>
              <addressOffset>0x4</addressOffset>
              <size>32</size>
              <access>read-only</access>
              <resetValue>0x7FFFFFFF</resetValue>
              <resetMask>0xFFFFFFFF</resetMask>
              <fields>
                <field>
                  <name>AQHIIDLE_IDLE_FE</name>
                  <description>FE (Fetch Engine): 0=FE is busy; 1=FE is idle.</description>
                  <bitRange>[0:0]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>AQHIIDLE_IDLE_DE</name>
                  <description>N/A</description>
                  <bitRange>[1:1]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>AQHIIDLE_IDLE_PE</name>
                  <description>PE (Pixel Engine): 0=Busy: 1=Idle or not present</description>
                  <bitRange>[2:2]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>AQHIIDLE_IDLE_SH</name>
                  <description>N/A</description>
                  <bitRange>[3:3]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>AQHIIDLE_IDLE_PA</name>
                  <description>N/A</description>
                  <bitRange>[4:4]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>AQHIIDLE_IDLE_SE</name>
                  <description>N/A</description>
                  <bitRange>[5:5]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>AQHIIDLE_IDLE_RA</name>
                  <description>N/A</description>
                  <bitRange>[6:6]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>AQHIIDLE_IDLE_TX</name>
                  <description>N/A</description>
                  <bitRange>[7:7]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>AQHIIDLE_IDLE_VG</name>
                  <description>VG (Vector Graphics Engine): 1= VG is idle: 0=Busy: 1=Idle or not present</description>
                  <bitRange>[8:8]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>AQHIIDLE_IDLE_IM</name>
                  <description>IM (Image Engine): 1= IM is idle: 0=Busy: 1=Idle or not present</description>
                  <bitRange>[9:9]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>AQHIIDLE_IDLE_FP</name>
                  <description>N/A</description>
                  <bitRange>[10:10]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>AQHIIDLE_IDLE_TS</name>
                  <description>TS (Tessellation Engine): 0=Busy: 1=Idle or not present</description>
                  <bitRange>[11:11]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>AQHIIDLE_IDLE_BLT</name>
                  <description>N/A</description>
                  <bitRange>[12:12]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>AQHIIDLE_UNUSED</name>
                  <description>N/A</description>
                  <bitRange>[30:13]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>AQHIIDLE_AXI_LP</name>
                  <description>AXI low power mode: 0=not in low power mode; 1=in low power mode.
Using the AXI low power interface to make the GPU enter a low power mode will set this bit to 1.</description>
                  <bitRange>[31:31]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>AQAXICONFIG</name>
              <description>AXI Configuration Register.</description>
              <addressOffset>0x8</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x222200</resetValue>
              <resetMask>0xFFFFFFFF</resetMask>
              <fields>
                <field>
                  <name>AQAXICONFIG_RSVD_1</name>
                  <description>N/A</description>
                  <bitRange>[7:0]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>AQAXICONFIG_AWCACHE</name>
                  <description>Set AWCACHE[3:0] value.</description>
                  <bitRange>[11:8]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>AQAXICONFIG_ARCACHE</name>
                  <description>Set ARCACHE[3:0] value.</description>
                  <bitRange>[15:12]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>AQAXICONFIG_AXDOMAIN_SHARED</name>
                  <description>Configure AxDOMAIN value for shareable request. Not used for VG cores</description>
                  <bitRange>[17:16]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>AQAXICONFIG_AXDOMAIN_NON_SHARED</name>
                  <description>Configure AxDOMAIN value for non-shareable request. Not used for VG cores</description>
                  <bitRange>[19:18]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>AQAXICONFIG_AXCACHE_OVERRIDE_SHARED</name>
                  <description>Configure AxCACHE value for shareable request. Not used for VG cores</description>
                  <bitRange>[23:20]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>AQAXICONFIG_RSVD_2</name>
                  <description>N/A</description>
                  <bitRange>[31:24]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>AQAXISTATUS</name>
              <description>AXI Status Register. READ ONLY. Back-to-back read is forbidden to this register and can cause system hang. Please insert delay (nop operation) between two consecutive reads while accessing this register outside of VSI drivers.</description>
              <addressOffset>0xC</addressOffset>
              <size>32</size>
              <access>read-only</access>
              <resetValue>0x0</resetValue>
              <resetMask>0xFFFFFFFF</resetMask>
              <fields>
                <field>
                  <name>AQAXISTATUS_WR_ERR_ID</name>
                  <description>The ID which caused illegal write access error.</description>
                  <bitRange>[3:0]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>AQAXISTATUS_RD_ERR_ID</name>
                  <description>The ID which caused illegal read access error.</description>
                  <bitRange>[7:4]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>AQAXISTATUS_DET_WR_ERR</name>
                  <description>1=A write error is detected.</description>
                  <bitRange>[8:8]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>AQAXISTATUS_DET_RD_ERR</name>
                  <description>1=A read error is detected.</description>
                  <bitRange>[9:9]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>AQAXISTATUS_RSVD</name>
                  <description>N/A</description>
                  <bitRange>[31:10]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>AQINTRACKNOWLEDGE</name>
              <description>Interrupt Acknowledge Register.  Each bit represents a  corresponding event being triggered.  Reading from this  register clears the outstanding interrupt.  READ ONLY. When the access comes from a debugger (HMASTER[0] == 1), the clear by read function is disabled. Back-to-back read is forbidden to this register and can cause system hang. Please insert delay (nop operation) between two consecutive reads while accessing this register outside of VSI drivers.</description>
              <addressOffset>0x10</addressOffset>
              <size>32</size>
              <access>read-only</access>
              <resetValue>0x0</resetValue>
              <resetMask>0xFFFFFFFF</resetMask>
              <fields>
                <field>
                  <name>AQINTRACKNOWLEDGE_INTR_VEC</name>
                  <description>For each interrupt event, 0=Clear, 1=Interrupt Active.  For all cores: Bit 31 is AXI_BUS_ERROR. 0=No error, 1=Interrupt Active.</description>
                  <bitRange>[31:0]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>AQINTRENBL</name>
              <description>Interrupt Enable Register.  Each bit enables a corresponding  event.</description>
              <addressOffset>0x14</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x0</resetValue>
              <resetMask>0xFFFFFFFF</resetMask>
              <fields>
                <field>
                  <name>AQINTRENBL_INTR_ENBL_VEC</name>
                  <description>0=Disable Interrupt; 1=Enable interrupt.</description>
                  <bitRange>[31:0]</bitRange>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>GCCHIPREV</name>
              <description>Chip Revsion Register.  Shows the revision for the chip in BCD.  This register has no set reset value.  It varies with the implementation. READ ONLY.</description>
              <addressOffset>0x24</addressOffset>
              <size>32</size>
              <access>read-only</access>
              <resetValue>0x0</resetValue>
              <resetMask>0x0</resetMask>
              <fields>
                <field>
                  <name>GCCHIPREV_REV</name>
                  <description>Revision. This value may vary between releases and can be ignored during test.</description>
                  <bitRange>[31:0]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>GCCHIPDATE</name>
              <description>Chip Date Register.  Shows the release date for the IP in YYYYMMDD (year/month/day) format.   This register has no set reset value.  It varies with the implementation. READ ONLY.</description>
              <addressOffset>0x28</addressOffset>
              <size>32</size>
              <access>read-only</access>
              <resetValue>0x0</resetValue>
              <resetMask>0x0</resetMask>
              <fields>
                <field>
                  <name>GCCHIPDATE_DATE</name>
                  <description>Date. This value will vary each release and can be ignored during test.</description>
                  <bitRange>[31:0]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>GCREGHICHIPPATCHREV</name>
              <description>Chip Patch Revision Register.  Patch revision level for the chip. It varies per release. READ ONLY</description>
              <addressOffset>0x98</addressOffset>
              <size>32</size>
              <access>read-only</access>
              <resetValue>0x0</resetValue>
              <resetMask>0xFFFFFF00</resetMask>
              <fields>
                <field>
                  <name>GCREGHICHIPPATCHREV_PATCH_REV</name>
                  <description>Patch Revision. This value will vary each release and can be ignored during test.</description>
                  <bitRange>[7:0]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>GCREGHICHIPPATCHREV_RSVD</name>
                  <description>N/A</description>
                  <bitRange>[31:8]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>GCPRODUCTID</name>
              <description>Product Identification Register.  Shows Product ID. READ ONLY.</description>
              <addressOffset>0xA8</addressOffset>
              <size>32</size>
              <access>read-only</access>
              <resetValue>0x3002655</resetValue>
              <resetMask>0xFFFFFFFF</resetMask>
              <fields>
                <field>
                  <name>GCPRODUCTID_GRADE_LEVEL</name>
                  <description>0:None-no extra letter on the product name for this core; 1:Nano; 5:NanoUltra.</description>
                  <bitRange>[3:0]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>GCPRODUCTID_NUM</name>
                  <description>Product number is 265.</description>
                  <bitRange>[23:4]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>GCPRODUCTID_TYPE</name>
                  <description>Product Type is 3: VG (Vector Graphics).</description>
                  <bitRange>[27:24]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>GCPRODUCTID_RSVD</name>
                  <description>N/A</description>
                  <bitRange>[31:28]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>GCMODULEPOWERCONTROLS</name>
              <description>Module Power Control Register.  Control register for module level power controls.</description>
              <addressOffset>0x100</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x140020</resetValue>
              <resetMask>0xFFFFFFFF</resetMask>
              <fields>
                <field>
                  <name>GCMODULEPOWERCONTROLS_ENABLE_MODULE_CLOCK_GATING</name>
                  <description>0=module clock always on
1=If the corresponding bit in GCMODULEPOWERMODULECONTROL is configured as 0, the clock will be turned off when the module is not working.</description>
                  <bitRange>[0:0]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>GCMODULEPOWERCONTROLS_DISABLE_STALL_MODULE_CLOCK_GATING</name>
                  <description>Disables module level clock gating for stall condition: 0=module clock can be turned off for stall condition
1=module clock can not be turned off for stall condition</description>
                  <bitRange>[1:1]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>GCMODULEPOWERCONTROLS_DISABLE_STARVE_MODULE_CLOCK_GATING</name>
                  <description>Disables module level clock gating for starve/idle condition:0=module clock can be turned off for starve/idle condition
1=module clock can not be turned off for starve/idle condition</description>
                  <bitRange>[2:2]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>GCMODULEPOWERCONTROLS_RSVD_1</name>
                  <description>N/A</description>
                  <bitRange>[3:3]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>GCMODULEPOWERCONTROLS_TURN_ON_COUNTER</name>
                  <description>Number of clock cycles to wait after turning on the clock: 0-15 cycles</description>
                  <bitRange>[7:4]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>GCMODULEPOWERCONTROLS_RSVD_2</name>
                  <description>N/A</description>
                  <bitRange>[15:8]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>GCMODULEPOWERCONTROLS_TURN_OFF_COUNTER</name>
                  <description>Counter value for clock gating the module if the module is idle for  this amount of clock cycles.</description>
                  <bitRange>[31:16]</bitRange>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>GCMODULEPOWERMODULECONTROL</name>
              <description>Module Power Module Control Register.  Module level control register.</description>
              <addressOffset>0x104</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x0</resetValue>
              <resetMask>0xFFFFFFFF</resetMask>
              <fields>
                <field>
                  <name>GCMODULEPOWERMODULECONTROL_DISABLE_MODULE_CLOCK_GATING_FE</name>
                  <description>Disables module level clock gating for FE( Fetch Engine): 0=the module clock can be turned off when the module not working
1=the module clock always on</description>
                  <bitRange>[0:0]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>GCMODULEPOWERMODULECONTROL_RSVD_1</name>
                  <description>N/A</description>
                  <bitRange>[1:1]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>GCMODULEPOWERMODULECONTROL_DISABLE_MODULE_CLOCK_GATING_PE</name>
                  <description>Disables module level clock gating for PE(Pixel Engine) : 0=the module clock can be turned off when the module not working
1=the module clock always on</description>
                  <bitRange>[2:2]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>GCMODULEPOWERMODULECONTROL_RSVD_2</name>
                  <description>N/A</description>
                  <bitRange>[7:3]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>GCMODULEPOWERMODULECONTROL_DISABLE_MODULE_CLOCK_GATING_VG</name>
                  <description>Disables module level clock gating for VG(Vector Graphics Engine): 0=the module clock can be turned off when the module not working
1=the module clock always on</description>
                  <bitRange>[8:8]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>GCMODULEPOWERMODULECONTROL_DISABLE_MODULE_CLOCK_GATING_IM</name>
                  <description>Disables module level clock gating for IM(Image Engine): 0=the module clock can be turned off when the module not working
1=the module clock always on</description>
                  <bitRange>[9:9]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>GCMODULEPOWERMODULECONTROL_RSVD_3</name>
                  <description>N/A</description>
                  <bitRange>[10:10]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>GCMODULEPOWERMODULECONTROL_DISABLE_MODULE_CLOCK_GATING_TS</name>
                  <description>Disables module level clock gating for TS(Tessellation Engine): 0=the module clock can be turned off when the module not working
1=the module clock always on</description>
                  <bitRange>[11:11]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>GCMODULEPOWERMODULECONTROL_DISABLE_MODULE_CLOCK_GATING_FLEXA</name>
                  <description>N/A</description>
                  <bitRange>[12:12]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>GCMODULEPOWERMODULECONTROL_RSVD_4</name>
                  <description>N/A</description>
                  <bitRange>[31:13]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>GCMODULEPOWERMODULESTATUS</name>
              <description>Module Power Module Status Register.  Module level control status.</description>
              <addressOffset>0x108</addressOffset>
              <size>32</size>
              <access>read-only</access>
              <resetValue>0x0</resetValue>
              <resetMask>0xFFFFFBFF</resetMask>
              <fields>
                <field>
                  <name>GCMODULEPOWERMODULESTATUS_MODULE_CLOCK_GATED_FE</name>
                  <description>Module level clock gating is ON for FE: 0=FE module clock is turned on.
1=FE module clock is turned off.</description>
                  <bitRange>[0:0]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>GCMODULEPOWERMODULESTATUS_RSVD_1</name>
                  <description>N/A</description>
                  <bitRange>[1:1]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>GCMODULEPOWERMODULESTATUS_MODULE_CLOCK_GATED_PE</name>
                  <description>Module level clock gating is ON for PE: 0=PE module clock is turned on.
1=PE module clock is turned off.</description>
                  <bitRange>[2:2]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>GCMODULEPOWERMODULESTATUS_RSVD_2</name>
                  <description>N/A</description>
                  <bitRange>[7:3]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>GCMODULEPOWERMODULESTATUS_MODULE_CLOCK_GATED_VG</name>
                  <description>Module level clock gating is ON for VG: 0=VG module clock is turned on.
1=VG module clock is turned off.</description>
                  <bitRange>[8:8]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>GCMODULEPOWERMODULESTATUS_MODULE_CLOCK_GATED_IM</name>
                  <description>Module level clock gating is ON for IM: 0=IM module clock is turned on.
1=IM module clock is turned off.</description>
                  <bitRange>[9:9]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>GCMODULEPOWERMODULESTATUS_MODULE_CLOCK_GATED_TS</name>
                  <description>Module level clock gating is ON for TS: 0=TS module clock is turned on.
1=TS module clock is turned off.</description>
                  <bitRange>[11:11]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>GCMODULEPOWERMODULESTATUS_MODULE_CLOCK_GATED_FLEXA</name>
                  <description>N/A</description>
                  <bitRange>[12:12]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>GCMODULEPOWERMODULESTATUS_RSVD_3</name>
                  <description>N/A</description>
                  <bitRange>[31:13]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>AQMEMORYDEBUG</name>
              <description>Memory Debug Register.</description>
              <addressOffset>0x414</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x0</resetValue>
              <resetMask>0xFFFFFFFF</resetMask>
              <fields>
                <field>
                  <name>AQMEMORYDEBUG_MAX_OUTSTANDING_READS</name>
                  <description>Limits the total number of outstanding read requests.</description>
                  <bitRange>[7:0]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>AQMEMORYDEBUG_RSVD_1</name>
                  <description>N/A</description>
                  <bitRange>[15:8]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>AQMEMORYDEBUG_RSVD_2</name>
                  <description>N/A</description>
                  <bitRange>[16:16]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>AQMEMORYDEBUG_RSVD_3</name>
                  <description>N/A</description>
                  <bitRange>[18:17]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>AQMEMORYDEBUG_RSVD_4</name>
                  <description>N/A</description>
                  <bitRange>[23:19]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>AQMEMORYDEBUG_RSVD_5</name>
                  <description>N/A</description>
                  <bitRange>[31:24]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>AQREGISTERTIMINGCONTROL</name>
              <description>Timing Control Register.</description>
              <addressOffset>0x42C</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x30000</resetValue>
              <resetMask>0xFFFFFFFF</resetMask>
              <fields>
                <field>
                  <name>AQREGISTERTIMINGCONTROL_FOR_RF1P</name>
                  <description>N/A</description>
                  <bitRange>[7:0]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>AQREGISTERTIMINGCONTROL_FOR_RF2P</name>
                  <description>N/A</description>
                  <bitRange>[15:8]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>AQREGISTERTIMINGCONTROL_FAST_RTC</name>
                  <description>N/A</description>
                  <bitRange>[17:16]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>AQREGISTERTIMINGCONTROL_FAST_WTC</name>
                  <description>N/A</description>
                  <bitRange>[19:18]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>AQREGISTERTIMINGCONTROL_POWER_DOWN</name>
                  <description>N/A</description>
                  <bitRange>[20:20]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>AQREGISTERTIMINGCONTROL_RSVD</name>
                  <description>N/A</description>
                  <bitRange>[31:21]</bitRange>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>GCREGFETCHADDRESS</name>
              <description>Fetch Command Buffer Base Address Register.  Address of the command buffer. The address must be 64-byte aligned.</description>
              <addressOffset>0x500</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x0</resetValue>
              <resetMask>0xFFFFFFFF</resetMask>
              <fields>
                <field>
                  <name>GCREGFETCHADDRESS_TYPE</name>
                  <description>N/A</description>
                  <bitRange>[1:0]</bitRange>
                  <access>read-write</access>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>SYSTEM</name>
                      <description>(none)</description>
                      <value>0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>VIRTUAL</name>
                      <description>(none)</description>
                      <value>2</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>LOCAL</name>
                      <description>(none)</description>
                      <value>1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>GCREGFETCHADDRESS_ADDRESS</name>
                  <description>fetch address</description>
                  <bitRange>[31:2]</bitRange>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>GCREGFETCHCONTROL</name>
              <description>Fetch Control Register.  Writing a non-zero value to this register starts the fetch  engine.  The FE will start fetching 64-bit commands and data  starting at the address specified by the gcregFetchAddress  register.  Make sure this count is large enough to fetch the  END command, otherwise the FE will wait until more data is  coming.</description>
              <addressOffset>0x504</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x0</resetValue>
              <resetMask>0xFFFFFFFF</resetMask>
              <fields>
                <field>
                  <name>GCREGFETCHCONTROL_COUNT</name>
                  <description>Number of 64-bit words to fetch.  21 bits is enough for 16 MB.</description>
                  <bitRange>[20:0]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>GCREGFETCHCONTROL_RSVD</name>
                  <description>N/A</description>
                  <bitRange>[31:21]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>GCREGCURRENTFETCHADDRESS</name>
              <description>Current Fetch Command Address Register.  Debugging register that defines the current address the FE is  fetching data from. READ ONLY.</description>
              <addressOffset>0x508</addressOffset>
              <size>32</size>
              <access>read-only</access>
              <resetValue>0x0</resetValue>
              <resetMask>0xFFFFFFFF</resetMask>
              <fields>
                <field>
                  <name>GCREGCURRENTFETCHADDRESS_ADDRESS</name>
                  <description>(none)</description>
                  <bitRange>[31:0]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
          </cluster>
        </cluster>
        <cluster>
          <name>GFXSS_DC</name>
          <description>Display Controller.</description>
          <headerStructName>GFXSS_DC</headerStructName>
          <addressOffset>0x00001000</addressOffset>
          <cluster>
            <name>MXDC</name>
            <description>Platform IP standard configuration for DC.</description>
            <headerStructName>GFXSS_DC_MXDC</headerStructName>
            <addressOffset>0x00000000</addressOffset>
            <register>
              <name>CTL</name>
              <description>IP control.</description>
              <addressOffset>0x0</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x0</resetValue>
              <resetMask>0x80000000</resetMask>
              <fields>
                <field>
                  <name>ENABLED</name>
                  <description>IP enable bit. When disabled (value 0), the functional state of the DCNano core is reset and its clock input gated. Access to MMIO of the core results in an AHB error response. Note, that the effect of this bit is delayed (see STATUS.CORE_RST). The core must be idle (no outstanding or pending AXI transactions) before clearing this bit.</description>
                  <bitRange>[31:31]</bitRange>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>CLK_CTL</name>
              <description>Clock control.</description>
              <addressOffset>0x4</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x2000001</resetValue>
              <resetMask>0xFFFFFFC1</resetMask>
              <fields>
                <field>
                  <name>CLK_CORE</name>
                  <description>Setup for DC core and AXI clock. Must only be set to 0 if clk_hf is not faster than 200 MHz. Change only while CTL.ENABLED is off.</description>
                  <bitRange>[0:0]</bitRange>
                  <access>read-write</access>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>HF_DIV1</name>
                      <description>Core clock is clk_hf.</description>
                      <value>0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>HF_DIV2</name>
                      <description>Core clock is clk_hf divided by 2.</description>
                      <value>1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>CLK_DIV</name>
                  <description>Setup of the fractional divider to generate clk_hf_div. In DPI mode the output is the pixel clock. In DBI Type C mode it's two times the serial clock. Format of programmed value is unsigned fix-point 10.16. It must not be set to a value smaller than 2.0 (= 0x020000). It can be set to 0, which results in no clock being generated. Change only while CTL.ENABLED is off.</description>
                  <bitRange>[31:6]</bitRange>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>IO_CTL</name>
              <description>IO enable control.</description>
              <addressOffset>0x8</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x10103</resetValue>
              <resetMask>0x10103</resetMask>
              <fields>
                <field>
                  <name>SPI_ENABLED</name>
                  <description>Enable control for IO cells in DBI Type C mode (1 = enabled). CTL.ENABLED must also be 1.</description>
                  <bitRange>[0:0]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>SPI_SDOEN</name>
                  <description>Controls if the enable for spi_dout is separately controlled by the DCNano core with dbiTypecSdoEn signal (0 = yes, 1 = no). Field has no effect if SPI_ENABLED is 0.</description>
                  <bitRange>[1:1]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>DPI_ENABLED</name>
                  <description>Enable control for IO cells in DPI mode (1 = enabled). CTL.ENABLED must also be 1.</description>
                  <bitRange>[8:8]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>DBI_ENABLED</name>
                  <description>Enable control for IO cells in DBI Type A/B mode (1 = enabled). CTL.ENABLED must also be 1.</description>
                  <bitRange>[16:16]</bitRange>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>STATUS</name>
              <description>IP status.</description>
              <addressOffset>0xC</addressOffset>
              <size>32</size>
              <access>read-only</access>
              <resetValue>0x1</resetValue>
              <resetMask>0x1</resetMask>
              <fields>
                <field>
                  <name>CORE_RST</name>
                  <description>Reset state of the DCNano core (1 = in reset). This state is delayed to GFXSS_DC reset. After reset de-activation it has to be checked for value 0 before the core can be used. After activation it has to be checked for value 1 before turning off the external clk_hf source.</description>
                  <bitRange>[0:0]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>INTR</name>
              <description>Interrupt status.</description>
              <addressOffset>0x10</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x0</resetValue>
              <resetMask>0x10F01</resetMask>
              <fields>
                <field>
                  <name>CORE</name>
                  <description>DCNano core has signalled an interrupt. Writing a '1' to this field will reset the bit. Interrupt status inside the core is not affected by this.</description>
                  <bitRange>[0:0]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>ADDR0</name>
                  <description>Read access to INT_ADDR0 completed. Writing a '1' to this field will reset the bit.</description>
                  <bitRange>[8:8]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>ADDR1</name>
                  <description>Read access to INT_ADDR1 completed. Writing a '1' to this field will reset the bit.</description>
                  <bitRange>[9:9]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>ADDR2</name>
                  <description>Read access to INT_ADDR2 completed. Writing a '1' to this field will reset the bit.</description>
                  <bitRange>[10:10]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>ADDR3</name>
                  <description>Read access to INT_ADDR3 completed. Writing a '1' to this field will reset the bit.</description>
                  <bitRange>[11:11]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>RLAD_ERROR</name>
                  <description>The RLAD decoder has entered fail state (see RLAD_STATUS register). Writing a '1' to this field will reset the bit.</description>
                  <bitRange>[16:16]</bitRange>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>INTR_SET</name>
              <description>Interrupt set bits.</description>
              <addressOffset>0x14</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x0</resetValue>
              <resetMask>0x10F01</resetMask>
              <fields>
                <field>
                  <name>CORE_SET</name>
                  <description>Write this field with '1' to set corresponding INTR field (a write of '0' has no effect).</description>
                  <bitRange>[0:0]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>ADDR0_SET</name>
                  <description>Write this field with '1' to set corresponding INTR field (a write of '0' has no effect).</description>
                  <bitRange>[8:8]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>ADDR1_SET</name>
                  <description>Write this field with '1' to set corresponding INTR field (a write of '0' has no effect).</description>
                  <bitRange>[9:9]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>ADDR2_SET</name>
                  <description>Write this field with '1' to set corresponding INTR field (a write of '0' has no effect).</description>
                  <bitRange>[10:10]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>ADDR3_SET</name>
                  <description>Write this field with '1' to set corresponding INTR field (a write of '0' has no effect).</description>
                  <bitRange>[11:11]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>RLAD_ERROR_SET</name>
                  <description>Write this field with '1' to set corresponding INTR field (a write of '0' has no effect).</description>
                  <bitRange>[16:16]</bitRange>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>INTR_MASK</name>
              <description>Interrupt mask bits.</description>
              <addressOffset>0x18</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x0</resetValue>
              <resetMask>0x10F01</resetMask>
              <fields>
                <field>
                  <name>CORE_MASK</name>
                  <description>Mask for corresponding field in INTR register.</description>
                  <bitRange>[0:0]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>ADDR0_MASK</name>
                  <description>Mask for corresponding field in INTR register.</description>
                  <bitRange>[8:8]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>ADDR1_MASK</name>
                  <description>Mask for corresponding field in INTR register.</description>
                  <bitRange>[9:9]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>ADDR2_MASK</name>
                  <description>Mask for corresponding field in INTR register.</description>
                  <bitRange>[10:10]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>ADDR3_MASK</name>
                  <description>Mask for corresponding field in INTR register.</description>
                  <bitRange>[11:11]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>RLAD_ERROR_MASK</name>
                  <description>Mask for corresponding field in INTR register.</description>
                  <bitRange>[16:16]</bitRange>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>INTR_MASKED</name>
              <description>Interrupt masked bits.</description>
              <addressOffset>0x1C</addressOffset>
              <size>32</size>
              <access>read-only</access>
              <resetValue>0x0</resetValue>
              <resetMask>0x10F01</resetMask>
              <fields>
                <field>
                  <name>CORE_MASKED</name>
                  <description>Logical AND of corresponding INTR and INTR_MASK fields.</description>
                  <bitRange>[0:0]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>ADDR0_MASKED</name>
                  <description>Logical AND of corresponding INTR and INTR_MASK fields.</description>
                  <bitRange>[8:8]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>ADDR1_MASKED</name>
                  <description>Logical AND of corresponding INTR and INTR_MASK fields.</description>
                  <bitRange>[9:9]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>ADDR2_MASKED</name>
                  <description>Logical AND of corresponding INTR and INTR_MASK fields.</description>
                  <bitRange>[10:10]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>ADDR3_MASKED</name>
                  <description>Logical AND of corresponding INTR and INTR_MASK fields.</description>
                  <bitRange>[11:11]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>RLAD_ERROR_MASKED</name>
                  <description>Logical AND of corresponding INTR and INTR_MASK fields.</description>
                  <bitRange>[16:16]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>ADDR0_INT</name>
              <description>Address 0 for interrupt generation.</description>
              <addressOffset>0x20</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x0</resetValue>
              <resetMask>0xFFFFFFFF</resetMask>
              <fields>
                <field>
                  <name>ADDR0_INT</name>
                  <description>A completed read access to this memory address will set INTR.ADDR0. The shadow values of all address fields are copied into the active configuration when a display frame has completed and GCREGPANELCONTROL_VALID was set before in DCNANO.</description>
                  <bitRange>[31:0]</bitRange>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>ADDR1_INT</name>
              <description>Address 1 for interrupt generation.</description>
              <addressOffset>0x24</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x0</resetValue>
              <resetMask>0xFFFFFFFF</resetMask>
              <fields>
                <field>
                  <name>ADDR1_INT</name>
                  <description>A completed read access to this memory address will set INTR.ADDR1.</description>
                  <bitRange>[31:0]</bitRange>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>ADDR2_INT</name>
              <description>Address 2 for interrupt generation.</description>
              <addressOffset>0x28</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x0</resetValue>
              <resetMask>0xFFFFFFFF</resetMask>
              <fields>
                <field>
                  <name>ADDR2_INT</name>
                  <description>A completed read access to this memory address will set INTR.ADDR2.</description>
                  <bitRange>[31:0]</bitRange>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>ADDR3_INT</name>
              <description>Address 3 for interrupt generation.</description>
              <addressOffset>0x2C</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x0</resetValue>
              <resetMask>0xFFFFFFFF</resetMask>
              <fields>
                <field>
                  <name>ADDR3_INT</name>
                  <description>A completed read access to this memory address will set INTR.ADDR3.</description>
                  <bitRange>[31:0]</bitRange>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>RLAD_CTL</name>
              <description>Control options for the RLAD decoder.</description>
              <addressOffset>0x40</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x0</resetValue>
              <resetMask>0x301</resetMask>
              <fields>
                <field>
                  <name>RLAD_ENABLE</name>
                  <description>When set to 0, the RLAD decoder is disabled. It's clock tree is gated and the functional logic reset. All RLAD configuration fields, including this enable field, are shadowed. The shadow values are copied into the active configuration when a display frame has completed and GCREGPANELCONTROL_VALID was set before in DCNANO. Once the load of shadows has been initiated by setting the VALID flag, the RLAD configuration fields must not be changed again before the frame complete interrupt. Beside inconsistent setup for a display frame, this can lead to data corruption of the active configuration.</description>
                  <bitRange>[0:0]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>RLAD_LAYER</name>
                  <description>N/A</description>
                  <bitRange>[9:8]</bitRange>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>RLAD_IMG</name>
              <description>Properties of the uncompressed image.</description>
              <addressOffset>0x44</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x40000000</resetValue>
              <resetMask>0xF3FFCFFF</resetMask>
              <fields>
                <field>
                  <name>RLAD_WIDTH</name>
                  <description>Width of the image in number of pixels minus one. The DC layer must be setup for the same width.</description>
                  <bitRange>[11:0]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>RLAD_HEIGHT</name>
                  <description>Height of the image in number of lines minus one. The DC layer must be setup for the same height.</description>
                  <bitRange>[25:14]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>RLAD_FORMAT</name>
                  <description>Color format of the uncompressed image. The RLAD block converts the configured format after decompression to ARGB8888, which is the format the DC layer has to be configured for (in linear order and with component swizzle ARGB). Alpha value is set to 255 for RGB and GRAY formats.</description>
                  <bitRange>[31:28]</bitRange>
                  <access>read-write</access>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>ARGB4444</name>
                      <description>N/A</description>
                      <value>1</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ARGB1555</name>
                      <description>N/A</description>
                      <value>2</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>RGB565</name>
                      <description>N/A</description>
                      <value>3</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ARGB8888</name>
                      <description>N/A</description>
                      <value>4</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>RGB888</name>
                      <description>N/A</description>
                      <value>5</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>RGB666</name>
                      <description>N/A</description>
                      <value>6</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>RGB444</name>
                      <description>N/A</description>
                      <value>7</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>GRAY8</name>
                      <description>N/A</description>
                      <value>8</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>GRAY6</name>
                      <description>N/A</description>
                      <value>9</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>GRAY4</name>
                      <description>N/A</description>
                      <value>10</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
              </fields>
            </register>
            <register>
              <name>RLAD_ENC</name>
              <description>Configuration of the encoder that compressed the image.</description>
              <addressOffset>0x48</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x88880000</resetValue>
              <resetMask>0xFFFF0003</resetMask>
              <fields>
                <field>
                  <name>RLAD_MODE</name>
                  <description>Encoding mode.</description>
                  <bitRange>[1:0]</bitRange>
                  <access>read-write</access>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>RLAD</name>
                      <description>Run-Length Adaptive Dithering (lossy).</description>
                      <value>0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>RLAD_UNIFORM</name>
                      <description>RLAD with uniform package size (less efficient, but can force a consistent read bandwidth if needed).</description>
                      <value>1</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>RLA</name>
                      <description>Run-Length Adaptive (lossless).</description>
                      <value>2</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>RL</name>
                      <description>Standard Run-Length (lossless).</description>
                      <value>3</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>RLAD_BITS_R</name>
                  <description>Max number of red channel bits (used for RLAD modes only).</description>
                  <bitRange>[19:16]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>RLAD_BITS_G</name>
                  <description>Max number of green channel bits (used for RLAD modes only).</description>
                  <bitRange>[23:20]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>RLAD_BITS_B</name>
                  <description>Max number of blue channel bits (used for RLAD modes only).</description>
                  <bitRange>[27:24]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>RLAD_BITS_A</name>
                  <description>Max number of alpha channel bits (used for RLAD modes only).</description>
                  <bitRange>[31:28]</bitRange>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>RLAD_BUF0</name>
              <description>Properties of the compressed image data buffer.</description>
              <addressOffset>0x4C</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x0</resetValue>
              <resetMask>0xFFFFFF80</resetMask>
              <fields>
                <field>
                  <name>RLAD_ADDRESS</name>
                  <description>Base address of the encoded image buffer in multiple of 128 bytes. The DC layer must be configured to the same base address and with the smallest possible stride value (aligned to 128 bytes).</description>
                  <bitRange>[31:7]</bitRange>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>RLAD_BUF1</name>
              <description>Properties of the compressed image data buffer.</description>
              <addressOffset>0x50</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x0</resetValue>
              <resetMask>0x1FFFFFFF</resetMask>
              <fields>
                <field>
                  <name>RLAD_SIZE</name>
                  <description>Size of the the encoded image in number of 32-bit words minus one. The buffer must be readable to the subsequent 128 bytes boundary.</description>
                  <bitRange>[28:0]</bitRange>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>RLAD_STATUS</name>
              <description>RLAD decoder status.</description>
              <addressOffset>0x54</addressOffset>
              <size>32</size>
              <access>read-only</access>
              <resetValue>0x0</resetValue>
              <resetMask>0x7</resetMask>
              <fields>
                <field>
                  <name>RLAD_FAILED</name>
                  <description>The fail state is activated in case an error condition has been detected. This will also trigger the RLAD_ERROR interrupt. In that state the RLAD decoding process is stopped and the DC will only read null data. No more read accesses to the memory buffer are generated. The fail state is quit by disabling the DC via CTL.ENABLED.</description>
                  <bitRange>[2:0]</bitRange>
                  <access>read-only</access>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>OFF</name>
                      <description>No fail state (= normal operation).</description>
                      <value>0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>AXI_ERROR</name>
                      <description>An AXI error response was received when reading compressed image data.</description>
                      <value>1</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>BUF_TOO_SMALL</name>
                      <description>The RLAD_SIZE setting is inconsistent with the compressed image data (image decompression not complete when end of buffer was reached).</description>
                      <value>2</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>BUF_TOO_LARGE</name>
                      <description>The RLAD_SIZE setting is inconsistent with the compressed image data (image decompression completed before end of buffer was reached).</description>
                      <value>3</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>DC_INVALID_SIZE</name>
                      <description>The DC was reading the first pixel of a frame when it was not expected. This means an inconsistent setup of RLAD and DC configuration.</description>
                      <value>4</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>DC_INVALID_FORMAT</name>
                      <description>The DC was reading data with an unexpected burst length. This means an invalid buffer format was configured.</description>
                      <value>5</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
              </fields>
            </register>
            <register>
              <name>IPIDENTIFIER</name>
              <description>GFXSS IP and desig release identification (with DC, GPU and MIPIDSI).</description>
              <addressOffset>0x70</addressOffset>
              <size>32</size>
              <access>read-only</access>
              <resetValue>0x0</resetValue>
              <resetMask>0x0</resetMask>
              <fields>
                <field>
                  <name>IPPLATFORM</name>
                  <description>Name of SOC Platform.</description>
                  <bitRange>[0:0]</bitRange>
                  <access>read-only</access>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>MXS22_S22</name>
                      <description>MXS22 Base Variant.</description>
                      <value>0</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>IPNAME</name>
                  <description>Name of IP family.</description>
                  <bitRange>[5:4]</bitRange>
                  <access>read-only</access>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>GFXSS</name>
                      <description>Graphics Subsystem with Display Controller for Low Power applications.</description>
                      <value>0</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>IPVERMAJOR</name>
                  <description>Major IP Version Number.</description>
                  <bitRange>[11:8]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>IPVERMINOR</name>
                  <description>Minor IP Version Number.</description>
                  <bitRange>[15:12]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>IPMATURITY</name>
                  <description>IP Maturity Status with Chip Integration Cycle targets (CIC).
This is independently set for each implementation type.</description>
                  <bitRange>[17:16]</bitRange>
                  <access>read-only</access>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>NONE</name>
                      <description>Undefined.</description>
                      <value>0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>CPR</name>
                      <description>Implementation incomplete (for CIC Physical Readiness Review).</description>
                      <value>1</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>CMR</name>
                      <description>Implementation complete (for CIC Mock Review).</description>
                      <value>2</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>CFR</name>
                      <description>Verification complete (for CIC Final Handoff Review).</description>
                      <value>3</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>IPRELEASE</name>
                  <description>Release ID.
This is independently set for each implementation type.
The value starts with 0 and is increased for every new release of a an IP project, which is defined by IPName, IPVERMAJOR and IPVERMINOR.</description>
                  <bitRange>[27:20]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>IPIMPLEMENTATION</name>
                  <description>Implementation type.</description>
                  <bitRange>[28:28]</bitRange>
                  <access>read-only</access>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>RTL</name>
                      <description>Logic design for FPGA and ASIC synthesis.</description>
                      <value>0</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
              </fields>
            </register>
          </cluster>
          <cluster>
            <name>DCNANO</name>
            <description>Host Interface Registers</description>
            <headerStructName>GFXSS_DC_DCNANO</headerStructName>
            <addressOffset>0x00000800</addressOffset>
            <register>
              <name>GCREGDCCHIPREV</name>
              <description>Chip Revision Register.  Shows the revision for the chip in BCD.  This register has no set reset  value. It varies with the implementation. READ ONLY.</description>
              <addressOffset>0x0</addressOffset>
              <size>32</size>
              <access>read-only</access>
              <resetValue>0x0</resetValue>
              <resetMask>0x0</resetMask>
              <fields>
                <field>
                  <name>GCREGDCCHIPREV_REV</name>
                  <description>Revision. The reset value for this field is subject to change and may be ignored during test.</description>
                  <bitRange>[31:0]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>GCREGDCCHIPDATE</name>
              <description>Chip Date Register.  Shows the release date for the IP in YYYYMMDD (year, month. day) format.  This register has no set reset value.  It varies with the implementation. READ ONLY.</description>
              <addressOffset>0x4</addressOffset>
              <size>32</size>
              <access>read-only</access>
              <resetValue>0x0</resetValue>
              <resetMask>0x0</resetMask>
              <fields>
                <field>
                  <name>GCREGDCCHIPDATE_DATE</name>
                  <description>Date. The reset value for this field changes per release and may be ignored during test. You can read the accurate value from the RTL file because the actual value may be later than the document release time.</description>
                  <bitRange>[31:0]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>GCREGDCCHIPPATCHREV</name>
              <description>Patch Revision Register.  Patch revision level for the chip. READ ONLY.</description>
              <addressOffset>0x8</addressOffset>
              <size>32</size>
              <access>read-only</access>
              <resetValue>0x0</resetValue>
              <resetMask>0x0</resetMask>
              <fields>
                <field>
                  <name>GCREGDCCHIPPATCHREV_PATCH_REV</name>
                  <description>Patch revision.  The reset value for this field changes per release and may be ignored during test. You can read the accurate value from the RTL file because the actual value may be later than the document release time.</description>
                  <bitRange>[31:0]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>GCREGDCPRODUCTID</name>
              <description>Product Identification Register. READ ONLY.</description>
              <addressOffset>0xC</addressOffset>
              <size>32</size>
              <access>read-only</access>
              <resetValue>0x2080001</resetValue>
              <resetMask>0xFFFFFFFF</resetMask>
              <fields>
                <field>
                  <name>GCREGDCPRODUCTID_PRODUCT_ID</name>
                  <description>Product ID.  Bits 3:0 contain Product GRADE_LEVEL. 1 indicates level is Nano.  Bits 23:4 contain Product NUM, product number. None for DCNano; 8000 for DC8000 Series.  Bits 27:24 contain Product TYPE. 2 indicates Display Controller.</description>
                  <bitRange>[31:0]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>GCREGFRAMEBUFFERCONFIG</name>
              <description>Frame Buffer Configuration Register.  Frame Buffer and Timing control.  NOTE.. This register is double buffered.</description>
              <addressOffset>0x24</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x0</resetValue>
              <resetMask>0xE042F</resetMask>
              <fields>
                <field>
                  <name>GCREGFRAMEBUFFERCONFIG_FORMAT</name>
                  <description>The format of the frame buffer.  None means there is no  frame buffer and the display controller will not produce  any output. NOTE: This field is double buffered.</description>
                  <bitRange>[2:0]</bitRange>
                  <access>read-write</access>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>NONE</name>
                      <description>(none)</description>
                      <value>0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>A4R4G4B4</name>
                      <description>(none)</description>
                      <value>1</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>A1R5G5B5</name>
                      <description>(none)</description>
                      <value>2</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>R5G6B5</name>
                      <description>(none)</description>
                      <value>3</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>A8R8G8B8</name>
                      <description>(none)</description>
                      <value>4</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>GCREGFRAMEBUFFERCONFIG_ENABLE</name>
                  <description>Enable this layer or disable this layer. NOTE: This field is double buffered.</description>
                  <bitRange>[3:3]</bitRange>
                  <access>read-write</access>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>DISABLED</name>
                      <description>(none)</description>
                      <value>0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ENABLED</name>
                      <description>(none)</description>
                      <value>1</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>GCREGFRAMEBUFFERCONFIG_CLEAR_EN</name>
                  <description>Enable or disable clear. NOTE: This field is double buffered.</description>
                  <bitRange>[5:5]</bitRange>
                  <access>read-write</access>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>DISABLED</name>
                      <description>(none)</description>
                      <value>0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>ENABLED</name>
                      <description>(none)</description>
                      <value>1</value>
                    </enumeratedValue>
