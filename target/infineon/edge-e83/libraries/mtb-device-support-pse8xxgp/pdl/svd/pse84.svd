            <name>CALMEM0</name>
            <description>SAR LP Core Channel Calibration Values</description>
            <addressOffset>0x40</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0x0</resetMask>
            <fields>
              <field>
                <name>LINBIT9</name>
