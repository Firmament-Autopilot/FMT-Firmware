        </cluster>
        <cluster>
          <name>BASE_POINTERS_1_0</name>
          <description>Page BASE_POINTERS</description>
          <addressOffset>0x00000080</addressOffset>
          <register>
            <name>BASEP0</name>
            <description>Lower 32 bits of the base pointer for region index 0</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>ADDR_WORD</name>
                <description>The low word of the 64-bit address</description>
                <bitRange>[31:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>BASEP1</name>
            <description>Upper 32-bits of the base pointer for region index 0</description>
            <addressOffset>0x4</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>ADDR_WORD</name>
                <description>The high word of the 64-bit address</description>
                <bitRange>[31:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>BASEP2</name>
            <description>Lower 32 bits of the base pointer for region index 1</description>
            <addressOffset>0x8</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>ADDR_WORD</name>
                <description>The low word of the 64-bit address</description>
                <bitRange>[31:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>BASEP3</name>
            <description>Upper 32-bits of the base pointer for region index 1</description>
            <addressOffset>0xC</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>ADDR_WORD</name>
                <description>The high word of the 64-bit address</description>
                <bitRange>[31:0]</bitRange>
