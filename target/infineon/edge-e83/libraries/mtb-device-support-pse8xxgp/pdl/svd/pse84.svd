                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>BUF0_COMP_TRIM</name>
            <description>Buffer zero trim control</description>
            <addressOffset>0x8</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xF</resetMask>
            <fields>
              <field>
                <name>BUF0_COMP_TRIM</name>
                <description>Buffer 0 Compensation Capacitor Trim

Bit&lt;3&gt; is not used

Bits&lt;2:0&gt;
000 = 0.1pF
001 = 1.1pF
010 = 2.1pF
011 = 3.1pF
100 = 4.1pF
101 = 5.1pF
110 = 6.1pF
111 = 7.1pF</description>
                <bitRange>[3:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>BUF1_OFFSET_TRIM</name>
            <description>Buffer one trim control</description>
            <addressOffset>0xC</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0x3F</resetMask>
            <fields>
              <field>
                <name>BUF1_OFFSET_TRIM</name>
                <description>buffer 1 offset trim</description>
                <bitRange>[5:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>BUF1_SLOPE_OFFSET_TRIM</name>
            <description>Buffer one trim control</description>
            <addressOffset>0x10</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0x3F</resetMask>
            <fields>
              <field>
                <name>BUF1_SLOPE_OFFSET_TRIM</name>
                <description>buffer 1 slope offset drift trim</description>
                <bitRange>[5:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>BUF1_COMP_TRIM</name>
            <description>Buffer one trim control</description>
            <addressOffset>0x14</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xF</resetMask>
            <fields>
              <field>
                <name>BUF1_COMP_TRIM</name>
                <description>see BUF0_COMP_TRIM</description>
                <bitRange>[3:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>RMP_TRIM</name>
            <description>Risk Mitigation bits</description>
            <addressOffset>0x18</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x11</resetValue>
            <resetMask>0x1F</resetMask>
            <fields>
              <field>
                <name>RMP_TRIM</name>
                <description>N/A</description>
                <bitRange>[3:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>TEMP_SENSOR_TRIM</name>
