                    <name>TXFIFO15</name>
                    <description>Tx FIFO 15</description>
                    <value>15</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>TXFIFO2</name>
                    <description>Tx FIFO 2</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>TXFIFO3</name>
                    <description>Tx FIFO 3</description>
                    <value>3</value>
                  </enumeratedValue>
