                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ENDPT13</name>
                    <description>End point 13</description>
                    <value>13</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ENDPT14</name>
                    <description>End point 14</description>
                    <value>14</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ENDPT15</name>
                    <description>End point 15</description>
                    <value>15</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ENDPT2</name>
                    <description>End point 2</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ENDPT3</name>
                    <description>End point 3</description>
                    <value>3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ENDPT4</name>
                    <description>End point 4</description>
                    <value>4</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ENDPT5</name>
                    <description>End point 5</description>
                    <value>5</value>
