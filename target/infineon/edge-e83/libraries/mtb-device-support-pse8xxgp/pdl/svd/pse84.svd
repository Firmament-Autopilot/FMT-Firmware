                    <name>FIFO_LEVEL4</name>
                    <description>FIFO Level 4 trigger</description>
                    <value>50</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>FIFO_LEVEL5</name>
                    <description>FIFO Level 5 trigger</description>
                    <value>51</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>FIFO_LEVEL6</name>
                    <description>FIFO Level 6 trigger</description>
                    <value>52</value>
