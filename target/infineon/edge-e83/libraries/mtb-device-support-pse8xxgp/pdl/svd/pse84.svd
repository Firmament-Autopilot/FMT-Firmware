        <cluster>
          <name>PAGE_PMU_1_0</name>
          <description>Page PMU</description>
          <addressOffset>0x00000100</addressOffset>
          <register>
            <name>PMCR</name>
            <description>PMU master control register</description>
            <addressOffset>0x80</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x2000</resetValue>
            <resetMask>0xF80F</resetMask>
            <fields>
              <field>
                <name>CNT_EN</name>
                <description>Enable counter.

This is the master switch. When the switch is disabled, the PMU is always off.</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>EVENT_CNT_RST</name>
                <description>Reset event counter.

Writing a 1 to this field resets all event counters. If any counter is active, it will continue counting after reset. This register bit always reads a 0.</description>
                <bitRange>[1:1]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>CYCLE_CNT_RST</name>
                <description>Reset cycle counter.

Writing a 1 to this register resets the cycle counter. If the cycle counter is active, it will continue counting after reset. This register bit always reads a 0.</description>
                <bitRange>[2:2]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>MASK_EN</name>
                <description>PMU can be enabled/disabled by command stream operation NPU_OP_PMU_MASK</description>
                <bitRange>[3:3]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>NUM_EVENT_CNT</name>
                <description>Number of event counters available for performance measurement</description>
                <bitRange>[15:11]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>PMCNTENSET</name>
            <description>Count-enable set register</description>
            <addressOffset>0x84</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0x8000000F</resetMask>
            <fields>
              <field>
                <name>EVENT_CNT_0</name>
                <description>Event-counter enable bit for PMU_EVCNTRn, where n=0.

0 (default) When read, it means that PMU_EVCNTRn is disabled. When written, it has no effect.
1 When read, it means that PMU_EVCNTRn event counter is enabled. When written, it enables PMU_EVCNTRn.</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>EVENT_CNT_1</name>
                <description>Event-counter enable bit for PMU_EVCNTRn, where n=1.

0 (default) When read, it means that PMU_EVCNTRn is disabled. When written, it has no effect.
1 When read, it means that PMU_EVCNTRn event counter is enabled. When written, it enables PMU_EVCNTRn.</description>
                <bitRange>[1:1]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>EVENT_CNT_2</name>
                <description>Event-counter enable bit for PMU_EVCNTRn, where n=2.

0 (default) When read, it means that PMU_EVCNTRn is disabled. When written, it has no effect.
1 When read, it means that PMU_EVCNTRn event counter is enabled. When written, it enables PMU_EVCNTRn.</description>
                <bitRange>[2:2]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>EVENT_CNT_3</name>
                <description>Event-counter enable bit for PMU_EVCNTRn, where n=3.

0 (default) When read, it means that PMU_EVCNTRn is disabled. When written, it has no effect.
1 When read, it means that PMU_EVCNTRn event counter is enabled. When written, it enables PMU_EVCNTRn.</description>
                <bitRange>[3:3]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>CYCLE_CNT</name>
                <description>PMCCNTR enable bit.

Enables the dedicated cycle counter, PMCCNTR.

0 (default) When read, it means the cycle counter is disabled. When written, it has no effect.
1 When read, it means the cycle counter is enabled. When written, it enables the cycle counter.</description>
                <bitRange>[31:31]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>PMCNTENCLR</name>
