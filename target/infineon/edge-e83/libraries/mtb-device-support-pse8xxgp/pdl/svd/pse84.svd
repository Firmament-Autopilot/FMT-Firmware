                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>MDATA</name>
                    <description>MDATA (non-control)/SETUP (control)</description>
                    <value>3</value>
                  </enumeratedValue>
                </enumeratedValues>
