                    <name>CTBL0_CMP0</name>
                    <description>CTBL0 COMP0 output</description>
                    <value>22</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CTBL0_CMP1</name>
                    <description>CTBL0 COMP1 output</description>
                    <value>23</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CTBL1_CMP0</name>
                    <description>CTBL1 COMP0 output</description>
                    <value>24</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CTBL1_CMP1</name>
                    <description>CTBL1 COMP1 output</description>
                    <value>25</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RSVD0</name>
                    <description>N/A</description>
                    <value>26</value>
