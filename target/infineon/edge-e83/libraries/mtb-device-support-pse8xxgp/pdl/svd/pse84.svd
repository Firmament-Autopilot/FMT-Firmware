          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>CTBL0_COMP0</name>
              <description>CTBL0 Comparator 0 Interrupt Request

CTBL0 COMP0 Interrupt: hardware sets this interrupt  if the condition is met (i.e. CTBL_STA_CFG.CFG.COMP0_OUT field). Write with '1' to clear bit.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CTBL0_COMP1</name>
              <description>CTBL0 Comparator 1 Interrupt Request

