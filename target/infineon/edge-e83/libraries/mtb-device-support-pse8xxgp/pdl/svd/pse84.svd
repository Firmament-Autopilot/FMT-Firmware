                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ISOC</name>
                    <description>Isochronous</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>EC</name>
                <description>N/A</description>
                <bitRange>[21:20]</bitRange>
                <access>read-write</access>
