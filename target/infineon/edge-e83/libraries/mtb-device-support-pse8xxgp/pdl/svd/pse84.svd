                    <description>Test_SE0_NAK mode</description>
                    <value>3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>PRTSPD</name>
                <description>N/A</description>
                <bitRange>[18:17]</bitRange>
                <access>read-only</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>FULLSPD</name>
                    <description>Full speed</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HIGHSPD</name>
                    <description>High speed</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LOWSPD</name>
                    <description>Low speed</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RSVDPrtSpdHPRT</name>
                    <description>N/A</description>
                    <value>3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>HCCHAR0</name>
            <description>This register contains the characteristics of the Host Channel.</description>
            <addressOffset>0x500</addressOffset>
