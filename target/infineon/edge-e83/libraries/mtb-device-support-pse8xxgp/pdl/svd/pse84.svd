                  </enumeratedValue>
                  <enumeratedValue>
                    <name>STC_2048</name>
                    <description>use sample time of 2048 clk_lppass cycles</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>STC_32</name>
                    <description>use sample time of 32 clk_lppass cycles</description>
                    <value>3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>R12</name>
                <description>N/A</description>
                <bitRange>[31:12]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
