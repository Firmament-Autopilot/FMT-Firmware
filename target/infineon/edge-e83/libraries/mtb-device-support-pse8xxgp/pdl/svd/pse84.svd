    <peripheral>
      <name>M0SECCPUSS_STATUS</name>
      <description>Cortex-M0+ Secured CPU subsystem</description>
      <baseAddress>0x42430100</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>256</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>VERSION</name>
