                  <bitRange>[9:0]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>VID_VSA_LINES_ACT_RSVD_31_10</name>
                  <description>N/A</description>
                  <bitRange>[31:10]</bitRange>
                  <access>read-only</access>
                </field>
