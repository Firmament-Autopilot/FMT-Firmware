          <register>
            <name>DIEPDMAB5</name>
            <description>This register contains the DMA Buffer Address of the IN Endpoint 5 of the Device controller.

Note: This register exists for an endpoint i if the OTG_EP_DIR_i parameter is 0 or 1 for that endpoint.</description>
            <addressOffset>0x9BC</addressOffset>
            <size>32</size>
            <access>read-only</access>
            <resetValue>0x0</resetValue>
            <resetMask>0x0</resetMask>
