            </field>
            <field>
              <name>LOCK_SPT</name>
              <description>Lock and the lock interrupt event are supported.</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>MEM_RET_RAM_REG</name>
              <description>N/A</description>
              <bitRange>[4:4]</bitRange>
              <access>read-only</access>
