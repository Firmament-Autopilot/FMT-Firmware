                      <description>(none)</description>
                      <value>9</value>
                    </enumeratedValue>
                  </enumeratedValues>
                </field>
                <field>
                  <name>DBI_CFG_RSVD_7_4</name>
                  <description>N/A</description>
                  <bitRange>[7:4]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>DBI_CFG_OUT_DBI_CONF</name>
                  <description>This field configures the DBI output pixel data as follows:</description>
                  <bitRange>[11:8]</bitRange>
                  <access>read-write</access>
                  <enumeratedValues>
                    <enumeratedValue>
                      <name>PIXELDATA0</name>
                      <description>(none)</description>
                      <value>0</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>PIXELDATA1</name>
                      <description>(none)</description>
                      <value>1</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>PIXELDATA10</name>
                      <description>(none)</description>
                      <value>10</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>PIXELDATA11</name>
                      <description>(none)</description>
                      <value>11</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>PIXELDATA12</name>
                      <description>(none)</description>
                      <value>12</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>PIXELDATA2</name>
                      <description>(none)</description>
                      <value>2</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>PIXELDATA3</name>
                      <description>(none)</description>
                      <value>3</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>PIXELDATA4</name>
                      <description>(none)</description>
                      <value>4</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>PIXELDATA5</name>
                      <description>(none)</description>
                      <value>5</value>
                    </enumeratedValue>
                    <enumeratedValue>
                      <name>PIXELDATA6</name>
                      <description>(none)</description>
