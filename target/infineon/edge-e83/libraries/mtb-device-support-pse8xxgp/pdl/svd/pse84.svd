        <register>
          <dim>8</dim>
          <dimIncrement>4</dimIncrement>
          <name>TR_OUT[%s]</name>
          <description>Trigger out select register</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>CTBL0_COMP0</name>
              <description>CTBL0 Comparator 0 Trigger

 It is generated by the CTBL0 Opamp0 Comparator if the condition is met (i.e. CTBL_STA_CFG.CFG.COMP0_OUT field).</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CTBL0_COMP1</name>
              <description>CTBL0 Comparator 1 Trigger

 It is generated by the CTBL0 Opamp1 Comparator if the condition is met (i.e. CTBL_STA_CFG.CFG.COMP1_OUT field).</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CTBL1_COMP0</name>
              <description>CTBL1 Comparator 0 Trigger

 It is generated by the CTBL1 Opamp0 Comparator if the condition is met (i.e. CTBL_STA_CFG.CFG.COMP0_OUT field).</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CTBL1_COMP1</name>
              <description>CTBL1 Comparator 1 Trigger

 It is generated by the CTBL1 Opamp1 Comparator if the condition is met (i.e. CTBL_STA_CFG.CFG.COMP1_OUT field).</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PTC_COMP0</name>
              <description>PTC Comparator 0 Trigger

It is set by the PTC Comparator 0 if the condition is met (i.e. PTC_STA_CFG.CFG.COMP0_OUT field).</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PTC_COMP1</name>
              <description>PTC Comparator 1 Interrupt Pending

It is set by the PTC Comparator 1 if the condition is met (i.e. PTC_STA_CFG.CFG.COMP1_OUT field).</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PTC_RANGE0</name>
              <description>PTC Post Processor 0 Range Trigger

It is generated by the PTC Post Processor if the RANGE0 condition is met (i.e. PTC_PP_STRUCT0.*).</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>PTC_RANGE1</name>
              <description>PTC Post Processor 1 Range Trigger

It is generated by the PTC Post Processor if the RANGE0 condition is met (i.e. PTC_PP_STRUCT1.*).</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>DAC0_RANGE0</name>
              <description>DAC0 Range 0 Trigger

It is generated by the DAC0 if the RANGE0 condition is met for a given channel with range 0 status enabled (i.e. DAC0_STA_CFG.CHAN_CFG.STATUS_SEL=STATUS_0).  The interrupt is disabled when DAC0 is configured for FW mode.</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>DAC0_RANGE1</name>
              <description>DAC0 Range 1 Trigger

It is generated by the DAC0 if the RANGE1 condition is met for a given channel with range 1 status enabled (i.e. DAC0_STA_CFG.CHAN_CFG.STATUS_SEL=STATUS_1).  The interrupt is disabled when DAC0 is configured for FW mode.</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>DAC0_RANGE2</name>
              <description>DAC0 Range 2 Trigger

It is generated by the DAC0 if the RANGE2 condition is met for a given channel with range 2 status enabled (i.e. DAC0_STA_CFG.CHAN_CFG.STATUS_SEL=STATUS_2).  The interrupt is disabled when DAC0 is configured for FW mode.</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>DAC0_EPOCH</name>
              <description>DAC0 End of Waveform Trigger

It is generated by DAC0 when finishing a waveform.  This condition is only used if the DAC0 channel (pointed to by the AC when triggered) is configured for LUT mode.</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>
            </field>
            <field>
