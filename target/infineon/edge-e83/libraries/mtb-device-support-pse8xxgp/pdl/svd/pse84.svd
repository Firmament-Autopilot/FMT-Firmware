                  <enumeratedValue>
                    <name>INACTIVE</name>
                    <description>No Babble Error</description>
                    <value>0</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>FRMOVRUN</name>
