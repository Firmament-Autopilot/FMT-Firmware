                  <bitRange>[20:20]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>ATTR_NS21</name>
                  <description>NS bit for block 21 based on BLK_IDX</description>
                  <bitRange>[21:21]</bitRange>
