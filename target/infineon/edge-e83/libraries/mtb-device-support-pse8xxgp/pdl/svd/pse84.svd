            <register>
              <name>VDD_ACTIVE</name>
              <description>Extern power supply detection register</description>
              <addressOffset>0x8010</addressOffset>
              <size>32</size>
              <access>read-only</access>
              <resetValue>0x80000000</resetValue>
              <resetMask>0xC000FFFF</resetMask>
              <fields>
                <field>
                  <name>VDDIO_ACTIVE</name>
                  <description>Indicates presence or absence of VDDIO supplies (i.e. other than VDDD, VDDA) on the device (supplies are numbered 0..n-1).  Note that VDDIO supplies have basic (crude) supply detectors only.  If separate, robust, brown-out detection is desired on IO supplies, on-chip or off-chip analog resources need to provide it.  For these bits to work reliable, the supply must be within valid spec range (per datasheet) or held at ground.  Any in-between voltage has an undefined result.
'0': Supply is not present
'1': Supply is present

When multiple VDDIO supplies are present, they will be assigned in alphanumeric ascending order to these bits during implementation.
For example 'vddusb, vddio_0, vddio_a, vbackup, vddio_r, vddio_1' are present then they will be assigned to these bits as below:
0: vbackup, 
1: vddio_0, 
2: vddio_1,
3: vddio_a,
4: vddio_r,
5: vddusb'</description>
                  <bitRange>[15:0]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>VDDA_ACTIVE</name>
                  <description>Same as VDDIO_ACTIVE for the analog supply VDDA.</description>
                  <bitRange>[30:30]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>VDDD_ACTIVE</name>
                  <description>This bit indicates presence of the VDDD supply.  This bit will always read-back 1.  The VDDD supply has robust brown-out protection monitoring and it is not possible to read back this register without a valid supply. (This bit is used in certain test-modes to observe the brown-out detector status.)</description>
                  <bitRange>[31:31]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>VDD_INTR</name>
              <description>Supply detection interrupt register</description>
              <addressOffset>0x8014</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x0</resetValue>
              <resetMask>0xC000FFFF</resetMask>
              <fields>
                <field>
                  <name>VDDIO_ACTIVE</name>
                  <description>Supply state change detected.
'0': No change to supply detected
'1': Change to supply detected</description>
                  <bitRange>[15:0]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>VDDA_ACTIVE</name>
                  <description>Same as VDDIO_ACTIVE for the analog supply VDDA.</description>
                  <bitRange>[30:30]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>VDDD_ACTIVE</name>
                  <description>The VDDD supply is always present during operation so a supply transition can not occur. This bit will always read back '1'.</description>
                  <bitRange>[31:31]</bitRange>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>VDD_INTR_MASK</name>
              <description>Supply detection interrupt mask register</description>
              <addressOffset>0x8018</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x0</resetValue>
              <resetMask>0xC000FFFF</resetMask>
              <fields>
                <field>
                  <name>VDDIO_ACTIVE</name>
                  <description>Masks supply interrupt on VDDIO.
'0': VDDIO interrupt forwarding disabled
'1': VDDIO interrupt forwarding enabled</description>
                  <bitRange>[15:0]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>VDDA_ACTIVE</name>
                  <description>Same as VDDIO_ACTIVE for the analog supply VDDA.</description>
                  <bitRange>[30:30]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>VDDD_ACTIVE</name>
                  <description>Same as VDDIO_ACTIVE for the digital supply VDDD.</description>
                  <bitRange>[31:31]</bitRange>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>VDD_INTR_MASKED</name>
              <description>Supply detection interrupt masked register</description>
              <addressOffset>0x801C</addressOffset>
              <size>32</size>
              <access>read-only</access>
              <resetValue>0x0</resetValue>
              <resetMask>0xC000FFFF</resetMask>
              <fields>
                <field>
                  <name>VDDIO_ACTIVE</name>
                  <description>Supply transition detected AND masked
'0': Interrupt was not forwarded to CPU
'1': Interrupt occurred and was forwarded to CPU</description>
                  <bitRange>[15:0]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>VDDA_ACTIVE</name>
                  <description>Same as VDDIO_ACTIVE for the analog supply VDDA.</description>
                  <bitRange>[30:30]</bitRange>
                  <access>read-only</access>
                </field>
                <field>
                  <name>VDDD_ACTIVE</name>
                  <description>Same as VDDIO_ACTIVE for the digital supply VDDD.</description>
                  <bitRange>[31:31]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>VDD_INTR_SET</name>
              <description>Supply detection interrupt set register</description>
              <addressOffset>0x8020</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x0</resetValue>
              <resetMask>0xC000FFFF</resetMask>
              <fields>
                <field>
                  <name>VDDIO_ACTIVE</name>
                  <description>Sets supply interrupt.
'0': Interrupt state not affected
'1': Interrupt set</description>
                  <bitRange>[15:0]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>VDDA_ACTIVE</name>
                  <description>Same as VDDIO_ACTIVE for the analog supply VDDA.</description>
                  <bitRange>[30:30]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>VDDD_ACTIVE</name>
                  <description>Same as VDDIO_ACTIVE for the digital supply VDDD.</description>
                  <bitRange>[31:31]</bitRange>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
            <register>
              <name>VDD_PWRSW_STATUS</name>
              <description>Power switch status</description>
              <addressOffset>0x8024</addressOffset>
              <size>32</size>
              <access>read-only</access>
              <resetValue>0x0</resetValue>
              <resetMask>0x1</resetMask>
              <fields>
                <field>
                  <name>PWROK</name>
                  <description>Power Switch status.</description>
                  <bitRange>[0:0]</bitRange>
                  <access>read-only</access>
                </field>
              </fields>
            </register>
            <register>
              <name>VDD_PWRSW_CTL</name>
              <description>Power Switch control</description>
              <addressOffset>0x8100</addressOffset>
              <size>32</size>
              <access>read-write</access>
              <resetValue>0x80000000</resetValue>
              <resetMask>0x80FF0333</resetMask>
              <fields>
                <field>
                  <name>ILIM</name>
                  <description>Inrush current limit level select.</description>
                  <bitRange>[1:0]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>THRES_SEL</name>
                  <description>Threshold select.</description>
                  <bitRange>[5:4]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>SW_ON</name>
                  <description>Switch enable signal.</description>
                  <bitRange>[8:8]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>PWROK_BYPASS</name>
                  <description>Switch is turn on and dc current limiting is disabled when PWROK_BYPASS and SW_ON are set to '1'</description>
                  <bitRange>[9:9]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>MODEHV_LOCK</name>
                  <description>This byte must be set to 0x3A for MODEHV to be taken affect by HW. When this byte is not equal to 0x3A, writes to MODEHV are ignored and HW ignores the value of MODEHV.
Do not change MODEHV in the same write cycle as setting/clearing the MODEHV_LOCK code; Do these in separate write cycles. Only write to this field when the VDDIO is at the correct voltage. Wrong setting of MODEHV can cause damage to the part.</description>
                  <bitRange>[23:16]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>MODEHV</name>
                  <description>Controls the bias circuit of 3.3V GPIOs
1 = 3.3V supply mode
0 = 1.8V supply mode
This bit can only be set/clear if MODEHV_LOCK==0x3A. SW/FW must make sure that VDDIO is at 1.8V before clearing the bit to 0. Failure to do so can cause damage to the part.</description>
                  <bitRange>[31:31]</bitRange>
                  <access>read-write</access>
                </field>
              </fields>
            </register>
          </cluster>
        </cluster>
      </registers>
    </peripheral>
    <peripheral derivedFrom="SMIF0">
      <name>SMIF1</name>
      <baseAddress>0x44480000</baseAddress>
    </peripheral>
    <peripheral>
      <name>U550</name>
      <description>Top level section for IP generation only, contains IP memory map</description>
      <headerStructName>U55</headerStructName>
      <baseAddress>0x44600000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>65536</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <cluster>
          <name>BASE_1_0</name>
          <description>Page BASE</description>
          <addressOffset>0x00000000</addressOffset>
          <register>
            <name>ID</name>
            <description>ID Register</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-only</access>
            <resetValue>0x10104201</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>VERSION_STATUS</name>
                <description>This is the version of the product 
(Implementation-defined)</description>
                <bitRange>[3:0]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>VERSION_MINOR</name>
                <description>This is the n for the P-part of an RnPn release number</description>
                <bitRange>[7:4]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>VERSION_MAJOR</name>
                <description>This is the n for the R-part of an RnPn release number</description>
                <bitRange>[11:8]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>PRODUCT_MAJOR</name>
                <description>This is the X-part of the ML00X product number
(Implementation-defined)</description>
                <bitRange>[15:12]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>ARCH_PATCH_REV</name>
                <description>This is the patch number of the architecture version a.b
(Implementation-defined)</description>
                <bitRange>[19:16]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>ARCH_MINOR_REV</name>
                <description>This is the minor architecture version number, b in the architecture version a.b
(Implementation-defined)</description>
                <bitRange>[27:20]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>ARCH_MAJOR_REV</name>
                <description>This is the major architecture version number, a in the architecture version a.b
(Implementation-defined)</description>
                <bitRange>[31:28]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>STATUS</name>
            <description>Register describes the current operating status of the NPU</description>
            <addressOffset>0x4</addressOffset>
            <size>32</size>
            <access>read-only</access>
            <resetValue>0x8</resetValue>
            <resetMask>0xFFFFF87F</resetMask>
            <fields>
              <field>
                <name>STATE</name>
                <description>NPU state; 0 = Stopped, 1 = Running</description>
                <bitRange>[0:0]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>IRQ_RAISED</name>
                <description>Raw IRQ status: 0 = IRQ not raised, 1 = IRQ raised. IRQ is
cleared using command register bit 1.</description>
                <bitRange>[1:1]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>BUS_STATUS</name>
                <description>0=OK, 1=Bus abort detected and processing halted (the
NPU has reached IDLE state and does not start to process
any more commands/AXI transactions). Can only be cleared
by a reset.</description>
                <bitRange>[2:2]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>RESET_STATUS</name>
                <description>Reset is ongoing and only this register can be read (other
registers read as 0 and writes are ignored). A value of 0
means the NPU is not being reset and can be accessed as
normal.</description>
                <bitRange>[3:3]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>CMD_PARSE_ERROR</name>
                <description>0=No error, 1=Command-stream parsing error detected. Can
only be cleared by a reset.</description>
                <bitRange>[4:4]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>CMD_END_REACHED</name>
                <description>0=Not reached, 1=Reached. Cleared by writing QBASE or
QSIZE when the NPU is in stopped state.</description>
                <bitRange>[5:5]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>PMU_IRQ_RAISED</name>
                <description>0=No PMU IRQ, 1=PMU IRQ raised. Cleared by using
command register bit 1</description>
                <bitRange>[6:6]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>FAULTING_INTERFACE</name>
                <description>Faulting interface on bus abort. 0=AXI-M0, 1=AXI-M1</description>
                <bitRange>[11:11]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>FAULTING_CHANNEL</name>
                <description>Faulting channel on a bus abort. Read: 0=Cmd, 1=IFM,
2=Weights, 3=Scale+Bias, 4=Mem2Mem; Write: 8=OFM,
9=Mem2Mem</description>
                <bitRange>[15:12]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>IRQ_HISTORY_MASK</name>
                <description>IRQ History mask
This is used for debug purposes. Each IRQ or Event operation provides a 16-bit mask which is logically ORed into these bits. The bits can be cleared using the command register.</description>
                <bitRange>[31:16]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>CMD</name>
            <description>Command register, reads as last written command</description>
            <addressOffset>0x8</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0xC</resetValue>
            <resetMask>0xFFFF000F</resetMask>
            <fields>
              <field>
                <name>TRANSITION_TO_RUNNING_STATE</name>
                <description>Write 1 to transition the NPU to running state. Writing 0 has no effect.</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>CLEAR_IRQ</name>
                <description>Write 1 to clear the IRQ status in the STATUS register. Writing 0 has no effect.</description>
                <bitRange>[1:1]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>CLOCK_Q_ENABLE</name>
                <description>Write 1 to this bit to enable clock off using the Clock Q-interface and enable the main clock gate.</description>
                <bitRange>[2:2]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>POWER_Q_ENABLE</name>
                <description>Write 1 to this bit to enable power off using the Power Q-interface.</description>
                <bitRange>[3:3]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>CLEAR_IRQ_HISTORY</name>
                <description>Clears the IRQ history mask.
When bit k is set, then the corresponding bit k of the STATUS register (IRQ history) is cleared.</description>
                <bitRange>[31:16]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>RESET</name>
            <description>Request Reset and new security mode</description>
            <addressOffset>0xC</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0x3</resetMask>
            <fields>
              <field>
                <name>PENDING_CPL</name>
                <description>Current privilege level: 0=User (default), 1=Privileged</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>PENDING_CSL</name>
                <description>Current security level: 0=Secure (default), 1=Non secure</description>
                <bitRange>[1:1]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>QBASE0</name>
            <description>Base address of Command-queue bits [31 downto 0]. The address is 4-byte-aligned</description>
            <addressOffset>0x10</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>QBASE0</name>
                <description>The 4-byte-aligned lower bytes of the base address value for the command stream.</description>
                <bitRange>[31:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>QBASE1</name>
            <description>Address extension bits [47 downto 32] for queue base</description>
            <addressOffset>0x14</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>QBASE1</name>
                <description>The 4-byte-aligned upper bytes of the base address value for the command stream</description>
                <bitRange>[31:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>QREAD</name>
            <description>Read offset in the command stream in bytes. Multiples of 4 in the range 0-16 MB</description>
            <addressOffset>0x18</addressOffset>
            <size>32</size>
            <access>read-only</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>QREAD</name>
                <description>The read offset of the current command under execution</description>
                <bitRange>[31:0]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>QCONFIG</name>
            <description>AXI configuration for the command stream in the range 0-3. Same encoding as for REGIONCFG</description>
            <addressOffset>0x1C</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>QCONFIG</name>
                <description>AXI configuration for the command stream in the range 0-3</description>
                <bitRange>[31:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>QSIZE</name>
            <description>Size of the command stream in bytes. Multiples of 4 in the range 0-16 MB</description>
            <addressOffset>0x20</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>QSIZE</name>
                <description>Size of the next command stream to be executed by the NPU</description>
                <bitRange>[31:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>PROT</name>
            <description>Protection level configured for the NPU when acting as an AXI master</description>
            <addressOffset>0x24</addressOffset>
            <size>32</size>
            <access>read-only</access>
            <resetValue>0x2</resetValue>
            <resetMask>0x3</resetMask>
            <fields>
              <field>
                <name>ACTIVE_CPL</name>
                <description>Current privilege level.
0 = User
1 = Privilege

This is used as AxPROT[0] when the NPU is a master.
- After hard reset, this is set to Power-on-reset privilege level (PORPL).
- After soft reset, this is set to pending_CPL, if PPROT[0]==1, otherwise it is set to 0. For this to be effective, there must be a system-level MPU built for the system.

Depends on ROT_INIT.PRIVILEGE_LEVEL</description>
                <bitRange>[0:0]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>ACTIVE_CSL</name>
                <description>Current security level.
0 = Secure
1 = Non-secure

This is used as AxPROT[1] when the NPU is a master and set from Pending CSL after the reset is complete.
- After a hard reset, this is set to Power-on-reset security level (PORSL), which allows for CPUs that do not support TrustZone.
- After a soft reset, this is set to pending_CSL, if PPROT[1]==0, otherwise it is set to 1. For this to be effective, there must be a memory-protection controller included in the system.

Depends on ROT_INIT.SECURITY_LEVEL</description>
                <bitRange>[1:1]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>CONFIG</name>
            <description>RTL configuration</description>
            <addressOffset>0x28</addressOffset>
            <size>32</size>
            <access>read-only</access>
            <resetValue>0x1807</resetValue>
            <resetMask>0xF000FFFF</resetMask>
            <fields>
              <field>
                <name>MACS_PER_CC</name>
                <description>The log2(macs/clock cycle). Valid encoding range is 5-8 for 32-256 MACs/clock cycle.
5 = 2^5 MACS/cycle
6 = 2^6 MACS/cycle
7 = 2^7 MACS/cycle
8 = 2^8 MACS/cycle</description>
                <bitRange>[3:0]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>CMD_STREAM_VERSION</name>
                <description>Command stream version accepted by this NPU</description>
                <bitRange>[7:4]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>SHRAM_SIZE</name>
                <description>Size in KB of SHRAM in the range 8-48.
0x10 = 16KB
0x18 = 24KB
0x30 = 48KB</description>
                <bitRange>[15:8]</bitRange>
                <access>read-only</access>
              </field>
              <field>
                <name>PRODUCT</name>
                <description>Product configuration
(implementation defined)</description>
                <bitRange>[31:28]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <name>LOCK</name>
            <description>Lock register. This register is designed for driver use and does not affect NPU functionality</description>
            <addressOffset>0x2C</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <field>
                <name>LOCK</name>
                <description>This register is designed for driver use and does not affect NPU functionality.</description>
                <bitRange>[31:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>REGIONCFG</name>
            <description>Base pointer configuration. Bits[2*k+1 downto 2*k] give the memory type for REGION[k]</description>
            <addressOffset>0x3C</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFF</resetMask>
            <fields>
              <field>
                <name>REGION0</name>
                <description>same description as REGION7 field.</description>
                <bitRange>[1:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>REGION1</name>
                <description>same description as REGION7 field.</description>
                <bitRange>[3:2]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>REGION2</name>
                <description>same description as REGION7 field.</description>
                <bitRange>[5:4]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>REGION3</name>
                <description>same description as REGION7 field.</description>
                <bitRange>[7:6]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>REGION4</name>
                <description>same description as REGION7 field.</description>
                <bitRange>[9:8]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>REGION5</name>
                <description>same description as REGION7 field.</description>
                <bitRange>[11:10]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>REGION6</name>
                <description>same description as REGION7 field.</description>
                <bitRange>[13:12]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>REGION7</name>
                <description>0 = AXI0 port, outstanding counter 0; AXI limits are set by the AXI_LIMIT0 register.
1 = AXI0 port, outstanding counter 1; AXI limits are set by the AXI_LIMIT1 register.
2 = AXI1 port, outstanding counter 2; AXI limits are set by the AXI_LIMIT2 register.
3 = AXI1 port, outstanding counter 3; AXI limits are set by the AXI_LIMIT3 register.</description>
                <bitRange>[15:14]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>AXI_LIMIT0</name>
            <description>AXI limits for port 0 counter 0</description>
            <addressOffset>0x40</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFF00F3</resetMask>
            <fields>
              <field>
                <name>MAX_BEATS</name>
                <description>N/A</description>
                <bitRange>[1:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>MEMTYPE</name>
                <description>Memtype.</description>
                <bitRange>[7:4]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>MAX_OUTSTANDING_READ_M1</name>
                <description>Maximum number of outstanding AXI read transactions, in range 0-15</description>
                <bitRange>[23:16]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>MAX_OUTSTANDING_WRITE_M1</name>
                <description>Maximum number of outstanding AXI write transactions, in range 0-15</description>
                <bitRange>[31:24]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>AXI_LIMIT1</name>
            <description>AXI limits for port 0 counter 1</description>
            <addressOffset>0x44</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFF00F3</resetMask>
            <fields>
              <field>
                <name>MAX_BEATS</name>
                <description>N/A</description>
                <bitRange>[1:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>MEMTYPE</name>
                <description>Memtype.</description>
                <bitRange>[7:4]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>MAX_OUTSTANDING_READ_M1</name>
                <description>Maximum number of outstanding AXI read transactions, in range 0-15</description>
                <bitRange>[23:16]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>MAX_OUTSTANDING_WRITE_M1</name>
                <description>Maximum number of outstanding AXI write transactions, in range 0-15</description>
                <bitRange>[31:24]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>AXI_LIMIT2</name>
            <description>AXI limits for port 1 counter 2</description>
            <addressOffset>0x48</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFF00F3</resetMask>
            <fields>
              <field>
                <name>MAX_BEATS</name>
                <description>N/A</description>
                <bitRange>[1:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>MEMTYPE</name>
                <description>Memtype.</description>
                <bitRange>[7:4]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>MAX_OUTSTANDING_READ_M1</name>
