                  <access>read-only</access>
                </field>
                <field>
                  <name>VID_SHADOW_CTRL_VID_SHADOW_REQ</name>
                  <description>When set to 1, this bit request that the dpi registers from regbank are copied to the auxiliary registers. When the request is completed this bit is auto clear.</description>
                  <bitRange>[8:8]</bitRange>
                  <access>read-write</access>
                </field>
                <field>
                  <name>VID_SHADOW_CTRL_RSVD_15_9</name>
