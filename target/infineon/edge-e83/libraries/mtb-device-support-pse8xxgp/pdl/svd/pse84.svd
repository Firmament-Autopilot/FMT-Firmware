                    <value>45</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>FIFO_LEVEL0</name>
                    <description>FIFO Level 0 trigger

This status is set whenever FIFO0 level condition has been met (FIFO_LEVEL0.LEVEL).  This status is transparent from the FIFO (i.e. the status is not sticky).</description>
                    <value>46</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>FIFO_LEVEL1</name>
                    <description>FIFO Level 1 trigger</description>
                    <value>47</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>FIFO_LEVEL2</name>
                    <description>FIFO Level 2 trigger</description>
                    <value>48</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>FIFO_LEVEL3</name>
                    <description>FIFO Level 3 trigger</description>
                    <value>49</value>
