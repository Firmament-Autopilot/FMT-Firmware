                <access>read-only</access>
              </field>
              <field>
                <name>OUT1</name>
                <description>Current output value of the comparator 1.</description>
                <bitRange>[16:16]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
          <register>
            <dim>2</dim>
