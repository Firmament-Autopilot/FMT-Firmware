it.</description>
                <bitRange>[9:9]</bitRange>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>ACTIVE</name>
                    <description>Frame Overrun</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>INACTIVE</name>
                    <description>No Frame Overrun</description>
                    <value>0</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>DATATGLERR</name>
                <description>Data Toggle Error (DataTglErr).This bit can be set only by the core and the application should write 1 to clear
it.In Scatter/Gather DMA mode, the interrupt due to this bit is masked 
