                  <enumeratedValue>
                    <name>SEL_VCM_CH1</name>
                    <description>Select common mode voltage of channel 1 when ADFTMUX.EN=1</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>SEL_VCM_CH2</name>
                    <description>Select common mode voltage of channel 2 when ADFTMUX.EN=1</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>SEL_VCM_CH3</name>
                    <description>Select common mode voltage of channel 3 when ADFTMUX.EN=1</description>
                    <value>3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>SEL_VCM_CH4</name>
                    <description>Select common mode voltage of channel 4 when ADFTMUX.EN=1</description>
                    <value>4</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>SEL_VCM_CH5</name>
                    <description>Select common mode voltage of channel 5 when ADFTMUX.EN=1</description>
                    <value>5</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>SEL_VCM_CH6</name>
                    <description>Select common mode voltage of channel 6 when ADFTMUX.EN=1</description>
                    <value>6</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>SEL_VCM_CH7</name>
                    <description>Select common mode voltage of channel 7 when ADFTMUX.EN=1</description>
                    <value>7</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>SEL_VCM_CH8</name>
                    <description>Select common mode voltage of channel 8 when ADFTMUX.EN=1</description>
                    <value>8</value>
                  </enumeratedValue>
                  <enumeratedValue>
