            <addressOffset>0x90</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0x8000000F</resetMask>
            <fields>
              <field>
                <name>EVENT_CNT_0_OVF</name>
