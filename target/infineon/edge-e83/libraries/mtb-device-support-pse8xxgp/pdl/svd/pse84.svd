                <bitRange>[23:16]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>MAX_OUTSTANDING_WRITE_M1</name>
                <description>Maximum number of outstanding AXI write transactions, in range 0-15</description>
                <bitRange>[31:24]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>AXI_LIMIT3</name>
            <description>AXI limits for port 1 counter 3</description>
            <addressOffset>0x4C</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFF00F3</resetMask>
            <fields>
              <field>
                <name>MAX_BEATS</name>
                <description>N/A</description>
                <bitRange>[1:0]</bitRange>
                <access>read-write</access>
              </field>
              <field>
                <name>MEMTYPE</name>
                <description>Memtype.</description>
