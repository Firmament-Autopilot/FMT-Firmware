        {
            "name": "EDGE-E83 M33 Debug (DAPLink)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}/target/infineon/edge-e83",
            "executable": "${workspaceFolder}/target/infineon/edge-e83/m33/rt-thread.elf",
            "servertype": "openocd",
            "serverpath": "${workspaceFolder}/target/infineon/edge-e83/tools/OpenOCD-Infineon/bin/openocd.exe",
            "searchDir": [
              "${workspaceFolder}/target/infineon/edge-e83/tools/OpenOCD-Infineon/openocd/scripts",
              "${workspaceFolder}/target/infineon/edge-e83/libs/TARGET_APP_KIT_PSE84_EVAL_EPC2/config/GeneratedSource",
              "${workspaceFolder}/target/infineon/edge-e83/tools",
              "${workspaceFolder}/target/infineon/edge-e83/m33/build"
            ],
            "configFiles": [
              "interface/cmsis-dap.cfg",
              "target/infineon/pse84xgxs2.cfg"
            ],
            "openOCDPreConfigLaunchCommands": [
              "set QSPI_FLASHLOADER [find PSE84_SMIF.FLM]"
            ],
            "openOCDLaunchCommands": [
              "cat1d.cm33 configure -rtos auto -rtos-wipe-on-reset-halt 1",
              "gdb_breakpoint_override hard"
            ],
            "overrideLaunchCommands": [
              "set mem inaccessible-by-default off",
              "-enable-pretty-printing",
              "set remotetimeout 500",
              "monitor reset init",
              "monitor program [find rtthread.hex]",
              "monitor reset_halt cm33_ns"
            ],
            "overrideRestartCommands": [
              "monitor reset_halt cm33_ns"
            ],
            "armToolchainPath": "${env:RTT_EXEC_PATH}",
            "svdFile": "target/infineon/edge-e83/libraries/mtb-device-support-pse8xxgp/pdl/svd/pse84.svd",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "none"
          },
